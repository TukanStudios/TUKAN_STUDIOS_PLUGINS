    report_gr_L = report_gr_R = ratio2db(tengrv);
   
    
    //tenospl0 = HP0.buthp_do(spl0+p1_pink*L_in_Gain);;
    //tenospl1 = HP1.buthp_do(spl1+p2_pink*R_in_Gain);;
