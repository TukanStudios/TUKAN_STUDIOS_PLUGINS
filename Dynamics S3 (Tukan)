  Function Blue_Compressor_Parameters(_Threshold, _Knee, _Ratio, _attack, _release, _gain, _SC)
  instance (SC x Tlo Thi slope Threshold delta knee_factor Knee Knee_width ratio attack release eps yR yA aplhaA aplhaER gain outL outR) (
  SC = _sc;
  Threshold = _Threshold;
  Knee = _Knee; 
  knee_width = abs(Threshold*2*Knee*0.01);
  ratio = _Ratio;
  slope = ((1 - ratio) / ratio);
  
  attack = _attack/1000;
  release = _release/1000;
  aplhaA = attack>0 ? exp(-1 / (attack * srate)) : 0;
  aplhaER = release>0 ? exp(-1 / (release * srate)) : 0;
  
  Tlo = (Threshold - knee_width / 2);
  Thi = (Threshold + knee_width / 2);
  knee_factor = (slope / (knee_width * 2));
  
  Gain = db2ratio(_gain);
  );
  
  
  Function Blue_Compressor_do (KeyL, KeyR)  instance (SC x x1 x2 x3 Tlo Thi slope Threshold delta knee_factor eps yR yA aplhaA aplhaER gr gr_db outL outR gain) (
  eps = 0.0000000001;
  
  SC ? (
  this.XX = max(-140,ratio2db(max(abs(spl2),abs(spl3))));
  x = this.XX;
  ):(
  this.XX = ratio2db(max(abs(keyL),abs(KeyR))+eps);
  x = ratio2db(max(abs(keyL),abs(KeyR)));
  );
    //this.XX === 0 ? (this.XX = db2ratio(-120));
    
  (this.XX < Tlo) ? x = 0 :
  (this.XX > Thi) ? x = slope * (this.XX - Threshold) :
  (delta = this.XX - Tlo; x = delta * delta * knee_factor;);
  
  
  yR = min(x, aplhaER * yR + (1 - aplhaER) * x + eps - eps);
  yA = aplhaA * yA + (1 - aplhaA) * yR + eps - eps;
  
  gr_dB = yA;
  Gr = db2ratio(yA);
  
  outL = KeyL * gr*gain;
  outR = KeyR*gr*gain;
  );
  
  
  Function Blue_Compressor_do_gfx (x)  instance (SC x1 x2 x3 Tlo Thi slope Threshold delta knee_factor eps yR yA aplhaA aplhaER gr gr_db outL outR gain) (
  
  (x < Tlo) ? x = 0 :
  (x > Thi) ? x = slope * (x - Threshold) :
  (delta = x - Tlo;
  x = delta * delta * knee_factor;);
  
  
  );
  









  
  
  
  
  
  
  
      
    









