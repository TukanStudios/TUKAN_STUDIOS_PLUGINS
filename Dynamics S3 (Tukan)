    //tenospl0 = InL+p1_pink*L_in_Gain;
    //tenospl1 = InR+p2_pink*L_in_Gain;
    
    InL *= L_out_Gain;
    InR *= L_out_Gain;
    
  
    
  //************************************ TRANSISTOR 2 *****************
  transistor2 == 1 ? (
  Rp=-4.6*0.1;
  Vk=(-0.96-1)+4;
  Vs=2.48;
  
  level=1;
  PreGain=10^(-1/20);
  PostGain=10^((-1.6-3)/20);
  
  in0 = vari_tanh(InL*PreGain);
  in1 = vari_tanh(InR*PreGain);
  
  Gk = in0*Vk - Vk;
  Vgk = 0.0357167 + 0.978574*Gk - 0.0857147*Gk*Gk - 0.0285716*Gk*Gk*Gk;
  Ip = -0.0182*Vgk*Vgk*Vgk - 0.0233*Vgk*Vgk + 0.6117*Vgk + 1.6718;
  Vp = Vs - Ip*Rp;
  out0 = in0*Vp;
  
  Gk = in1*Vk - Vk;
  Vgk = 0.0357167 + 0.978574*Gk - 0.0857147*Gk*Gk - 0.0285716*Gk*Gk*Gk;
  Ip = -0.0182*Vgk*Vgk*Vgk - 0.0233*Vgk*Vgk + 0.6117*Vgk + 1.6718;
  Vp = Vs - Ip*Rp;
  out1 = in1*Vp;
  
  InL = (in0 + vari_tanh(out0)*level) * PostGain * 0.5;
  InR = (in1 + vari_tanh(out1)*level) * PostGain * 0.5;
  This.TubeOut.feed_Meter(max(abs(InL),abs(InR)));
  );
  //************************************ ENDE TRANSISTOR 2 *****************
  
  
  outL = InL; OutR = InR;
