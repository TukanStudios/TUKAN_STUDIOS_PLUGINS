  function Gate_parameters_update (thr_ hyst_ at_ hold_ rel_ Exp_on_ exp_fac_) 
  instance (gate_hold gate_attack_samples gate_release_samples gate_threshold gate_hysteresis gate_gateHyst gate_gateThresh
  exp_attack exp_release exp_exp_envelope_decay expander_factor transfer_a transfer_b expander_on
  )
  (
      gate_hold = hold_ *0.001*srate;
      gate_attack_samples = at_ * 0.001*srate;
      gate_release_samples = rel_ * 0.001*srate;
      gate_threshold = db2ratio(thr_);
      gate_gateThresh = thr_;
      gate_hysteresis = db2ratio(hyst_);
      gate_gateHyst = hyst_;
      
      
      exp_attack = exp(-1/(0.1/1000*srate));
      exp_release = exp(-1/(10/1000*srate));
      exp_exp_envelope_decay = exp(-1/(10/1000*srate));
      
      expander_factor = exp_fac_;
      transfer_A = (exp_fac_)-1;
      transfer_B = pow(gate_threshold,-transfer_A);
      expander_on = Exp_on_;
  );
          
  
  
  function gate_do(InL, InR, SC_L, SC_R) 
  instance (gate_hold gate_attack_samples gate_release_samples gate_threshold gate_hysteresis gate_gateHyst gate_gateThresh
  key keyR gate_threshold gate_phase gfx_gate_phase holding gate_gain result_gain gate_gain lookahead_count
  exp_attack exp_release exp_exp_envelope_decay expander_factor transfer_a transfer_b expander_on exp_det exp_gain exp_env
  )
  (
  
  
      key = keyR = max(abs(SC_L),abs(SC_R));
      key += 0.0000001;
  
  /*    
      Key >= gate_threshold ? (gate_phase = 1; gfx_gate_phase = gate_phase;);
      gate_phase == 1 ? (
      holding = 0;
      gate_gain = min(gate_gain + 1/gate_attack_samples, 1);
      gate_gain >= 1 ? gate_phase = 2;
      gfx_gate_phase = gate_phase;
      );
      
      gate_phase == 2 ? (
        holding = 0;
        key < db2ratio(gate_gateThresh+gate_gateHyst) ? (
          gate_phase = 3;
          gfx_gate_phase = gate_phase;
        );
      );
      
      gate_phase == 3 ? (
      key >= db2ratio(gate_gateThresh+gate_gateHyst) ? (
        gate_phase = 2; gfx_gate_phase = gate_phase;
      );
      holding += 1;
      holding >= gate_hold ? (gate_phase = 4;gfx_gate_phase = gate_phase;);
      );
      
      
      gate_phase == 4 ? (
      holding = 0;
      gate_gain = max(gate_gain * db2ratio(-(60/gate_release_samples)), 0);
      gate_gain <= db2ratio(-60) ? gfx_gate_phase = 0;
      gate_gain <= db2ratio(-240) ? gate_phase = 0;
      );
      
      result_gain = gate_gain;
      spl0 = spl0 * result_gain; //gateL.tickGate(keyL);
      spl1 = spl1 * result_gain; //gateR.tickGate(keyR);
  */

  
  
  
  
    lookahead_count += 1;
    lookahead_count > five_ms ? lookahead_count = 0;
    
    lookahead_L[lookahead_count] =spl0;
    lookahead_R[lookahead_count] =spl1;
    
  

  /*
      
      Key >= threshold ? (gate_phase = 1; gfx_gate_phase = gate_phase;);
      gate_phase == 1 ? (
      holding = 0;
      gate_gain = min(gate_gain + 1/attack_samples, 1);
      gate_gain >= 1 ? gate_phase = 2;
      gfx_gate_phase = gate_phase;
      );
      
      gate_phase == 2 ? (
        holding = 0;
        key < db2ratio(gateThresh+gateHyst) ? (
          gate_phase = 3;
          gfx_gate_phase = gate_phase;
        );
      );
      
      gate_phase == 3 ? (
      key >= db2ratio(gateThresh+gateHyst) ? (
        gate_phase = 2; gfx_gate_phase = gate_phase;
      );
      holding += 1;
      holding >= hold ? (gate_phase = 4;gfx_gate_phase = gate_phase;);
      );
      
      
      gate_phase == 4 ? (
      holding = 0;
      gate_gain = max(gate_gain * db2ratio(-(60/release_samples)), 0);
      gate_gain <= db2ratio(-60) ? gfx_gate_phase = 0;
      gate_gain <= db2ratio(-240) ? gate_phase = 0;
      );
      
  */
  
  Key >= gate_threshold ? (gate_phase = 1; gfx_gate_phase = gate_phase;);
  gate_phase == 1 ? (
  holding = 0;
  gate_gain = min(gate_gain + 1/gate_attack_samples, 1);
  gate_gain >= 1 ? gate_phase = 2;
  gfx_gate_phase = gate_phase;
  );
  
  gate_phase == 2 ? (
    holding = 0;
    key < db2ratio(gate_gateThresh+gate_gateHyst) ? (
      gate_phase = 3;
      gfx_gate_phase = gate_phase;
    );
  );
  
  gate_phase == 3 ? (
  key >= db2ratio(gate_gateThresh+gate_gateHyst) ? (
    gate_phase = 2; gfx_gate_phase = gate_phase;
  );
  holding += 1;
  holding >= gate_hold ? (gate_phase = 4;gfx_gate_phase = gate_phase;);
  );
  
  
  gate_phase == 4 ? (
  holding = 0;
  gate_gain = max(gate_gain * db2ratio(-(60/gate_release_samples)), 0);
  gate_gain <= db2ratio(-60) ? gfx_gate_phase = 0;
  gate_gain <= db2ratio(-240) ? gate_phase = 0;
  );


      exp_det = key;
      exp_det += 0.000000000001;
      exp_env = exp_det >= exp_env ? exp_det : exp_det+exp_exp_envelope_decay*(exp_env-exp_det);
      transfer_exp_gain = exp_env < gate_threshold ? pow(exp_env,transfer_A)*transfer_B:1;
      exp_gain = transfer_exp_gain > exp_gain ? transfer_exp_gain+exp_attack*(exp_gain-transfer_exp_gain) : transfer_exp_gain+exp_release*(exp_gain-transfer_exp_gain);
      
      exp_gain = max(exp_gain,0);
      expander_on == 0 ? exp_gain = 0;
      expander_buf[lookahead_count] = exp_gain;
      
      
      
      
      lookahead_out = lookahead_count + 1;
      lookahead_out > five_ms ? lookahead_out = 0;
      
      
      
      
      gate_lookahead > 0 ? (
      result_gain = max(gate_gain, expander_buf[lookahead_out]);
      Invert ? (
      spl0 = (lookahead_L[lookahead_out] - (lookahead_L[lookahead_out]* result_gain)) *output; //gateL.tickGate(keyL);
      spl1 = (lookahead_R[lookahead_out] - (lookahead_R[lookahead_out]* result_gain)) *output; //gateR.tickGate(keyR);    
      ):(
      spl0 = lookahead_L[lookahead_out]* result_gain; //gateL.tickGate(keyL);
      spl1 = lookahead_R[lookahead_out]* result_gain; //gateR.tickGate(keyR);
      );
      ):(
      result_gain = max(gate_gain, exp_gain);
      invert ? (
      spl0 = (spl0 - (spl0 * result_gain))*output; //gateL.tickGate(keyL);
      spl1 = (spl1 - (spl1 * result_gain))*output; //gateR.tickGate(keyR);    
      ):(
      spl0 = spl0 * result_gain; //gateL.tickGate(keyL);
      spl1 = spl1 * result_gain; //gateR.tickGate(keyR);
      );
      );
  );
  
  
  
  
  
  
  
  
  
  
