    //);
    
    tengrv = db2ratio(tengr);//exp(tengr * db2log);
    
    tenrunmax = tenmaxover + tenrelcoef * (tenrunmax - tenmaxover);  // highest peak for setting att/rel decays in tenreltime
    tenmaxover = tenrunmax;
    thi3 = 1;//exp(-corfak*db2log);
    InL *= tengrv;
