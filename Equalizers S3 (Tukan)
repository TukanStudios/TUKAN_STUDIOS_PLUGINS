  /*
   * Update the state of any changes
   */
  function update_state() instance (ceiling noisefloor tilt windowtype type_value blocks block_value windowsize display_mode) local (blocks fill_r fill_b fill_g fill_a line_a line_r line_g line_b) (
    spectrum.custom_colors = 1;
    ceiling = 0;//Ceiling_Value == 0 ? 0 : Ceiling_Value == 1 ? 20 : Ceiling_Value == 2 ? 40;
    noise_floor = -120;//Floor_Value == 0 ? -90 : Floor_Value == 1 ? -140 : Floor_Value == 2 ? -200;
    tilt = 4.5;//Tilt_Value == 0 ? 0 : Tilt_Value == 1 ? 1.5 : Tilt_Value == 2 ? 3 : Tilt_Value == 3 ? 4.5 : Tilt_Value == 4 ? 6;
    
    windowtype = 2;
    windowtype != Type_Value+1 ? spectrum.set_type(Type_Value+1);
  
    block_value = 2;
    windowsize = 8192;
    blocks = (2 ^ (Block_Value+1)) * 1024;
    windowsize != blocks ? spectrum.set_block_size(blocks);
  
    display_mode = 0;
    Display_Mode == 0 ? (
      fill_r = 0 / 255;
      fill_g = 100 / 255;
      fill_b = 150 / 255;
      fill_a = 0.5;
      spectrum.set_fill(0, 1);
      spectrum.set_color(0, fill_r, fill_g, fill_b, fill_a);
      fill_r = 0 / 255;
      fill_g = 130 / 255;
      fill_b = 170 / 255;
      fill_a = 0.3;
      spectrum.set_fill(1, 1); 
      spectrum.set_color(1, fill_r, fill_g, fill_b, fill_a);
    ) : Display_Mode == 1 ? (
      line_a=1.0;
      line_r = 114 / 255; line_g = 215 / 255; line_b = 1 / 255;;
      spectrum.set_fill(0, 0);
      spectrum.set_color(0, line_r, line_g, line_b, line_a);
      line_r = 253 / 255; line_g = 185 / 255; line_b = 210 / 255;;
      spectrum.set_fill(1, 0);
      spectrum.set_color(1, line_r, line_g, line_b, line_a);
    );
  );
  
  /*
   * Set the filter
   */
  function band_set_filter(t, f, g, qval, slope)
    instance (enabled, type, frequency, gain, q, filter, color) (
    type = t; frequency = f; gain = g; q = qval;
    type == 0 ? filter.svf_eq(frequency, q, db_to_gain(gain)) :
      type == 1 ? filter.svf_hp(frequency, q, slope) :
        type == 2 ? filter.svf_hpb(frequency, slope) :
          type == 3 ? filter.svf_ls(frequency, q, db_to_gain(gain)) :
            type == 4 ? filter.svf_hs(frequency, q, db_to_gain(gain)) :
              type == 5 ? filter.svf_lp(frequency, q, slope) :
                type == 6 ? filter.svf_lpb(frequency, slope) :
                  type == 7 ? filter.svf_bs(frequency, q) :
                    type == 8 ? filter.svf_bp2(frequency, q) :
                      type == 9 ? filter.svf_st(frequency, q, gain) :
                        type == 10 ? filter.svf_pultecls(frequency, q, gain) :
                          type == 11 ? filter.svf_ap(frequency, q) :
                            type == 12 ? filter.svf_analog_lowcut(frequency, q, gain) :
                              type == 13 ? filter.svf_analog_highcut(frequency, q, gain);
  );
  
  function band_init()
    instance (enabled, type, frequency, gain, q, filter, color) ( 
    filter.svf_set_sample_rate(SAMPLE_RATE);
    filter.svf_bypass();
    //color.create_color(0,0,0);
  
    filter.a1 = filter.t_a1;
    filter.a2 = filter.t_a2;
    filter.a3 = filter.t_a3;
  
    filter.m0 = filter.t_m0;
    filter.m1 = filter.t_m1;
    filter.m2 = filter.t_m2;
    filter.iter_t = 1.0;
  );
  /*
   * Convert slider % to frequency
   */
  function per_to_freq(x, range) (
    MIN_FREQ * exp(FREQ_LOG_MAX * x / range);
  );
  /*
   * Convert frequency to slider %
   */
  function freq_to_per(freq, range) (
    range * log(freq / MIN_FREQ) / FREQ_LOG_MAX;
  );
  
  
  function per_to_q(x, range) (
    MIN_Q * exp(Q_LOG_MAX * x / range);
  );
  
  /*
   * Convert frequency to slider %
   */
  function q_to_per(q, range) (
    range * log(q / MIN_Q) / Q_LOG_MAX;
  );
  
  /*
   * Set oversampling rate including PDC
   */
  function fir0_set_oversample(os) (
    // We'll only switch to oversampling if the sample rate
    // is low enough to benefit.
    srate < 88200 && os ? (
      DO_OVERSAMPLE = 1;
      SAMPLE_RATE = srate * 2;
      ONE_OVER_SAMPLE_RATE = 1.0 / SAMPLE_RATE;
  
      // Choose right FIR window for sample rate
      srate == 44100 ? (
        firL0.init_FIR_filter_44100();
        firR0.init_FIR_filter_44100();
      ) : srate == 48000 ? ( 
        firL0.init_FIR_filter_48000();
        firR0.init_FIR_filter_48000();
      );
  
      fir0_pdc_delay = get_FIR_pdc();
  
    ) : ( 
      DO_OVERSAMPLE = 0;
      SAMPLE_RATE = srate;
      ONE_OVER_SAMPLE_RATE = 1.0 / srate;
      fir0_pdc_delay = 0;
    );
  );
  
  function band_sliders(startslider, filternumber) local (freq) (
  this.number = filternumber;
  this.first_slider = startslider;
  this.on = slider(startslider);
  slider(startslider+5) == 0 ? my_filter_type = 1 :
  slider(startslider+5) == 1 ? my_filter_type = 3 :
  slider(startslider+5) == 2 ? my_filter_type = 0 :
  slider(startslider+5) == 3 ? my_filter_type = 4 :
  slider(startslider+5) == 4 ? my_filter_type = 5 ;
  //freq = DO_OVERSAMPLE ? per_to_freq(slider(startslider+2),100) /2 : per_to_freq(slider(startslider+2),100);
  freq = per_to_freq(slider(startslider+2),100);
  slider(startslider) == 1 ? (
  this.band_set_filter(my_filter_type, freq, slider(startslider+1) * this.on, per_to_q(slider(startslider+3),100), slider(startslider+4));
  this.gfx.band_set_filter(my_filter_type, per_to_freq(slider(startslider+2),100), slider(startslider+1), per_to_q(slider(startslider+3),100), slider(startslider+4));
  this.gfx.filter.svf_set_to_target();
  ):(
  this.band_set_filter(0, freq, 0, per_to_q(slider(startslider+3),100), slider(startslider+4));
  this.gfx.band_set_filter(my_filter_type, per_to_freq(slider(startslider+2),100), slider(startslider+1), per_to_q(slider(startslider+3),100), slider(startslider+4));
  this.gfx.filter.svf_set_to_target();
  );
  !this.on || !slider(startslider+1) ? this.filter.svf_reset();
  );
  
  
  
  
  
  
  
  
  
  
  
  
  function fir1_set_oversample(os) (
    // We'll only switch to oversampling if the sample rate
    // is low enough to benefit.
    srate < 88200 && os ? (
      DO_OVERSAMPLE = 1;
      SAMPLE_RATE = srate * 2;
      ONE_OVER_SAMPLE_RATE = 1.0 / SAMPLE_RATE;
  
      // Choose right FIR window for sample rate
      srate == 44100 ? (
        firL1.init_FIR_filter_44100();
        firR1.init_FIR_filter_44100();
      ) : srate == 48000 ? ( 
        firL1.init_FIR_filter_48000();
        firR1.init_FIR_filter_48000();
      );
  
      fir0_pdc_delay = get_FIR_pdc();
  
    ) : ( 
      DO_OVERSAMPLE = 0;
