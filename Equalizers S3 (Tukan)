      ONE_OVER_SAMPLE_RATE = 1.0 / srate;
      fir0_pdc_delay = 0;
    );
  );
  
  
      
    
    
  function eqt_parameters(_slider1 _slider2 _slider3 _slider4 _slider5 _slider6 _slider7 _slider8 _slider9 _slider10) 
  instance (a0a a0b a0c a0d a1a a1b a1c a1d a2a a2b a2c a2d ac ad alphaA alphaB alphaC 
  b0a b0b b0c b0d b1a b1b b1c b1d b2a b2b b2c b2d cos_w0A cos_w0B cos_w0D dB_gainC dB_gainD
  dry d_wetA d_wetB fa fb fc fd freq2 freqa freqb outvol qa qb qc qd src_wetA src_wetB
  tempA tempB tgt_wetA tgt_wetB tmp tmp0D tmp1D tmp2D tmp2 twetA twetB vsrate w0A w0B w0C w0D
  vslider1 vslider10 vslider2 vslider3 vslider4 vslider5 vslider6 vslider7 vslider77 modern
  deltaA deltaB
  )
  (
  src_wetA = tgt_wetA;
  src_wetB = tgt_wetB;
 
   // ACHTUNG
   tempA = _slider2*10/15;
   
   //tgt_wetA = _slider2 <= 0 ? 0.0 : 10^(tempA/20);

   
   tempB = (-7.5+_slider3*0.5); //ACHTUNG
   
   //tgt_wetB = -_slider3 >= 0 ? 0.0 : 10^(tempB/20);
 
   DO_OVERSAMPLE ? vsrate = srate*2 : vsrate = srate; //srate < 50000 ? vsrate = srate*2 : vsrate = srate;
   //this.oversampling == 0 ? vsrate = srate;
   modern = _slider10;
   
   vslider2 = 20*(_slider2/10);
   vslider3 = 16*(_slider3/10);
   vslider77 = 18*(_slider6/10);
   vslider10 = 18*(_slider8/10);
   vslider6 = 2 - (0.2 + (_slider5/10)*1.8);
   
   vslider1 = floor(_slider1+0.1);
   vslider4 = floor(_slider4+0.1);
   vslider7 = floor(_slider7+0.1);
   
   vslider3 = -1*vslider3;
   vslider10 = -1*vslider10;
   //LowPass A
   !modern ? freqA = (vslider1 == 0 ? (3000) : (vslider1 == 1 ? (6000) : (vslider1 == 2 ? (12000) : (20000) )));
   modern ? freqA = (vslider1 == 0 ? (800) : (vslider1 == 1 ? (1200) : (vslider1 == 2 ? (4000) : (8000) )));
   fA = (3/max(vslider2,4))*2*$pi * min(freqA, 0.49 * vsrate) / vsrate;
   !modern ? qA = 0.08 * (36-vslider2)/18;
   modern ? qA = 0.1 * (36-vslider2)/18;
  
   
   w0A = fA;
   cos_w0A = cos(w0A);
   alphaA = sin(w0A) / (2*qA);
   
   b1A = 1 - cos_w0A;
   b0A = b2A = 0.5 * b1A;
   a0A = 1 + alphaA;
   a1A = -2 * cos_w0A;
   a2A = 1 - alphaA;
   
   a1A /= a0A;
   a2A /= a0A;
   b0A /= a0A;
   b1A /= a0A;
   b2A /= a0A;
   
   tempA = 0.9*vslider2;
   tgt_wetA = 10^(tempA/20)-1;//slider2 <= 0 ? 0.0 : 10^(tempA/20);
   
   //LowPass B
   !modern ? freqB = (vslider1 == 0 ? (4500) : (vslider1 == 1 ? (6500) : (vslider1 == 2 ? (11560) : (13640) )));
   modern ? freqB = (vslider1 == 0 ? (2600) : (vslider1 == 1 ? (5600) : (vslider1 == 2 ? (8000) : (13640) )));
   fB = 2*$pi * min(freqB, 0.49 * vsrate) / vsrate;
   !modern ? qB = 0.12 * (36-abs(vslider3))/18; //erste 0.04
   modern ? qB = 0.06 * (36-abs(vslider3))/18; //erste 0.04
   
   w0B = fB;
   cos_w0B = cos(w0B);
   alphaB = sin(w0B) / (2*qB);
   
   b1B = 1 - cos_w0B;
   b0B = b2B = 0.5 * b1B;
   a0B = 1 + alphaB;
   a1B = -2 * cos_w0B;
   a2B = 1 - alphaB;
   
   a1B /= a0B;
   a2B /= a0B;
   b0B /= a0B;
   b1B /= a0B;
   b2B /= a0B;
   
   tempB =  -vslider3;// 18.8 (-3/(slider3+1))+(-(12-(11.25*slider3/18))); ACHTUNG
   tgt_wetB = 0.885*log(1-vslider3)/2.9;//10^(tempB/20); //vslider3 >= 0 ? 0.0 : 10^(tempB/20);
   
   dry = 1;
   
   //Peak
   vslider4 == 0 ? (vslider5=3000);
   vslider4 == 1 ? (vslider5=4000);
   vslider4 == 2 ? (vslider5=5000);
   vslider4 == 3 ? (vslider5=8000);
   vslider4 == 4 ? (vslider5=10000);
   vslider4 == 5 ? (vslider5=12000);
   vslider4 == 6 ? (vslider5=16000);
   fC= 2*$pi * min(vslider5, 0.49 * vsrate) / vsrate;
   tmp = 0.3+((vslider6-0.2)*0.3);//(slider6 == 0 ? 0.3 : 1.2);
   qC = tmp;
   dB_gainC = vslider77;
   
   w0C = fC;
   alphaC = sin(w0C) / (2*qC);
   aC = 10^(db_gainC / 40);
   
   b0C = 1 + alphaC * aC;
   b1C = a1C = -2 * cos(w0C);
   b2C = 1 - alphaC * aC;
   a0C = 1 + alphaC / aC;
   a2C = 1 - alphaC / aC;
   
   a1C /= a0C;
   a2C /= a0C;
   b0C /= a0C;
   b1C /= a0C;
   b2C /= a0C;
   
   //HighShelf
   freq2 = (vslider7 == 0 ? 3000 : (vslider7 == 1 ? 5000 : (vslider7 == 2 ? 9000 :   6400 )));
   freq2 /= 2;
     
   qD = (vslider7 == 0 ? 0.5 : (vslider7 == 1 ? 0.48 : (vslider7 == 2 ? 0.46 :  0.46 )));
   
   fD = 2*$pi * min(freq2, 0.49 * vsrate) / vsrate;
   
   vslider7 > 1 ? (
   vslider10 >= 0 ? tmp2 = vslider10;
   vslider10 < 0 ? tmp2 = vslider10*0.75;
   ):(
   tmp2 = vslider10;
   );
   dB_gainD = tmp2;
   
   w0D = fD;
   cos_w0D = cos(w0D);
   aD = 10^(db_gainD / 40);
   
   tmp0D = 2 * sqrt(aD) * sin(w0D) / (2 * qD);
   tmp1D = (aD + 1) - (aD - 1) * cos_w0D;
   tmp2D = (aD + 1) + (aD - 1) * cos_w0D;
   
   b0D = aD * (tmp2D + tmp0D);
   b1D = -2 * aD * ((aD - 1) + (aD + 1) * cos_w0D);
   b2D = aD * (tmp2D - tmp0D);
   a0D = tmp1D + tmp0D;
   a1D = 2 * ((aD - 1) - (aD + 1) * cos_w0D);
   a2D = tmp1D - tmp0D;
   
   a1D /= a0D;
   a2D /= a0D;
   b0D /= a0D;
