@init 

function db2ratio(d) (10^(d/20); );
function ratio2db(r) (log(abs(r))*(20/log(10)));

function slider_update(slider_) (
  sliderchange(2^ (slider_-1));
  slider_automate(2^ (slider_-1));
);

function feed_meter(in_spl, fallback) 
instance (U_Val dB_Val dB_Val_Max)
(
    this.U_Val=abs(in_spl);
        ratio2db(this.U_Val) > this.dB_Val ? (
        this.dB_Val = ratio2db(this.U_Val);
    ):(
        this.dB_Val += fallback/srate; // db pro sec
    );
    this.dB_Val_Max = max(this.dB_Val_Max,this.dB_Val);
);


function feed_gr_meter(in_spl, fallback) 
instance (U_Val dB_Val dB_Val_Min)
(
    this.U_Val=abs(in_spl);
        ratio2db(this.U_Val) < this.dB_Val ? (
        this.dB_Val = ratio2db(this.U_Val);
    ):(
        this.dB_Val += fallback/srate; // db pro sec
    );
    this.dB_Val_Min = min(this.dB_Val_Min,this.dB_Val);
);

function reset_meter()
instance (U_Val dB_Val dB_Val_Max)
(
  u_Val = 0;
  db_val = -140;
  db_val_max = -140;
);

function reset_gr_meter()
instance (U_Val dB_Val dB_Val_Min)
(
  u_Val = 1;
  db_val = 0;
  db_val_min = 0;
);

function reset_meter_max()
instance (U_Val dB_Val dB_Val_Max)
(
  db_val_max = -140;
);

function reset_gr_meter_min()
instance (U_Val dB_Val dB_Val_Min)
(
  db_val_min = 0;
);



////////////////////////////////////////////////////////////////////////////////////////////
// fonsize(size)  -> use it in @gfx                                                       //
// Sets the fontsize of font#16 and uses 'Arial' bold.                                    //
// The size is scaled with the plugin.                                                    //
////////////////////////////////////////////////////////////////////////////////////////////
function fontsize(size_) (
  gfx_setfont(16,"Arial",size_*TK_GUI_Scaling,'b');
);

//////////////////////////////////////////////////////////////////////////////////////////////////////
// detect_mouse(sens) - don't call it from the code, it is called from the startgfx function        //
// This function gives you useful variables about the mouse:                                        //
// mouse_left, mouse_middle, mouse_right: 1 if the corresponding mouse button is pressed            //
// mouse_ctrl, mouse_shift, mouse_alt, mouse_win: 1 if key is pressed while a mousebutton is used   //
// mouse_click, mouse_click_right, mouse_click_middle: 1 if mouse button is pressed, 0 if just hold //
// mouse_doubleclick: 1 if a doubleclick (left mouse button) is detected                            //
// mouse_wheel_value: positive/negative depending on the direction, larger if scrolling is faster   //
//////////////////////////////////////////////////////////////////////////////////////////////////////
function detect_mouse (sens_) local (doubleclickcount) (
  mouse_sensitivitiy = sens_;
  mouse_left = (1 & mouse_cap)>0;
  mouse_right = (2 & mouse_cap)>0;
  mouse_middle = (64 & mouse_cap)>0;
  mouse_ctrl = (4 & mouse_cap)>0;
  mouse_shift = (8 & mouse_cap)>0;
  mouse_alt = (16 & mouse_cap)>0;
  mouse_win = (32 & mouse_cap)>0;
  
  mouse_Click = mouse_left_last == 0 && mouse_left == 1;
  mouse_left_last == 1 && mouse_left == 1 ? mouse_dragging = 1 : mouse_dragging = 0;
  mouse_left_last = mouse_left;
  
  mouse_Click_Right = mouse_right_last == 0 && mouse_right == 1;
  mouse_right_last = mouse_right;
  
  mouse_Click_Middle = mouse_Middle_last == 0 && mouse_middle == 1;
  mouse_middle_last = mouse_middle;
  
  doubleclickcount = max(doubleclickcount-1,0); mouse_doubleclick = 0;
  mouse_Click == 1 ? (doubleclickcount == 0 ? doubleclickcount = 8 : (mouse_doubleClick = 1));
  
  mouse_wheel_value = mouse_wheel;
  mouse_wheel = 0;
);



//////////////////////////////////////////////////////////////////////////////////////////////////////
// start_gfx(width,height,mouse_sensitivity) - call it at the beginning of @gfx                     //
//                                                                                                  //
// This function provides the scaling factor for plugin resizing. Variable name 'TK_GUI_Scaling'    //
// width & height need to be the defaults used in the @gfx line.                                    //
//                                                                                                  //
// This function also sets color to black and wipes the canvas with it.                             //
//                                                                                                  //
// mouse_sensitivity is a value in pixels that will be needed to turn a knob completely around.     //
//                                                                                                  //
// This function also gives you useful variables about the mouse:                                   //
// mouse_left, mouse_middle, mouse_right: 1 if the corresponding mouse button is pressed            //
// mouse_ctrl, mouse_shift, mouse_alt, mouse_win: 1 if key is pressed while a mousebutton is used   //
// mouse_click, mouse_click_right, mouse_click_middle: 1 if mouse button is pressed, 0 if just hold //
// mouse_doubleclick: 1 if a doubleclick (left mouse button) is detected                            //
// mouse_wheel_value: positive/negative depending on the direction, larger if scrolling is faster   //
//////////////////////////////////////////////////////////////////////////////////////////////////////
function start_gfx(w_,h_,mouse_) local(zoom_X, zoom_Y) (
  gfx_r=gfx_b=gfx_g = 0;
  gfx_rect(0,0,gfx_w,gfx_h);
  zoom_X = gfx_w / w_;
  zoom_y = gfx_h / h_;
  TK_GUI_Scaling = min(zoom_x, zoom_y);// * gfx_ext_retina;
  mouse_ == 0 ? mouse_ = 300*gfx_ext_retina;
  detect_mouse(mouse_);
  fontsize(12);
);


//////////////////////////////////////////////////////////////////////////////////////////////////////
// position the current drawing cursor (gfx_x, gfx_y) to a scaled position:                         //
//                                                                                                  //
// set_xy(x, y)                                                                                     //
// set_x(x)                                                                                         //
// set_y(y)                                                                                         //
// -> gfx_x and gfx_y to the given coordinates multiplied with the scaling factor 'TK_GUI_Scaling'  //
// width & height need to be the defaults used in the @gfx line.                                    //
//                                                                                                  //
// add_x(d) and add_y(d) move the draw cursor d scaled pixels.                                      //
//////////////////////////////////////////////////////////////////////////////////////////////////////
function set_xy (x_,y_) (
  gfx_x = x_ * TK_GUI_Scaling;
  gfx_y = y_ * TK_GUI_Scaling;
);

function set_x (x_) (
  gfx_x = x_ * TK_GUI_Scaling;
);

function set_y (y_) (
  gfx_y = y_ * TK_GUI_Scaling;
);

function add_x (d_) (
  gfx_x += d_ * TK_GUI_Scaling;
);

function add_y (d_) (
  gfx_y += d_ * TK_GUI_Scaling;
);


function draw_rect (x_,y_,w_,h_,border_) local (tmp_loop,tmp_loop2) (
  border_ == 0 ? (
    gfx_rect(x_*TK_GUI_Scaling, y_*TK_GUI_Scaling,w_*TK_GUI_Scaling,h_*TK_GUI_Scaling);
  ):(
    tmp_loop = 0;
    loop(abs(border_)*20,
      tmp_loop2 = floor(tmp_loop);
      gfx_rect(
        x_*TK_GUI_Scaling+tmp_loop2, 
        y_*TK_GUI_Scaling+tmp_loop2,
        w_*TK_GUI_Scaling-tmp_loop2,
        h_*TK_GUI_Scaling-tmp_loop2,0
      );
      tmp_loop += TK_GUI_Scaling/20*sign(border_);
    );
  );
);

function rgb(r_,g_,b_) (
  gfx_r = r_/255;
  gfx_g = g_/255;
  gfx_b = b_/255;
);

function black() (
  rgb(0,0,0);
);

function grey(lum_) (
  rgb(180*lum_,180*lum_,180*lum_);
);

function white(lum_) (
  rgb(255*lum_,255*lum_,255*lum_);
);

