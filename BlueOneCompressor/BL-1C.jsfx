// continue @init:

init_tables();

(sample_rate != srate) ? (

  effect.CLCompressor_setSampleRate();
  
  sample_rate = srate;
);

// reset state
effect.CLCompressor_reset();

hold_max_gr = 1.0;




///////////////////// ADDED
function init_meters() (
  InMeter.vu_meter_init(-18,0);
  OutMeter.vu_meter_init(-18,0);
  GRMeter.vu_meter_init(-0,1);
  GRMeter.nd_posL = 1;
  Left_In.reset_meter();
  Right_In.reset_meter();
  Left_Out.reset_meter();
  Right_Out.reset_meter();
  Reduct.reset_gr_meter();
);
init_meters();
///////////////////// ADDED


function slidercode() (
  slider7 = Meter_select = floor(slider7+0.5);
  slider5 = AR_select = ARSelect.value = floor(slider5+0.5);
  effect.CLCompressor_setParameters(//ratio, threshold_dB, attack_release_mode, attack, release, output_gain_dB
    (slider1 - 2.0) / 8.0,  // 2..10 -> 0..1
    slider2,
    slider5,
    slider3 * 0.1,  // 0..10 -> 0..1
    slider4 * 0.1,  // 0..10 -> 0..1
    slider6
  );
  
  plugin_on = slider8;

);


@slider

flag_run_slidercode = 1;

@block

ext_gr_meter = K_TO_DB(hold_max_gr);

hold_max_gr = 1.0;


///////////////////// ADDED
flag_run_slidercode ? (
   flag_run_slidercode = 0;
   slidercode();
);

!plugin_on ? ext_gr_meter = 0;
///////////////////// ADDED














@sample

plugin_on ? (
  effect.CLCompressor_processSampleStereo(spl0, spl1);
  hold_max_gr = min(hold_max_gr, effect.gr);
  InL = spl0; InR = spl1;
  spl0 = effect.y1;
  spl1 = effect.y2;
  GUI_MODE == 0 || GUI_MODE == 8 ? (
    InMeter.feed_vu_meter(InL+InR);///////////////////// ADDED
    OutMeter.feed_vu_meter(spl0+spl1);///////////////////// ADDED
    GRMeter.feed_vu_meter(effect.gr);///////////////////// ADDED
  );
  GUI_MODE > 0 && GUI_MODE <= 7 ? (
    Left_In.feed_meter(InL, -40);
    Right_In.feed_meter(InR, -40);
    reduct.feed_gr_meter(effect.gr,20);
    Left_Out.feed_meter(spl0, -60);
    Right_Out.feed_meter(spl1, -60);
  );
):(
  GUI_MODE == 0 || GUI_MODE ==  8 ? (
    InMeter.feed_vu_meter(spl0+spl1);///////////////////// ADDED
    OutMeter.feed_vu_meter(spl0+spl1);///////////////////// ADDED
    GRMeter.feed_vu_meter(1);///////////////////// ADDED
  );
  GUI_MODE > 0 && GUI_MODE <= 7 ? (
    Left_In.feed_meter(spl0, -40);
    Right_In.feed_meter(spl1, -40);
    reduct.feed_gr_meter(1,20);
    Left_Out.feed_meter(spl0, -60);
    Right_Out.feed_meter(spl1, -60);
  );
);


reset_cnt += 1;
reset_cnt >= srate/3 ? (
  reduct.reset_gr_meter_min();
  Left_in.reset_meter_max();
  Right_in.reset_meter_max();
  Left_out.reset_meter_max();
  Right_out.reset_meter_max();
  reset_cnt = 0;
);










