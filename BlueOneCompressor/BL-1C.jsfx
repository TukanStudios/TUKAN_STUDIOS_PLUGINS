slider2:0<-40,10,0.1>-Threshold, dB
slider3:5.0<0,10.0,0.1>-Attack
slider4:5.0<0,10.0,0.1>-Release
slider5:2<0,2,1{Fixed,Fixed/Manual,Manual}>-A/R Select
