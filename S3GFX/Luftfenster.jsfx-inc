    bez[bez_BL] = bez[bez_AL];
    bez[bez_AL] = inputSampleL;
    bez[bez_SampL] = 0.0;

    bez[bez_CR] = bez[bez_BR];
    bez[bez_BR] = bez[bez_AR];
