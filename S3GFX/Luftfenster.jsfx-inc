function initialize_reverb (bufstart_) 
instance (
memfactor freemem Rev_buf_start rev_buf_length
aAL aBL aCL aDL aEL aFL aGL aHL aIL aJL aKL aLL aML aNL aOL aPL aQL aRL aSL aTL aUL aVL aWL aXL aYL
