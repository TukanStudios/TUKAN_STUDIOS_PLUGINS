parameters_update_on = 0;
function parameters_update () (
parameters_update_on = 1;
//Settings_slider = 153;

       // KInDrive.Parameter_Boundaries();    
all_boundaries();

    group_parameters();


general_bypass = slider52;

//C = 0.5;//slider3;
//D = 1;//slider4;
PreDelay_Sams = slider3*srate/1000;
//wander = slider4/100;
//low = 1-slider5/100;
//high = slider6/100;

rev_type = slider18;
AMB_startslider = 12;
Room_startslider = 14;
Hall_startslider = 16;

rev_type == 1 ? (
  //A = 0.1 + slider(Amb_Startslider)*0.002;
  Schroeder_Stretch = 0.5 + slider(Amb_Startslider)*0.009;
  //B = slider(Amb_Startslider+1)*0.005;
  use_a = slider(Amb_Startslider)*0.3;
  use_b = slider(Amb_Startslider+1)/3 ;
  ERS.air_room_slider(slider53,slider(Amb_Startslider)/100,1,1,1);
);

rev_type == 2 ? (
  //A = 0.2 + slider(Room_Startslider)*0.002;
  Schroeder_Stretch = 0.3 + slider(Room_Startslider)*0.006;
  //B = slider(Room_Startslider+1)*0.004;
  use_a = slider(Room_Startslider)*0.5;
  use_b = slider(Room_Startslider+1)*0.7;
  ERS.air_room_slider(slider53,slider(Room_Startslider)/100, 1,1,1);
);

rev_type == 3 ? (
  //A = 0.4 + slider(Hall_Startslider)*0.0035;
  Schroeder_Stretch = 0.8 + slider(Hall_Startslider)*0.02;
  //B = slider(Hall_Startslider+1)*0.007;
  use_a = slider(Hall_Startslider);
  use_b = slider(Hall_Startslider+1);
  ERS.air_room_slider(slider53,slider(Hall_Startslider)/100,0.2+slider5/200,1,1);
);

reverb.reverB_parameters_update(use_a, use_b, 0.07+slider4*0,1,1, slider54); // size, sustain, wander, low, high ... low und high sind in der lib deaktiviert, manuell neu im code hier


R_HP_L.buthp_set_freq(per_to_freq(slider6,100));
R_HP_R.buthp_set_freq(per_to_freq(slider6,100));
R_LP_L.butlp_set_freq(per_to_freq(60+slider5,100));
R_LP_R.butlp_set_freq(per_to_freq(60+slider5,100));
R_HP_On = slider6 > 0;
R_LP_on = slider5 < 40;

a1L.allpass_set_delay(0.0204  *Schroeder_Stretch);
a2L.allpass_set_delay(0.06653 *Schroeder_Stretch);
a3L.allpass_set_delay(0.035007*Schroeder_Stretch);
a4L.allpass_set_delay(0.023021*Schroeder_Stretch);
a1R.allpass_set_delay(0.02011 *Schroeder_Stretch);
a2R.allpass_set_delay(0.06641 *Schroeder_Stretch);
a3R.allpass_set_delay(0.03504 *Schroeder_Stretch);
a4R.allpass_set_delay(0.022987*Schroeder_Stretch);


LowSH.Mpy = (3*(slider8/100)) * (1-(0.05+((B*0.9)^(1/2))));
          //F , Q, G, Type
    LowSh_f0.eq(slider7, 0.7, LowSH.Mpy, 1);
    LowSh_f1.eq(slider7, 0.7, LowSH.Mpy, 1);
    LowSh_f2.eq(slider7, 0.7, LowSH.Mpy, 1);
    LowSh_f3.eq(slider7, 0.7, LowSH.Mpy, 1);
    LowSh_f4.eq(slider7, 0.7, LowSH.Mpy, 1);
    LowSh_f5.eq(slider7, 0.7, LowSH.Mpy, 1);
    LowSh_f6.eq(slider7, 0.7, LowSH.Mpy, 1);
    LowSh_f7.eq(slider7, 0.7, LowSH.Mpy, 1);
    LowSh_f8.eq(slider7, 0.7, LowSH.Mpy, 1);
    LowSh_f9.eq(slider7, 0.7, LowSH.Mpy, 1);

    //hdampL.eq(1600,0.41,-1,2);
    //hdampR.eq(1600,0.41,-1,2);


HighSH.Mpy = -slider4*0.05;
Hdmp_f = 2800;
    HighSh_f0.eq(Hdmp_f, 0.41, HighSH.Mpy, 2);
    HighSh_f1.eq(Hdmp_f, 0.41, HighSH.Mpy, 2);
    HighSh_f2.eq(Hdmp_f, 0.41, HighSH.Mpy, 2);
    HighSh_f3.eq(Hdmp_f, 0.41, HighSH.Mpy, 2);
    HighSh_f4.eq(Hdmp_f, 0.41, HighSH.Mpy, 2);
    HighSh_f5.eq(Hdmp_f, 0.41, HighSH.Mpy, 2);
    HighSh_f6.eq(Hdmp_f, 0.41, HighSH.Mpy, 2);
    HighSh_f7.eq(Hdmp_f, 0.41, HighSH.Mpy, 2);
    HighSh_f8.eq(Hdmp_f, 0.41, HighSH.Mpy, 2);
    HighSh_f9.eq(Hdmp_f, 0.41, HighSH.Mpy, 2);
   
    input_spread = 0.5-(slider10/200);
    output_spread = slider11/200;
 
  
  delay.mode = slider32;
  
  delay.mode != 1 ? (
      slider20_old != slider20 ? (slider26 = slider26_old = slider20);
      slider21_old != slider21 ? (slider27 = slider27_old = slider21);
      slider22_old != slider22 ? (slider28 = slider28_old = slider22);
      slider23_old != slider23 ? (slider29 = slider29_old = slider23);
      slider24_old != slider24 ? (slider30 = slider30_old = slider24);
      slider25_old != slider25 ? (slider31 = slider31_old = slider25);
      slider26_old != slider26 ? (slider20 = slider20_old = slider26);
      slider27_old != slider27 ? (slider21 = slider21_old = slider27);
      slider28_old != slider28 ? (slider22 = slider22_old = slider28);
      slider29_old != slider29 ? (slider23 = slider23_old = slider29);
      slider30_old != slider30 ? (slider24 = slider24_old = slider30);
      slider31_old != slider31 ? (slider25 = slider25_old = slider31);
      //slider43_old != slider43 ? (slider44 = slider44_old = slider43);
      //slider44_old != slider44 ? (slider43 = slider43_old = slider44);
      //slider45_old != slider45 ? (slider46 = slider46_old = slider45);
      //slider46_old != slider46 ? (slider45 = slider45_old = slider46);
      slider20_old = slider20;
      slider21_old = slider21;
      slider22_old = slider22;
      slider23_old = slider23;
      slider24_old = slider24;
      slider25_old = slider25;
      slider26_old = slider26;
      slider27_old = slider27;
      slider28_old = slider28;
      slider29_old = slider29;
      slider30_old = slider30;
      slider31_old = slider31;
      //slider43_old = slider43;
      //slider44_old = slider44;
      //slider45_old = slider45;
      //slider46_old = slider46;
  );
  
  delay_L.deline_sliders(20);
  
  delay.mode != delay.mode_old ? (
    delay_L.deline_clear(); delay_R.deline_clear(); delay_ITGL.deline_clear(); delay_ITGR.deline_clear();
    delay_ITGL.delay_sams_force = 1;
    delay_ITGR.delay_sams_force = 1;
    delay_L.delay_sams_force = 1;
    delay_R.delay_sams_force = 1;
  );
  delay.mode_old = delay.mode;
  delay.mode == 1 ? delay_R.deline_sliders(26) : delay_R.deline_sliders(20);
  delay.mode == 2 ? (
    pingpong = 1; 
    delay_L.input_gain = db2ratio(ratio2db(delay_L.feedback)/2);
    //delay_L.ms *= 2; 
    //delay_L.tempo += 1; 
    //delay_L.feedback = 0; 
    //delay_R.ms *= 2; 
    //delay_R.tempo += 1;
    //delay_R.feedback = 0;
  ) : (
    pingpong = 0;
  );
  delay_on = slider39;
  delay_ITGL.deline_sliders(20);
  delay_ITGL.feedback = 0;
  delay_ITGR.deline_sliders(20);
  delay_ITGR.feedback = 0; 
  //delay_ITG.ms /= 2; //delay_ITG.tempo += 1;
Tape_mode = slider33;
Wow.wowflut_parameters(slider34/100, 0.05 + 0.2*(slider35/100)); //amount speed
Flutter.wowflut_parameters(slider36/100, 0.37 + 0.3*(slider37/100));
Cas_left.TapeHead_setDrive(2+(slider38*0.8));
Cas_right.TapeHead_setDrive(2+(slider38*0.8));
Cas_left.TapeHead_setColor(slider40);
Cas_right.TapeHead_setColor(slider40);
Cas_left.TapeHead_setHardClip(1);
Cas_right.TapeHead_setHardClip(1);
trim = slider38 * -2;
slider40 == 0 ? trim+=0 : slider40 == 1 ? trim -= 2 : trim -= 3;
Cas_left.TapeHead_setTrim(trim); 
Cas_right.TapeHead_setTrim(trim);


ITG_Wow.wowflut_parameters(slider34/100, 0.05 + 0.2*(slider35/100)); //amount speed
ITG_Flutter.wowflut_parameters(slider36/100, 0.37 + 0.3*(slider37/100));
ITG_Cas_left.TapeHead_setDrive(2+(slider38*0.8));
ITG_Cas_right.TapeHead_setDrive(2+(slider38*0.8));
ITG_Cas_left.TapeHead_setColor(slider40);
ITG_Cas_right.TapeHead_setColor(slider40);
ITG_Cas_left.TapeHead_setHardClip(1);
ITG_Cas_right.TapeHead_setHardClip(1);
ITG_Cas_left.TapeHead_setTrim(trim); 
ITG_Cas_right.TapeHead_setTrim(trim);



D_HP_L.buthp_set_freq(per_to_freq(slider41,100));
D_HP_R.buthp_set_freq(per_to_freq(slider41,100));
D_LP_L.butlp_set_freq(per_to_freq(60+slider42,100));
D_LP_R.butlp_set_freq(per_to_freq(60+slider42,100));
D_HP_On = slider41 > 0;
D_LP_on = slider42 < 40;

D_Pan_L = slider43;  
D_Pan_L_spl = (100+slider43)/200;  
D_Pan_R = slider44;
D_Pan_R_spl = (100+slider44)/200;  
D_Vol_L = db2ratio(slider45); slider45 == -36 ? D_Vol_L = 0;
D_Vol_R = db2ratio(slider46); slider46 == -36 ? D_Vol_R = 0;

delay_input = slider1;
reverb_input = slider2;

Delay_to_Rev = slider9;

ER_Output = slider47;
RVB_Output = slider48;
rev_output = slider51;
del_output = slider50;
dry_output = slider49;

general_bypass = slider52;

/*
    w_a1L.allpass(0.0204*output_spread, 0.35*output_spread1);      w_a1R.allpass(0.02011*output_spread, 0.35*output_spread1);
    w_a2L.allpass(0.06653*output_spread, 0.41*output_spread1);     w_a2R.allpass(0.06641*output_spread, 0.41*output_spread1);
    w_a3L.allpass(0.035007*output_spread, 0.5*output_spread1);     w_a3R.allpass(0.03504*output_spread, 0.5*output_spread1);
    w_a4L.allpass(0.023021*output_spread, 0.65*output_spread1);    w_a4R.allpass(0.022987*output_spread, 0.65*output_spread1);
*/


caller = 0;
parameters_update_on = 0;
);












@slider

  parameters_update_on == 0 ? (
    parameters_update();
  ):(
    caller = 1;
  );




@serialize
serialize_s3();







  
@block


//Maximum allowed srate: 176.400
srate > 176400 ? srate_too_high = 1 : srate_too_high = 0;

srate_old != srate ? initialize_everthing();
srate_old = srate;



delay_L.bpm = delay_R.bpm = delay_ITG.bpm = delay_ITGL.bpm = delay_ITGR.bpm = tempo;


reverb.block_reverb();
ERS.air_room_Block();

spread_count_max = 0.01*srate;//0.024*srate;


Wow.wowflut_block();
Flutter.wowflut_block();

ITG_Wow.wowflut_block();
ITG_Flutter.wowflut_block();


S2_sample_on = 1;
gmem[16*256 + 10 + link_group] != 1 ? link_group = 0;
group_check_smpl();
caller == 1 ? (
  parameters_update_on == 0 ? (
    parameters_update();
  );
);


@sample




!general_bypass ? (

drySampleL = spl0;
drySampleR = spl1;

delay_on ? (

delay.mode < 2 ? (delay_L.in = spl0*delay_input; delay_R.in = spl1*delay_input) : (delay_L.in = delay_R.in = 0.5*(spl0+spl1)*delay_input);


    Tape_mode == 1 && pingpong ? (
    ITG_Wow.wowflut_do(delay_L.in, delay_R.in);
    delay_L.in = ITG_Wow.outL;
    //delay_R.in = Wow.outR;
    ITG_Flutter.wowflut_do(delay_L.in, delay_R.in);
    delay_L.in = ITG_Flutter.outL;
    //delay_R.in = Flutter.outR;
    delay_L.in = ITG_cas_left.TapeHead_processSample(delay_L.in);
    //delay_R.in = cas_right.TapeHead_processSample(delay_R.in);
    );


!Pingpong ? (
delay_L.deline_feed(delay_L.in);
delay_R.deline_feed(delay_R.in);

delay_L.deline_read();
delay_R.deline_read();


    Tape_mode == 1 ? (
    Wow.wowflut_do(delay_L.out, delay_R.out);
    delay_L.out = Wow.outL;
    delay_R.out = Wow.outR;
    Flutter.wowflut_do(delay_L.out, delay_R.out);
    delay_L.out = Flutter.outL;
    delay_R.out = Flutter.outR;
    delay_L.out = cas_left.TapeHead_processSample(delay_L.out);
    delay_R.out = cas_right.TapeHead_processSample(delay_R.out);
    );

  tape_mode ? (
    delay_L_output = delay_L.out;
    delay_R_output = delay_R.out;
  ):(
    delay_L_output = min(1,max(-1,delay_L.out));
    delay_R_output = min(1,max(-1,delay_R.out));
  );
):(
delay_ITGL.deline_feed(delay_L.in);
delay_ITGL.deline_ITG_read();
delay_ITGR.deline_feed(delay_L.in)*delay_R.feedback;
delay_ITGR.deline_ITG_read();


    delay_L_output = delay_L.in*delay_L.input_gain;
    delay_R_output = delay_itgR.out*delay_R.feedback;

    Tape_mode == 1 ? (
    Wow.wowflut_do(delay_L_output, delay_R_output);
    delay_L_output = Wow.outL;
    delay_R_output = Wow.outR;
    Flutter.wowflut_do(delay_L_output, delay_R_output);
    delay_L_output = Flutter.outL;
    delay_R_output = Flutter.outR;
    delay_L_output = cas_left.TapeHead_processSample(delay_L_output);
    delay_R_output = cas_right.TapeHead_processSample(delay_R_output);
    );

delay_L.deline_feed(delay_L_output);
delay_R.deline_feed(delay_R_output);

delay_L.deline_read();
delay_R.deline_read();
  tape_mode ? (
    delay_L_output = (delay_L.out);
    delay_R_output = (delay_R.out + delay_ITGR.out);
  ):(
    delay_L_output = min(1,max(-1,(delay_L.out)));
    delay_R_output = min(1,max(-1,(delay_R.out + delay_ITGR.out))); 
  );
);

D_HP_on ? (
delay_L_output = D_HP_L.buthp_do(delay_L_output);
delay_R_output = D_HP_R.buthp_do(delay_R_output);
);
D_LP_on ? (
delay_L_output = D_LP_L.butlp_do(delay_L_output);
delay_R_output = D_LP_R.butlp_do(delay_R_output);
);

delay_L_output_tmp = delay_L_output*D_Vol_L;
delay_R_output_tmp = delay_R_output*D_Vol_R;

delay_L_output = delay_L_output_tmp * (1-D_Pan_L_spl) + delay_R_output_tmp * (1-D_Pan_R_spl);
delay_R_output = delay_L_output_tmp * (D_Pan_L_spl) + delay_R_output_tmp * (D_Pan_R_spl);
 //delay_L_output = delay_R_output = 0;
 delay_L_output != delay_R_output ? katze += 1;
):(
  delay_L_output = 0;
  delay_R_output = 0;
);







rev_type ? (

inputSampleL = Delay_to_Rev*delay_L_output + (1-input_spread) * drySampleL*reverb_input + input_spread * drySampleR*reverb_input;
inputSampleR = Delay_to_Rev*Delay_R_output + (1-input_spread) * drySampleR*reverb_input + input_spread * drySampleL*reverb_input;

R_HP_on ? (
inputSampleL = R_HP_L.buthp_do(inputSampleL);
inputSampleR = R_HP_R.buthp_do(inputSampleR);
);

/*
spread_count_L > spread_count_max ? spread_count_L = 0;
spread_count_R > spread_count_max ? spread_count_R = 0;

StereobufL[spread_count_L] = (inputSampleL+inputSampleR)/2;
StereobufR[spread_count_R] = (inputSampleL+inputSampleR)/2;

spread_count_L += 1; 
spread_count_R += 1;

SpreadL = StereobufL[spread_count_L];
SpreadR = StereobufR[spread_count_R];

inputSampleL = ((1-output_spread)*inputSampleL + output_spread*SpreadL);
inputSampleR = ((1-output_spread)*inputSampleR + output_spread*SpreadR * -1);

*/

 /* OLD ERS
    // Left channel                 Right channel                 
    sig1L = a1L.allpass_do(inputSampleL);   sig1R = a1R.allpass_do(inputSampleR);
    sig2L = a2L.allpass_do(sig1L);  sig2R = a2R.allpass_do(sig1R);
    sig3L = a3L.allpass_do(sig2L);  sig3R = a3R.allpass_do(sig2R);
    sig4L = a4L.allpass_do(sig3L);  sig4R = a4R.allpass_do(sig3R);
    
    lop1L = lp1L.lop_do(sig1L);     lop1R = lp1R.lop_do(sig1R);
    lop2L = lp2L.lop_do(sig2L);     lop2R = lp2R.lop_do(sig2R);
    lop3L = lp3L.lop_do(sig3L);     lop3R = lp3R.lop_do(sig3R);
    lop4L = lp4L.lop_do(sig4L);     lop4R = lp4R.lop_do(sig4R);
    sigL = (lop1L + lop2L + lop3L + lop4L) * 0.5;
    sigR = (lop1R + lop2R + lop3R + lop4R) * 0.5;
    sigL -= inputSampleL;
    sigR -= inputSampleR;
  */


PreDelayBufL[PreDelay_Counter] = inputSampleL;
PreDelayBufR[PreDelay_Counter] = inputSampleR;
PreDelay_counter += 1; Predelay_counter > PreDelay_Sams ? Predelay_Counter = 0;
inputSampleL =PreDelayBufL[PreDelay_Counter];
inputSampleR =PreDelayBufR[PreDelay_Counter];
  
  
  
  reverb.reverb_do_part1(inputSampleL,inputSampleR);
  ERS.air_room_do(inputSampleL, inputSampleR);
  
  LowSH.Mpy ? (
  reverb.feedbackAR = LowSh_f0.eq_do(reverb.feedbackAR);
  reverb.feedbackBL = LowSh_f1.eq_do(reverb.feedbackBL);
  reverb.feedbackCR = LowSh_f2.eq_do(reverb.feedbackCR);
  reverb.feedbackDL = LowSh_f3.eq_do(reverb.feedbackDL);
  reverb.feedbackER = LowSh_f4.eq_do(reverb.feedbackER);
  
  reverb.feedbackAL = LowSh_f5.eq_do(reverb.feedbackAL);
  reverb.feedbackBR = LowSh_f6.eq_do(reverb.feedbackBR);
  reverb.feedbackCL = LowSh_f7.eq_do(reverb.feedbackCL);
  reverb.feedbackDR = LowSh_f8.eq_do(reverb.feedbackDR);
  reverb.feedbackEL = LowSh_f9.eq_do(reverb.feedbackEL);
  );
  
  HighSH.Mpy ? (
  reverb.feedbackAR = HighSh_f0.eq_do(reverb.feedbackAR);
  reverb.feedbackBL = HighSh_f1.eq_do(reverb.feedbackBL);
  reverb.feedbackCR = HighSh_f2.eq_do(reverb.feedbackCR);
  reverb.feedbackDL = HighSh_f3.eq_do(reverb.feedbackDL);
  reverb.feedbackER = HighSh_f4.eq_do(reverb.feedbackER);
  
  reverb.feedbackAL = HighSh_f5.eq_do(reverb.feedbackAL);
  reverb.feedbackBR = HighSh_f6.eq_do(reverb.feedbackBR);
  reverb.feedbackCL = HighSh_f7.eq_do(reverb.feedbackCL);
  reverb.feedbackDR = HighSh_f8.eq_do(reverb.feedbackDR);
  reverb.feedbackEL = HighSh_f9.eq_do(reverb.feedbackEL);
  );
  
    output_spread1 = 1;
    /*
    reverb.feedbackBL = (1-output_spread1)*reverb.feedbackBL + (output_spread1)*w_a1L.allpass_do(reverb.feedbackBL);
    reverb.feedbackBR = (1-output_spread1)*reverb.feedbackBR + (output_spread1)*w_a1R.allpass_do(reverb.feedbackBR);
    reverb.feedbackCL = (1-output_spread1)*reverb.feedbackCL + (output_spread1)*w_a2L.allpass_do(reverb.feedbackCL);
    reverb.feedbackCR = (1-output_spread1)*reverb.feedbackCR + (output_spread1)*w_a2R.allpass_do(reverb.feedbackCR);
    reverb.feedbackDL = (1-output_spread1)*reverb.feedbackDL + (output_spread1)*w_a3L.allpass_do(reverb.feedbackDL);
    reverb.feedbackDR = (1-output_spread1)*reverb.feedbackDR + (output_spread1)*w_a3R.allpass_do(reverb.feedbackDR);
    reverb.feedbackEL = (1-output_spread1)*reverb.feedbackEL + (output_spread1)*w_a4L.allpass_do(reverb.feedbackEL);
    reverb.feedbackER = (1-output_spread1)*reverb.feedbackER + (output_spread1)*w_a4R.allpass_do(reverb.feedbackER);
    */

    
    reverb.feedbackBL = (1-output_spread1)*reverb.feedbackBL + (output_spread1)*w_a1L.biquad_do(reverb.feedbackBL);
    reverb.feedbackBR = (1-output_spread1)*reverb.feedbackBR + (output_spread1)*w_a1R.biquad_do(reverb.feedbackBR);
    reverb.feedbackCL = (1-output_spread1)*reverb.feedbackCL + (output_spread1)*w_a2L.biquad_do(reverb.feedbackCL);
    reverb.feedbackCR = (1-output_spread1)*reverb.feedbackCR + (output_spread1)*w_a2R.biquad_do(reverb.feedbackCR);
    reverb.feedbackDL = (1-output_spread1)*reverb.feedbackDL + (output_spread1)*w_a3L.biquad_do(reverb.feedbackDL);
    reverb.feedbackDR = (1-output_spread1)*reverb.feedbackDR + (output_spread1)*w_a3R.biquad_do(reverb.feedbackDR);
    reverb.feedbackEL = (1-output_spread1)*reverb.feedbackEL + (output_spread1)*w_a4L.biquad_do(reverb.feedbackEL);
    reverb.feedbackER = (1-output_spread1)*reverb.feedbackER + (output_spread1)*w_a4R.biquad_do(reverb.feedbackER);
    
    
reverb.reverb_do_part2();

ERS_M = (ERS.spl_outL+ERS.spl_outR)*0.5;
ERS_S = ERS.spl_outL-ERS.spl_outR;
ERS_outL = ERS_M + output_spread*ERS_S*0.5;
ERS_outR = ERS_M - output_spread*ERS_S*0.5;

RV_M = (reverb.outputSampleL+reverb.outputSampleR)*0.5;
RV_S = reverb.outputSampleL-reverb.outputSampleR;
reverb.outputSampleL = RV_M + output_spread*RV_S*0.7;
reverb.outputSampleR = RV_M - output_spread*RV_S*0.7;

inputSampleL = 0.5*reverb.outputSampleL*RVB_Output + ERS_outL*ER_Output;
inputSampleR = 0.5*reverb.outputSampleR*RVB_Output + ERS_outR*ER_Output;


):(
inputSampleL = inputSampleR = sigL = sigR = 0;
reverb.outputSampleL = 0;
reverb.outputSampleR = 0;
); //Rev Type

R_LP_on ? (
inputSampleL = R_LP_L.butlp_do(inputSampleL);
inputSampleR = R_LP_R.butlp_do(inputSampleR);
);



spl0 = dry_output*drySampleL + inputSampleL*rev_output + delay_L_output * del_output;
spl1 = dry_output*drySampleR + inputSampleR*rev_output + delay_R_output * del_output;

); //general _ bypass

























@gfx 1104 839
s2_zoom_X = gfx_w / 1104;
s2_zoom_y = gfx_h / 839;
zoom = min(s2_zoom_x, s2_zoom_y);// * gfx_ext_retina;
zoom_off == 1 ? zoom = gfx_ext_retina;


mouse_state();







      function dot (position, _distance) local (_mitteX, _mitteY, _radius,_klw, _klh, _offsX, _offsY) (

      gfx_measurestr(#S3Label, _klw, _klh);
      _mitteX = this.xIn*zoom + this.size*zoom*0.25*this.scaling;
      _mitteY = this.yIn*zoom + this.size*zoom*0.25*this.scaling;
      _radius = this.size*zoom*0.25*this.scaling*_distance;
 
      _offsX = cos(2*$pi*((position-90)/360)) * _radius;
      _offsY = sin(2*$pi*((position-90)/360)) * _radius;

      gfx_x = _mitteX+_offsX; gfx_y = _mitteY+_offsY;
      );
      

function lightgrey2() (
lightgrey();
gfx_r += 0.2;
gfx_g += 0.2;
gfx_b += 0.2;
);
   
   
function juppi (jx, jy) local (range) (
lightgrey();
gfx_rect(jx*zoom-10*zoom, jy*zoom+14*zoom, 65*zoom, max(1,2*zoom));
gfx_rect(jx*zoom-10*zoom, jy*zoom+14*zoom+juppi_h/2, 65*zoom, max(1,2*zoom));
gfx_rect(jx*zoom-10*zoom, jy*zoom+14*zoom+Juppi_h, 65*zoom, max(1,2*zoom));

gfx_rect(jx*zoom-10*zoom, jy*zoom+14*zoom+1*(Juppi_h/10), 65*zoom, max(1,zoom));
gfx_rect(jx*zoom-10*zoom, jy*zoom+14*zoom+2*(Juppi_h/10), 65*zoom, max(1,zoom));
gfx_rect(jx*zoom-10*zoom, jy*zoom+14*zoom+3*(Juppi_h/10), 65*zoom, max(1,zoom));
gfx_rect(jx*zoom-10*zoom, jy*zoom+14*zoom+4*(Juppi_h/10), 65*zoom, max(1,zoom));
gfx_rect(jx*zoom-10*zoom, jy*zoom+14*zoom+6*(Juppi_h/10), 65*zoom, max(1,zoom));
gfx_rect(jx*zoom-10*zoom, jy*zoom+14*zoom+7*(Juppi_h/10), 65*zoom, max(1,zoom));
gfx_rect(jx*zoom-10*zoom, jy*zoom+14*zoom+8*(Juppi_h/10), 65*zoom, max(1,zoom));
gfx_rect(jx*zoom-10*zoom, jy*zoom+14*zoom+9*(Juppi_h/10), 65*zoom, max(1,zoom));
black(); 
gfx_rect(jx*zoom+20*zoom, jy*zoom+14*zoom, 5*zoom, juppi_h+2*zoom);
range = this.maxVal - this.minVal;
gfx_x = jx*zoom-2*zoom; gfx_y = jy*zoom + juppi_h - (slider(this.slider)/range)*juppi_h;
gfx_blit(6,0.5*zoom,0); // 35* 17
//g_collision(gfx_x, gfx_y, 45*zoom, 30*zoom) && mouseClick ? (
mouseClick == 1 && g_collision(gfx_x, gfx_y, 45*zoom, 30*zoom) && !this.number_input ? (this.v_dragstart_S3(); caller = 1);
this.check_double_click();
this.v_dragging ? (this.v_potdrag_S3(juppi_h); caller = 1);
MouseClick == - 1 ? (this.dragstop_S3(); caller = 1);
this.hv_rightclick (gfx_x/zoom,gfx_y/zoom, gfx_x, gfx_y, 45*zoom, 30*zoom); //(x_ y_ col_x col_y col_w col_h) 

this.gen_tt(gfx_x, gfx_y, 45*zoom, 30*zoom,2);
);

function juppi_label (jx, jy, y_pos_) local (offset) (
y_pos_ == 0 ? offset = -30*zoom;
y_pos_ == 1 ? offset = -12*zoom;
y_pos_ == 2 ? offset = juppi_h+34*zoom;
y_pos_ == 3 ? offset = Juppi_h+52*zoom;
