#S3_TT3 = "but you need to automate then)";
DR_Feedback.pot_tt(3);
#S3_TT1 = "Pitch / Speed drift";
#S3_TT2 = "when changing delay times";
DR_Slide.pot_tt(2); 
#S3_TT1 = "Output panorama for this delay line";
DR_Pan.pot_tt(1);
#S3_TT1 = "Output volume for this delay line";
DR_Vol.pot_tt(1); 
#S3_TT1 = "Tape Saturation";
Delay_Drive.pot_tt(1);
#S3_TT1 = "General tone color";
#S3_TT2 = "(changes with different 'drive' settings)";
Delay_Tape.pot_tt(2);
#S3_TT1 = "Slow tape speed variation";
#S3_TT2 = "amount";
#S3_TT3 = "(also stereo inconsitencies)";
Delay_WowA.pot_tt(3);
#S3_TT2 = "speed";
Delay_WowF.pot_tt(3); 
#S3_TT1 = "Fast tape speed variation";
#S3_TT2 = "amount";
Delay_FlutA.pot_tt(3);
#S3_TT2 = "speed";
Delay_FlutF.pot_tt(3);

#S3_TT1 = "Reverb tail length";
#S3_TT2 = "(also depending on the size)";
Rev_AmbSustain.pot_tt(2);
#S3_TT1 = "Size of the virtual room.";
#S3_TT2 = "(Moving this knob resets the";
#S3_TT3 = "reverb buffer, automation tricky)";
Rev_AmbSize.pot_tt(3);
#S3_TT1 = "Remove lows from the reverb";
Rev_LowCut.pot_tt(1);
#S3_TT1 = "Remove treble from the reverb";
Rev_HighCut.pot_tt(1);
#S3_TT1 = "Reverb time scaling for the lows";
Rev_BMPY.pot_tt(1);
#S3_TT1 = "Frequency selection for";
#S3_TT2 = "low's reverb time scaling";
Rev_BMPYf.pot_tt(2);
#S3_TT1 = "How much faster highs decay";
Rev_Wander.pot_tt(1); 
#S3_TT1 = "Level of the early reflections";
Rev_ER.pot_tt(1);
#S3_TT1 = "Level of the reveb tail";
Rev_TAIL.pot_tt(1); 
#S3_TT1 = "Saturation / overtones.";
#S3_TT2 = "(real rooms don't produce overtones";
#S3_TT3 = "but reverb units might do)";
Rev_Overtones.pot_tt(3);

show_tt();
quicklink_code();
show_numberfield();
 
 mouse_wheel = 0;
 S2_sample_on == 0 ? (
 gmem[16*256 + 10 + link_group] != 1 ? link_group = 0;
 group_check_gfx();
 caller == 1 ? (
   parameters_update_on == 0 ? (
     parameters_update();
   );
 );
 );
 S2_sample_on = 0;
 
 
 ):( //ext flags
 
 gfx_r=gfx_g=gfx_b=0.12;
 gfx_rect(0,0,gfx_w,gfx_h);
 
 zoom = gfx_w / 55;
 gfx_setfont(2,"Arial",10*zoom,'b');
 
 
 !general_bypass ? rgb(200,255,100) : rgb(30,160,30);
 gfx_x = 15*zoom; gfx_y = 2*zoom;
 gfx_drawstr("E & R");
 
 !general_bypass ? (
  delay_on ? rgb(25,250,0) : rgb(130,130,130);
  Tape_mode ? (
    gfx_x = 6*zoom; gfx_y = 17*zoom;
    gfx_drawstr("TP-ECHO");
  ):(
    gfx_x = 14*zoom; gfx_y = 17*zoom;
    gfx_drawstr("ECHO");
  );
  
  rev_type ? rgb(25,250,0) : rgb(130,130,130);
  
  rev_type == 1 ? (
    gfx_x = 17*zoom; gfx_y = 32*zoom;
    gfx_drawstr("AMB.");
  ):
  rev_type == 2 ? (
    gfx_x = 13*zoom; gfx_y = 32*zoom;
    gfx_drawstr("ROOM");
  ):
  rev_type == 3 ? (
    gfx_x = 15*zoom; gfx_y = 32*zoom;
    gfx_drawstr("HALL");
  ):
  rev_type == 0 ? (
    gfx_x = 10*zoom; gfx_y = 32*zoom;
    gfx_drawstr("NO RVB");
  );
  
  #mini_group = sprintf(#, "%i", Link_Group);
  gfx_measurestr(#mini_group, mini_w, mini_h);
  gfx_x = gfx_w - mini_w - gfx_w/20; gfx_y = 2*zoom;
  Link_Group ? (
    rgb_palette(Link_group);
    gfx_drawstr(#mini_group);
  );
  
  
 ):(
 gfx_x = 8*zoom; gfx_y = 13*zoom;
 rgb(250,25,0);
 gfx_drawstr("BYPASS");
 );
 mouseClick == 1 && shift ? (slider52 == 0 ? slider52 = 1 : slider52 = 0; caller = 1);
 );
 
 
