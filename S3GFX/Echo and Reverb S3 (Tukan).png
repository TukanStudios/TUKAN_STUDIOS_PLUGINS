import S3GFX/tk_lib 256_S3.jsfx-inc
import S3GFX/cookdsp.jsfx-inc
import S3GFX/Luftfenster.jsfx-inc
import S3GFX/Klones.jsfx-inc

options:gmem=TukanReverbDelayS3
options:no_meter

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output


@init
ext_noinit=1;
ext_gr_meter = 0.0;
ext_nodenorm = 1;
gfx_ext_retina = 1;
gfx_clear=0;
gfx_clear=0;
lastCap=1;
mouse_wheel=1;
is_recording = 0; is_playing = 0; is_stopped = 1;
while_playing = 1; while_recording = 1; while_stopped = 1;
Number_input = 0;
number_input_raw = 0;
number_input_use = 0;
komma = 0;
in_key = 0;
number_input_x = 0;
number_input_y=0;
number_input_slider = 0;
number_input_min=0;
number_input_max=0;
number_input_invalid = 0;
number_input_sign=1;



s2_numbers_of_sliders = 54;
s2_numbers_of_generics = 0;
group_generics =10; // memory point fuer group_generics[bis zu 200]
sliders_old = group_generics + 200;
generics_old = sliders_old + 256;

new_memory_inx = generics_old + 210;
Version = 1;
tt_time = -1;





function deline_init (startbuf_ ms_length_) (
this.buf = startbuf_;
this.sams = 192000*ms_length_/1000;
memset(this.buf,0,this.sams);
this.count = 0;

this.buf + this.sams
);

function deline_clear () (
memset(this.buf,0,this.sams);
);

function deline_sliders (startslider_) (
this.ms = slider(startslider_);
this.feedback = db2ratio(slider(startslider_ + 1));
this.tempo = slider(startslider_ + 2);
this.option = slider(startslider_ + 3);
this.select = slider(startslider_ + 4);
this.slide = slider(startslider_ + 5);
);

function deline_feed (input_) (
  this.buf[this.count] = input_ + this.out * this.feedback;
);


function deline_read() (
      /// Ermittle Samples
  this.select == 0 ? this.delay_sams = srate*this.ms/1000 :
  this.select == 1 ? (
  this.delay_sams=( (      (1/(2^this.tempo)) * 240)/this.bpm)*srate;
    this.option == 0 ? this.delay_sams *= (2/3) :
    this.option == 2 ? this.delay_sams *= 1.5;
  );
  pingpong ? this.delay_sams *= 2;
  this.delay_sams = min(this.delay_sams,this.sams);
  
      /// Drift zu Zielsamples
  this.delay_sams_live != this.delay_sams ? (
    this.delay_sams_live == 0 || this.delay_sams_force ? (
      this.delay_sams_live = this.delay_sams;
      this.delay_sams_force = 0;
    ):(
      this.delay_sams_step = (1/(this.slide/1000)) * (this.delay_sams  - this.delay_sams_live) / srate;
      this.delay_sams_live += this.delay_sams_step;
      abs(this.delay_sams_live - this.delay_sams) < 1 ? this.delay_sams_live = this.delay_sams;
    );
  );

  this.readpos = floor(this.count - this.delay_sams_live); this.readpos < 0 ? this.readpos += this.sams;

  this.count += 1; this.count > this.sams ? this.count = 0;

  this.out = this.buf[this.readpos];
  this.out
);

function deline_ITG_read() (
      /// Ermittle Samples
  this.select == 0 ? this.delay_sams = srate*this.ms/1000 :
  this.select == 1 ? (
  this.delay_sams=( (      (1/(2^this.tempo)) * 240)/this.bpm)*srate;
    this.option == 0 ? this.delay_sams *= (2/3) :
    this.option == 2 ? this.delay_sams *= 1.5;
  );
  //pingpong ? this.delay_sams *= 2;
  this.delay_sams = min(this.delay_sams,this.sams);
  
      /// Drift zu Zielsamples
  this.delay_sams_live != this.delay_sams ? (
    this.delay_sams_live == 0 || this.delay_sams_force ? (
      this.delay_sams_live = this.delay_sams;
      this.delay_sams_force = 0;
    ):(
      this.delay_sams_step = (1/(this.slide/1000)) * (this.delay_sams  - this.delay_sams_live) / srate;
      this.delay_sams_live += this.delay_sams_step;
      abs(this.delay_sams_live - this.delay_sams) < 1 ? this.delay_sams_live = this.delay_sams;
    );
  );

  this.readpos = floor(this.count - this.delay_sams_live); this.readpos < 0 ? this.readpos += this.sams;

  this.count += 1; this.count > this.sams ? this.count = 0;

  this.out = this.buf[this.readpos];
  this.out
);






  
  
  
  
  
  
  
  
  


    MAX_FREQ = 44100 / 2.0;
    MIN_FREQ = 20;
    FREQ_LOG_MAX = log(MAX_FREQ / MIN_FREQ);

/*
 * Convert slider % to frequency
 */
function per_to_freq(x, range) (
  MIN_FREQ * exp(FREQ_LOG_MAX * x / range);
);

/*
 * Convert frequency to slider %
 */
function freq_to_per(freq, range) (
  range * log(freq / MIN_FREQ) / FREQ_LOG_MAX;
);



  
  
  
function initialize_everthing () (

memfactor = 4;


freemem = Reverb.initialize_reverb(new_memory_inx);

StereobufL = freemem; freemem += 1100*memfactor;
StereobufR = freemem; freemem += 1100*memfactor;

PreDelayBufL = freemem; freemem += 44100*memfactor;
PreDelayBufR = freemem; freemem += 44100*memfactor;



    __memory_next = freemem;
    // Left ch. allpass filters     Right ch. allpass filters
    a1L.allpass(0.0204, 0.35);      a1R.allpass(0.02011, 0.35);
    a2L.allpass(0.06653, 0.41);     a2R.allpass(0.06641, 0.41);
    a3L.allpass(0.035007, 0.5);     a3R.allpass(0.03504, 0.5);
    a4L.allpass(0.023021, 0.65);    a4R.allpass(0.022987, 0.65);
    lp1L.lop(5000);                 lp1R.lop(5000);
    lp2L.lop(3000);                 lp2R.lop(3000);
    lp3L.lop(1500);                 lp3R.lop(1500);
    lp4L.lop(500);                  lp4R.lop(500);
    
    freemem = __memory_next;
    
rev_buf_length = freemem - rev_buf_start;
    
    freemem = delay_L.deline_init (freemem, 5000);
    freemem = delay_R.deline_init (freemem, 5000);
    freemem = delay_ITGL.deline_init (freemem, 5000);
    freemem = delay_ITGR.deline_init (freemem, 5000);

freemem = Wow.wowflut_init(freemem);
freemem = Flutter.wowflut_init(freemem);
freemem = ITG_Wow.wowflut_init(freemem);
freemem = ITG_Flutter.wowflut_init(freemem);
  Cas_left.TapeHead_reset();
  Cas_right.TapeHead_reset();
  ITG_Cas_left.TapeHead_reset();
  ITG_Cas_right.TapeHead_reset();
  
D_HP_L.buthp(per_to_freq(slider41,100));
D_HP_R.buthp(per_to_freq(slider41,100));
D_LP_L.butlp(per_to_freq(60+slider42,100));
D_LP_R.butlp(per_to_freq(60+slider42,100));

R_HP_L.buthp(per_to_freq(slider5,100));
R_HP_R.buthp(per_to_freq(slider5,100));
R_LP_L.butlp(per_to_freq(60+slider6,100));
R_LP_R.butlp(per_to_freq(60+slider6,100));

freemem = ERS.air_room_init(freemem);

w_a1L.biquad(1130,0.7,4);
w_a1R.biquad(137,0.7,4);
w_a2L.biquad(580,0.7,4);
w_a2R.biquad(1540,0.7,4);
w_a3L.biquad(1680,0.7,4);
w_a3R.biquad(750,0.7,4);
w_a4L.biquad(4130,0.7,4);
w_a4R.biquad(5650,0.7,4);

);
initialize_everthing();


