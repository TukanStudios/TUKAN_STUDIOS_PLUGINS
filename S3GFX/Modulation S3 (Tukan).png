options:no_meter
options:gmem=TukanModulationS3
//options:gfx_idle

@init
Modulation_VERSION = 1.16;



ext_tail_size = -1;
ext_nodenorm = 1;
gfx_ext_retina = 1;
gfx_clear=0;
ext_noinit=1;
gfx_clear=0;
lastCap=1;
mouse_wheel=1;
is_recording = 0; is_playing = 0; is_stopped = 1;
while_playing = 1; while_recording = 1; while_stopped = 1;
Number_input = 0;
number_input_raw = 0;
number_input_use = 0;
komma = 0;
in_key = 0;
number_input_x = 0;
number_input_y=0;
number_input_slider = 0;
number_input_min=0;
number_input_max=0;
number_input_invalid = 0;
number_input_sign=1;


s2_numbers_of_sliders = 63;
s2_numbers_of_generics = 98;

Version = 1;
tt_time = -1;




 
   
   
   
   
   
   function band_set_filter(t, f, g, qval, slope)
    instance (enabled, type, frequency, gain, q, filter, color) (
     type = t; frequency = f; gain = g; q = qval;
     type == 0 ? filter.svf_eq(frequency, q, db_to_gain(gain)) :
       type == 1 ? filter.svf_hp(frequency, q, slope) :
         type == 2 ? filter.svf_hpb(frequency, slope) :
           type == 3 ? filter.svf_ls(frequency, q, db_to_gain(gain)) :
             type == 4 ? filter.svf_hs(frequency, q, db_to_gain(gain)) :
               type == 5 ? filter.svf_lp(frequency, q, slope) :
                 type == 6 ? filter.svf_lpb(frequency, slope) :
                   type == 7 ? filter.svf_bs(frequency, q) :
                     type == 8 ? filter.svf_bp2(frequency, q) :
                       type == 9 ? filter.svf_st(frequency, q, gain) :
                         type == 10 ? filter.svf_pultecls(frequency, q, gain) :
                           type == 11 ? filter.svf_ap(frequency, q) :
                             type == 12 ? filter.svf_analog_lowcut(frequency, q, gain) :
                               type == 13 ? filter.svf_analog_highcut(frequency, q, gain);
   );
   
   function band_init()
     instance (enabled, type, frequency, gain, q, filter, color) ( 
     filter.svf_set_sample_rate(SAMPLE_RATE);
     filter.svf_bypass();
     //color.create_color(0,0,0);
   
     filter.a1 = filter.t_a1;
     filter.a2 = filter.t_a2;
     filter.a3 = filter.t_a3;
   
     filter.m0 = filter.t_m0;
     filter.m1 = filter.t_m1;
     filter.m2 = filter.t_m2;
     filter.iter_t = 1.0;
   );
   
   
   
  MAX_FREQ = 44100 / 2.0;
  MIN_FREQ = 10;
  FREQ_LOG_MAX = log(MAX_FREQ / MIN_FREQ);        
          
  function per_to_freq(x, range) (
    MIN_FREQ * exp(FREQ_LOG_MAX * x / range);
  );
  /*
   * Convert frequency to slider %
   */
  function freq_to_per(freq, range) (
    range * log(freq / MIN_FREQ) / FREQ_LOG_MAX;
  );
  
 
    
//////////////////////////////////////////////////// PHASER CODE ////////////////////////////////////
// Phaser Code: License: LGPL - http://www.gnu.org/licenses/lgpl.html
// Modyfied code from Cockos Phaser
   function phaser_parameters(startslider_) 
   instance (feedback wetmix dmin dmax dsc)
   (
     feedback=2 ^ (slider(startslider_+2)/6);
     wetmix =slider(startslider_+3)/100;
     dmin=(per_to_freq(slider(startslider_),100) * 2) / srate;
     dmax=(per_to_freq(slider(startslider_+1),100) * 2) / srate;
     dsc=abs(dmax-dmin) * 0.5;
     dmin=min(dmin,dmax);
   );
   
   function phaser_do(inL, inR, pointerL_, pointerR_) 
   instance(feedback wetmix dmin dmax dsc d coef xl lx1 lx2 lx3 lx4 ly1 ly2 ly3 ly4 Rx rx1 rx2 rx3 rx4 ry1 ry2 ry3 ry4)
   (
      d = dmin + dsc * (pointerL_ + 1);
      coef=(1-d)/(1+d);
      
      x1=inL + ly4 * feedback;
      ly1 = coef * (ly1 + x1) - lx1;  lx1 = x1;
      ly2 = coef * (ly2 + ly1) - lx2; lx2 = ly1;
      ly3 = coef * (ly3 + ly2) - lx3; lx3 = ly2;
      ly4 = coef * (ly4 + ly3) - lx4; lx4 = ly3;
      this.outL = InL + ly4*wetmix;
      
      d = dmin + dsc * (pointerR_ + 1);
      coef=(1-d)/(1+d);
      
      rx=inR + ry4 * feedback;
      ry1 = coef * (ry1 + rx) - rx1;  rx1 = rx;
      ry2 = coef * (ry2 + ry1) - rx2; rx2 = ry1;
      ry3 = coef * (ry3 + ry2) - rx3; rx3 = ry2;
      ry4 = coef * (ry4 + ry3) - rx4; rx4 = ry3;
      this.outR = inR + ry4*wetmix;
   );
//////////////////////////////////////////////////// END PHASER CODE //////////////////////////////////// 
   
   
   
   
   
   
   
   
//////////////////////////////////////////////////// Flanger frei nach witti :) 

function tanh(x)
(
x = exp(2*x);
(x - 1) / (x + 1);
);


   function flanger_init(startbuf_) (
   this.nullsieben = 1/sqrt(2);
   this.BSZ = 8192;//153600;
   this.BSZ2 = 153600;
   this.buf1 = startbuf_;
   this.buf2 = startbuf_ + this.BSZ2;
   this.buf2 + this.BSZ2
   );
   
   
   function flanger_parameters(_paramWidth, _paramFeedback, _paramDelay, _minus, _mix)
   instance (mix, Sweepsamples, DelaySamples, _mixLeftWet, _mixLeftDry, _mixRightWet, _mixRightDry, _feedbackPhase, Feedback)
   (
    mix = _mix/100;
    Feedback = _paramFeedback;
    SweepSamples = (_paramWidth * srate * 0.0001)|0;
    DelaySamples = (_paramDelay * srate * 0.0001) + 1;
    
    _minus == 0 ? ( //mono sum in
    _mixLeftWet = _mixRightWet = 1;
    _mixLeftDry = _mixRightDry = 1;
    _feedbackPhase = 1;
    );
    _minus == 1 ? ( //stereo l+r in - minus
    _mixLeftWet = _mixRightWet = -1;
    _mixLeftDry = _mixRightDry = 1;
    _feedbackPhase = -1;
    );
   );
   
   function flanger_do(inL, inR, pointerL_, pointerR_) 
   instance (BSZ2 mix Sweepsamples, DelaySamples, _mixLeftWet, _mixLeftDry, _mixRightWet, _mixRightDry, _feedbackPhase, feedback
              inmix1 inmix2 outval1 outval2 _fp BSZ ep ep1 ep2 w1 w2 buf1 buf2  outL outR
   )
   (
        inmix1 = inL + tanh(Feedback * 0.01 * _feedbackPhase * outval1);
        inmix2 = inR + tanh(Feedback * 0.01 * _feedbackPhase * outval2);
        
        buf1[_fp] = inmix1;
        buf2[_fp] = inmix2;
        _fp = (_fp + 1); _fp>BSZ?_fp = 0;
        
        ep = _fp - (DelaySamples + 1) - (SweepSamples*(pointerL_+1)/2);
        (ep < 0) ? (
        ep += BSZ;
        );
        ep1 = ep|0;
        w2 = ep-ep1;
        ep1 &= (BSZ-1);
        ep2 = ep1 + 1;
        ep2 &= (BSZ-1);
        w1 = 1 - w2;
        outval1 = buf1[ep1] * w1 + buf1[ep2] * w2;
        //outval1 = buf1[ep1];//  + buf1[ep2] ;
        
        
        ep = _fp - (DelaySamples + 1) - (SweepSamples*(pointerR_+1)/2);
        (ep < 0) ? (
        ep += BSZ;
        );
        ep1 = ep|0;
        w2 = ep-ep1;
        ep1 &= (BSZ-1);
        ep2 = ep1 + 1;
        ep2 &= (BSZ-1);
        w1 = 1 - w2;
        outval2 = buf2[ep1] * w1 + buf2[ep2] * w2;
        
        
        outL = tanh((1-mix)*_mixLeftDry * inL + _mixLeftWet  * outval1 *mix*this.nullsieben);
        outR = tanh((1-mix)*_mixRightDry * inR + _mixRightWet  * outval2 *mix*this.nullsieben);
   );
   
   
   
   
   
   
   
      /////////////////////////////////////////////////////// FUNCTION CHORUS //////////////////////
      function chorus_do_my(pointerL_, PointerR_) instance (external ch_phase_position_old stages read1_ read3_ pos_ Hertz ch_depth buf1 buf2 ch_delay nr triangle_position triangle_position_2 ch_phase_position ch_phase_position2  outval outval2 er_2 ep_2_1 ep_2_2 w1_2 w2_2 ep ep1 ep2 w1 w2 delaySamples delaySamples_2 _fp width _sweepSamples _maxSweepSamples inval1 inval2 ) (
      
      
      
      ch_phase_position += Hertz / srate;
      ch_phase_position >= 1 ? ch_phase_position -= 1;
      ch_phase_position2 = ch_phase_position - 0.5;
      ch_phase_position2 <= 0 ? ch_phase_position2 += 1;
   
      ch_phase_position <= 0.25 ? triangle_position = ch_phase_position * 4:
      ch_phase_position <= 0.5 ?  triangle_position = 1 - (ch_phase_position-0.25) * 4:
      ch_phase_position <= 0.75 ? triangle_position = (ch_phase_position-0.5) * -4:
      ch_phase_position > 0.75 ?  triangle_position = -1 + (ch_phase_position - 0.75) * 4;
      
      ch_phase_position2 <= 0.25 ? triangle_position_2 = ch_phase_position2 * 4:
      ch_phase_position2 <= 0.5 ?  triangle_position_2 = 1 - (ch_phase_position2-0.25) * 4:
      ch_phase_position2 <= 0.75 ? triangle_position_2 = (ch_phase_position2-0.5) * -4:
      ch_phase_position2 > 0.75 ?  triangle_position_2 = -1 + (ch_phase_position2 - 0.75) * 4;
      
      
      
      this..stages ? nr == 2 ? (
      ch_phase_position_old = ch_phase_position;
      ch_phase_position += 1/3;
      ch_phase_position >= 1 ? ch_phase_position -= 1;
      ch_phase_position2 = ch_phase_position - 0.5;
      ch_phase_position2 <= 0 ? ch_phase_position2 += 1;
      
      ch_phase_position <= 0.25 ? triangle_position = ch_phase_position * 4:
      ch_phase_position <= 0.5 ?  triangle_position = 1 - (ch_phase_position-0.25) * 4:
      ch_phase_position <= 0.75 ? triangle_position = (ch_phase_position-0.5) * -4:
      ch_phase_position > 0.75 ?  triangle_position = -1 + (ch_phase_position - 0.75) * 4;
      
      ch_phase_position2 <= 0.25 ? triangle_position_2 = ch_phase_position2 * 4:
      ch_phase_position2 <= 0.5 ?  triangle_position_2 = 1 - (ch_phase_position2-0.25) * 4:
      ch_phase_position2 <= 0.75 ? triangle_position_2 = (ch_phase_position2-0.5) * -4:
      ch_phase_position2 > 0.75 ?  triangle_position_2 = -1 + (ch_phase_position2 - 0.75) * 4;
      ch_phase_position = ch_phase_position_old;
      );
      
      nr == 1 && this..external ? (triangle_position = pointerL_; triangle_position_2 = pointerR_):
      nr == 2 && this..external ? (triangle_position = -pointerL_; triangle_position_2 = -pointerR_);
      
      
      this..mode  == 0 || this..mode == 2 ? (
       inval1 = inval2 = (spl0+spl1)/2;
      ):(
       inval1 = spl0;
       inval2 = spl1;
      );
      
      
      width = ch_depth * 0.001;
      
      (width == 0) ? (
      _sweepSamples = 0;
      ):(
      _sweepSamples = width * srate|0;
      );
      _maxSweepSamples = _sweepSamples;
      
      this.inmix1 = inval1;
      this.inmix2 = inval2;
      
      delaySamples = (ch_delay * srate * 0.001) + 1;
      delaySamples_2 = (ch_delay * srate * 0.001) + 1;
      
      delaySamples += _sweepSamples * ((triangle_position+1)/2);
      delaySamples_2 += _sweepSamples * ((triangle_position_2+1)/2);
      
      
      read1_ = this.d1.delay_fsread2(delaySamples/srate);
      read3_ = this.d3.delay_fsread2(delaySamples_2/srate);
      
      
      
      this.d1.delay_write(inval1);//spl0);
      this.d3.delay_write(inval2);//spl1);
      
      
      outval = read1_;
      outval2 = read3_;
      );
      
      
      
      function S3_Chorus_do(pointerL_, pointerR_) 
      instance (filter_on stages ch2_on jun_chorus drymix wetmix outgain jun_chorus_old mode Chorus_L Chorus_R)
      (
      this.CH1.chorus_do_my(pointerL_, pointerR_);
      ch2_on ? this.CH2.chorus_do_my(pointerL_, pointerR_);
      
      mode == 2 ? (
      this.CH1.outval2 = this.ch1.outval;
      this.CH2.outval2 = this.ch2.outval;
      );
      
      jun_chorus == 0 ? (this.CH1.outval = this.CH1.outval2 = this.CH2.outval = this.CH2.outval2 = 0);
      ch2_on ? (
        Filter_on ? (
            Chorus_L = this.Chorus_LPF.filter.svf_svf0(this.CH1.outval * this.CH1.ch_mix * wetmix + this.CH2.outval * this.CH2.ch_mix * wetmix);
            Chorus_L = this.Chorus_HPF.filter.svf_svf0(Chorus_L);
            Chorus_R = this.Chorus_LPF.filter.svf_svf1(this.CH1.outval2 * this.CH1.ch_mix * wetmix  + this.CH2.outval2 * this.CH2.ch_mix * wetmix);
            Chorus_R = this.Chorus_HPF.filter.svf_svf1(Chorus_R);
        ):(
            Chorus_L = this.CH1.outval * this.CH1.ch_mix * wetmix + this.CH2.outval * this.CH2.ch_mix * wetmix;
            Chorus_R = this.CH1.outval2 * this.CH1.ch_mix * wetmix  + this.CH2.outval2 * this.CH2.ch_mix * wetmix;
        );
        spl0 = spl0*drymix + chorus_L;
        spl1 = spl1*drymix + Chorus_R;
      ):(
        Filter_on ? (
            Chorus_L = this.Chorus_LPF.filter.svf_svf0(this.CH1.outval * this.CH1.ch_mix * wetmix);
            Chorus_L = this.Chorus_HPF.filter.svf_svf0(Chorus_L);
            Chorus_R = this.Chorus_LPF.filter.svf_svf1(this.CH1.outval2 * this.CH1.ch_mix * wetmix);
            Chorus_R = this.Chorus_HPF.filter.svf_svf1(Chorus_R);
        ):(
            Chorus_L = this.CH1.outval * this.CH1.ch_mix * wetmix;
            Chorus_R = this.CH1.outval2 * this.CH1.ch_mix * wetmix;
        );
        spl0 = spl0*drymix + chorus_L;
        spl1 = spl1*drymix + Chorus_R;
      );
      
      spl0 *= outgain;
      spl1 *= outgain;
      );
      /////////////////////////////////////////////////////// ENDE FUNCTION CHORUS //////////////////////
      
      
      
      
   
   
   function S3_Chorus_init (bufstart_) (
   __memory_index=bufstart_; //alloc start
   this.ch1.chorus(0,0,0); //275000
   this.ch2.chorus(0,0,0);
   this.chorus_LPF.band_init();
   this.chorus_HPF.band_init();
   bufstart_ + 3000000; //RETURN VALUE
   );
   
   
   
   
   
   
   
   function S3_chorus_parameters_update (stages_ jun_chorus_ mode_ mix_ gain_ depth_ delay_ Hertz_ Filter_) 
   instance (Filter_on external stages ch2_on jun_chorus drymix wetmix outgain jun_chorus_old mode)
   (
   
   Filter_on = Filter_;
   stages = stages_;
   ch2_on = stages;
   this.CH1.nr = 1;
   this.CH2.nr = 2;
   
      jun_chorus_ != jun_chorus_old ? (
      jun_chorus_old = jun_chorus_;
       jun_chorus = jun_chorus_;
       
       jun_chorus == 1 ? (
       this.CH1.ch_depth = 3.69;
       this.CH1.ch_delay = 1.66;
       this.CH1.ch_mix = 0.8;
       this.CH1.Hertz = 0.513;
       this.CH2.ch_depth = 3.69;
       this.CH2.ch_delay = 1.66;
       this.CH2.ch_mix = 0.8;
       this.CH2.Hertz = 0.513;
       );
       
       jun_chorus == 2 ? (
       this.CH1.ch_depth = 3.69;
       this.CH1.ch_delay = 1.66;
       this.CH1.ch_mix = 0.8;
       this.CH1.Hertz = 0.863;
       this.CH2.ch_depth = 3.69;
       this.CH2.ch_delay = 1.66;
       this.CH2.ch_mix = 0.8;
       this.CH2.hertz = 0.863;
       );
       
       jun_chorus == 3 ? (
       this.CH1.ch_depth = 0.4;
       this.CH1.ch_delay = 0.33;
       this.CH1.ch_mix = 1;
       this.CH1.Hertz = 9.75;
       this.CH2.ch_depth = 0.4;
       this.CH2.ch_delay = 0.33;
       this.CH2.ch_mix = 1;
       this.CH2.Hertz = 9.75;
       );
       
      
      );
   
       jun_chorus > 3 ? (
       this.CH1.ch_depth = depth_;
       this.CH1.ch_delay = delay_;
       this.CH1.ch_mix = 1;
       this.CH1.Hertz = Hertz_;
       this.CH2.ch_depth = depth_;
       this.CH2.ch_delay = delay_;
       this.CH2.ch_mix = 1;
       this.CH2.Hertz = Hertz_;
       );
       
   external = jun_chorus == 5 ? 1 : 0;
   
   mode = mode_;
   
   drymix = mix_ <= 50 ? 1 : 1-((mix_-50)/50);
   wetmix = mix_ >= 50 ? 1 : 1-(-(mix_-50)/50);
   
   outgain = db2ratio(gain_);
   
   
   
      this.chorus_LPF.band_set_filter(5, per_to_freq(87.5,100), 0, 0.52, 7);
      this.chorus_HPF.band_set_filter(1, per_to_freq(21.15,100), 0, .72, 2);
      this.Chorus_lpf.filter.svf_set_to_target();
      this.chorus_hpf.filter.svf_set_to_target();
      
      
   );
                     
                     
   
                     
                     
                     
                     
                     
                     
                     
                     
                     
                     
                     
                     function rc_set(rc)
                       instance(a) (
                         a = 1 / (rc * srate + 1);
                     );
                     function rc_lp(sample)
                       instance(lp, a) (
                         lp += a * (sample - lp);
                     );
                     function smooth()
                       instance (lp, smooth) (
                         lp = smooth;
                         smooth = this.rc_lp(this);
                     );
                     
                     
   function Filter_Init() (
        lfilter_mode = filter_mode;
        lmorph = morph;
        
        log10d20_conversion  = .11512925464970228420089957273422;
        
        
        filter_mode=0;
        cutoff.rc_set(0.0033);
        cutoff.smooth = cutoff;
        resonance.rc_set(0.0033);
        resonance.smooth = resonance;
        drive.rc_set(0.0033);
        drive.smooth = drive;
        boost.rc_set(0.0033);
        boost.smooth = boost;
   );
                     
    
   function filter_do (PointerL_, PointerR_)  local (fin_reso)
   instance (FilterType Low High Resonance Mode Outgain Mix)
   ( //Moorph: 0 = LP, 0.25 = BP, 0.5 HP, 0.75: BR, 1 LP
      this.cutoffL = Low + (high-low) * (PointerL_+1)/2;
      this.cutoffR = Low + (high-low) * (PointerR_+1)/2;
      filtertype == 15 ? fin_reso = resonance *0.501:
      filtertype == 0 ? fin_reso = resonance*0.98:
      fin_reso = resonance*0.94;
      this.L.skf.init_filter(filtertype, this.cutoffL, this.cutoffL, mode, mode, fin_reso);
      this.R.skf.init_filter(filtertype, this.cutoffR, this.cutoffR, mode, mode, fin_reso);
      ssl = spl0;// * preamp;
      ssr = 0;// * preamp;
      this.L.skf.processSample(filtertype);
      spl0 = (1-mix)*spl0 + max(-1,min(1,mix*ssl*OutGain));
      ssl = 0;// * preamp;
      ssr = spl1;// * preamp;
      this.R.skf.processSample(filtertype);
      spl1 = (1-mix)*spl1 + max(-1,min(1,mix*ssr*OutGain));
   );
    
  function filter_parameters (Type_ Low_ High_ Reso_ Mode_ Outgain_ Mix_) 
  instance (FilterType Low High Resonance Mode Outgain Mix)
  (
    Type_ == 0 ? FilterType = 0 :
    Type_ == 1 ? FilterType = 2 :
    Type_ == 2 ? FilterType = 3 :
    Type_ == 3 ? FilterType = 4 :
    Type_ == 4 ? FilterType = 5 :
    Type_ == 5 ? FilterType = 1 :
    Type_ == 6 ? FilterType = 6 :
    Type_ == 7 ? FilterType = 15 :
    Type_ == 8 ? FilterType = 16 ;
    Low = low_ / 100;
    High = High_ / 100;
    Resonance = Reso_ / 100;
    Mode = Mode_ == 0 ? 0 : Mode_ == 1 ? 0.25 : 0.5;
    Outgain = db2ratio(Outgain_);
    Mix = Mix_ / 100;
    
    ///////////////////////// SKF      //////////////////
    oversampling = _oversampling + 1;
    sampling_ratio = 44100 / srate;
    sampling_factor = oversampling / sampling_ratio;
    isampling_factor = 1 / sampling_factor;
    israte = 1.0 / srate;
    israte_radian = 2.0*$pi*israte;
    current_safety_moog = (1.0 - log(safety_limit_moog * oversampling) / log(20/22050));
    
    // change morph based on filter_mode
    lfilter_mode != filter_mode ? (
      morph = filter_mode / 4;
      lmorph = morph;
      lfilter_mode = filter_mode;
    );
    
    // change filter_mode based on morph
    lmorph != morph ? (
      filter_mode = floor(morph * 4);
      lfilter_mode = filter_mode;
      lmorph = morph;
    );
  );
                    
  
  
                    
   
   function explog (input, factor) (
   input^factor; // 1=linear, < 1 = log (schnell rein), > 1 = exp (langsam rein)
   );
   
   
   
   function Rotor_init(memory_point) 
   instance (twopi chp dchp clp dclp shp dshp slp dslp lspd hspd lphi hphi ifs dchp dclp dshpk k k1 k0 BSZ buf1 buf2 buf3 _feedbackPhase _sweepSamples _sweep
   outval1 outval2 flb_MAX_WG_DELAY flb_i flb_counter flb_buffer0 flb_buffer1 flb_feedback flb_delay flb_tdelay0 flb_tdelay1 flb_rate flb_mix
   fftsize need_refft convscr lslider1 impbuf convsrc
   )
   (
   
   //memory_aa = memory_point;
   /*
   Leslie_filter_type = 5;
   Leslie_Filter_Slope = 3;
   Leslie_Filter_Q = 0.707;
   Leslie_filter_gain = 0;
   */
   
   twopi = 6.2831853;
   
   chp = dchp = clp = dclp = shp = dshp = slp = dslp = 0;
   
   lspd = 0;
   hspd = 0;
   lphi = 0;
   hphi = 1.6;
   
   ifs = 1 / srate;
   
   dchp=0;
   dclp=0;
   dshp=0;
   
   k1 = 32;
   k0 = 0.03125; // 1/k1
   k = 0;
   
   this.crossover_low.band_init();
   this.crossover_high.band_init();
   this.L_Horn.band_init();
   this.R_Horn.band_init();
   this.Drum.band_init();
   
   
      fftsize=-1;
      need_refft=1;
      convsrc=128*1024;
      lslider1=-1;
      impbuf= 256*1024;//256*1024; //IR BUF
       
       memory_point += 1000000;
       
      BSZ = 16*8192*2;//0.2*srate; // ~0.2*srate
      buf1 = memory_point;//BSZ + memory_point;
      buf2 = BSZ + memory_point; //vorher 2*
      buf3 = 2*BSZ + memory_point; //vorher 3*
      memset(buf1,0,BSZ);
      memset(buf2,0,BSZ);
      memset(buf3,0,BSZ);
      
      _feedbackPhase = 1;
      _sweepSamples = 0; // sweep width in # of samples
      _sweep = 0; // current value of sweep in steps behind fill pointer
      
      outval1 = outval2 = 0; // most recent output value (for feedback)
      
      memory_point = buf3 + BSZ + 10;
      
      flb_MAX_WG_DELAY = 16384;
      flb_i = 0;
      flb_counter = 0;
      flb_buffer0 = memory_point + 2048;
      flb_buffer1 = flb_buffer0 + flb_MAX_WG_DELAY;
      memset(flb_buffer0,0,flb_MAX_WG_DELAY);
      memset(flb_buffer1,0,flb_MAX_WG_DELAY);
      flb_feedback = 0;
      flb_delay = 5 ;
      flb_tdelay0 = flb_delay;
      flb_tdelay1 = flb_delay;
      flb_rate = 0;
      flb_mix = 0;
      
      //memory_point += 
      
      flb_buffer1 + flb_MAX_WG_DELAY + 10; // new Memory point
      
   );  
   
   //memory_point = 1000000;
   
   
   
      
      function flange_horn () 
      instance (twopi chp dchp clp dclp shp dshp slp dslp lspd hspd lphi hphi ifs dchp dclp dshpk k k1 k0 BSZ buf1 buf2 buf3 _feedbackPhase _sweepSamples _sweep
      outval1 outval2 flb_MAX_WG_DELAY flb_i flb_counter flb_buffer0 flb_buffer1 flb_feedback flb_delay flb_tdelay0 flb_tdelay1 flb_rate flb_mix
      fparam0 fparam1 fparam2 fparam3 fparam4 fparam5 fparam6 fparam7 fparam8 fparam9 lo_level hi_level mic_angle mic_angle_rad spd
      lset hset lmom hmom fparam0_old drive_gain drive_gain_comop drive_tube x_over flb_offset flb_sdelay0 flb_sdelay1
      wet0 wet1 tube
      hl hm hw hd ll lm lw hlev hmem hwid hdep llev lmom lwid ht lt a org_speed drum_pos drum_pos_ch h horn_L_pos horn_L_pos_ch horn_L_pos_trem
      horn_R_pos horn_R_pos_ch horn_R_pos_trem hphi2 l lphi2
      ch_delay ch_depth ch_depth_drum ch_mix delaySamples delaySamples_2 delaySamples_3 drum_level ep ep1 ep2 ep_2 ep_2_1 ep_2_2 inmix1 inval1
      flb_output0 flb_output1 outval trem_speed_adj w1 w1_2 w2 w2_2 width width_drum _fp _maxSweepSamples _maxSweepSamples_drum _sweepSamples_drum
      flb_back0 flb_back1 flb_c00 flb_c01 flb_c10 flb_c11 flb_c20 flb_c21 flb_c30 flb_c31 flb_x0 flb_x1 flb_depth flb_index00 flb_index01
      flb_index10 flb_index11 flb_index20 flb_index21 flb_index_10 flb_index_11
      flb_y00 flb_y01 flb_y10 flb_y11 flb_y20 flb_y21 flb_y_10 flb_y_11
      )
      (
      //flb_depth = (flb_delay - 0.1) * ch_depth/40;
      flb_depth = ch_depth/10;
      
         flb_back0 = flb_counter - flb_sdelay0;
         flb_back1 = flb_counter - flb_sdelay1;
         (flb_back0 < 0) ? flb_back0 = flb_MAX_WG_DELAY + flb_back0;
         (flb_back1 < 0) ? flb_back1 = flb_MAX_WG_DELAY + flb_back1;
         flb_index00 = flb_back0 | 0;
         flb_index01 = flb_back1 | 0;
         flb_index_10 = flb_index00 - 1;
         flb_index_11 = flb_index01 - 1;
         flb_index10 = flb_index00 + 1;
         flb_index11 = flb_index01 + 1;
         flb_index20 = flb_index00 + 2;
         flb_index21 = flb_index01 + 2;
         (flb_index_10 < 0) ? flb_index_10 = flb_MAX_WG_DELAY + 1;
         (flb_index_11 < 0) ? flb_index_11 = flb_MAX_WG_DELAY + 1;
         (flb_index10 >= flb_MAX_WG_DELAY) ? flb_index10 = 0;
         (flb_index11 >= flb_MAX_WG_DELAY) ? flb_index11 = 0;
         (flb_index20 >= flb_MAX_WG_DELAY) ? flb_index20 = 0;
         (flb_index21 >= flb_MAX_WG_DELAY) ? flb_index21 = 0;
         flb_y_10 = flb_buffer0[flb_index_10];
         flb_y_11 = flb_buffer1[flb_index_11];
         flb_y00 = flb_buffer0[flb_index00];
         flb_y01 = flb_buffer1[flb_index01];
         flb_y10 = flb_buffer0[flb_index10];
         flb_y11 = flb_buffer1[flb_index11];
         flb_y20 = flb_buffer0[flb_index20];
         flb_y21 = flb_buffer1[flb_index21];
         flb_x0 = flb_back0 - flb_index00;
         flb_x1 = flb_back1 - flb_index01;
         flb_c00 = flb_y00;
         flb_c01 = flb_y01;
         flb_c10 = 0.5 * (flb_y10 - flb_y_10);
         flb_c11 = 0.5 * (flb_y11 - flb_y_11);
         flb_c20 = flb_y_10 - 2.5 * flb_y00 + 2.0 * flb_y10 - 0.5 * flb_y20;
         flb_c21 = flb_y_11 - 2.5 * flb_y01 + 2.0 * flb_y11 - 0.5 * flb_y21;
         flb_c30 = 0.5 * (flb_y20 - flb_y_10) + 1.5 * (flb_y00 - flb_y10);
         flb_c31 = 0.5 * (flb_y21 - flb_y_11) + 1.5 * (flb_y01 - flb_y11);
         flb_output0 = ((flb_c30 * flb_x0 + flb_c20) * flb_x0 + flb_c10) * flb_x0 + flb_c00;
         flb_output1 = ((flb_c31 * flb_x1 + flb_c21) * flb_x1 + flb_c11) * flb_x1 + flb_c01;
         flb_buffer0[flb_counter] = h + flb_output0 * flb_feedback;
         flb_buffer1[flb_counter] = h + flb_output1 * flb_feedback;
         //spl0 = spl0 * (1-flb_mix) + flb_output0 * flb_mix;
         //spl1 = spl1 * (1-flb_mix) + flb_output1 * flb_mix;
         flb_counter += 1;
         (flb_counter >= flb_MAX_WG_DELAY) ? flb_counter = 0;
         
              //flb_rate = hspd*100000;
              //flb_trate = 4 * flb_depth / (srate / (flb_rate));//flb_rate); // flb_rate = speed in hz
              
              /*
              flb_dir0 ? flb_tdelay0 += flb_trate : flb_tdelay0 -= flb_trate;
              flb_dir1 ? flb_tdelay1 += flb_trate : flb_tdelay1 -= flb_trate;
              (flb_tdelay0 >= flb_delay + flb_depth) ? flb_dir0 = 0;
              (flb_tdelay1 >= flb_delay + flb_depth) ? flb_dir1 = 0;
              (flb_tdelay0 <= flb_delay - flb_depth) ? flb_dir0 = 1;
              (flb_tdelay1 <= flb_delay - flb_depth) ? flb_dir1 = 1;
              */
              
              flb_tdelay0 = flb_delay + (flb_delay-0.1) * horn_L_pos_trem*flb_depth; //sin(flb_tpos);
              flb_tdelay1 = flb_delay + (flb_delay-0.1) * horn_R_pos_trem*flb_depth;//sin(flb_tpos+oflb_ffset);
              //flb_tpos += flb_trate;
              //(flb_tpos > twopi) ? flb_tpos = 0;
              
              
              flb_sdelay0 = flb_tdelay0 / 1000 * srate;
              flb_sdelay1 = flb_tdelay1 / 1000 * srate;
              
      );
      
      
      
      
      /////////////////////////////////////////////////////// FUNCTION CHORUS //////////////////////
      function chorus_do() 
      instance (twopi chp dchp clp dclp shp dshp slp dslp lspd hspd lphi hphi ifs dchp dclp dshpk k k1 k0 BSZ buf1 buf2 buf3 _feedbackPhase _sweepSamples _sweep
      outval1 outval2 flb_MAX_WG_DELAY flb_i flb_counter flb_buffer0 flb_buffer1 flb_feedback flb_delay flb_tdelay0 flb_tdelay1 flb_rate flb_mix
      fparam0 fparam1 fparam2 fparam3 fparam4 fparam5 fparam6 fparam7 fparam8 fparam9 lo_level hi_level mic_angle mic_angle_rad spd
      lset hset lmom hmom fparam0_old drive_gain drive_gain_comop drive_tube x_over flb_offset flb_sdelay0 flb_sdelay1
      wet0 wet1 tube
      hl hm hw hd ll lm lw hlev hmem hwid hdep llev lmom lwid ht lt a org_speed drum_pos drum_pos_ch h horn_L_pos horn_L_pos_ch horn_L_pos_trem
      horn_R_pos horn_R_pos_ch horn_R_pos_trem hphi2 l lphi2
      ch_delay ch_depth ch_depth_drum ch_mix delaySamples delaySamples_2 delaySamples_3 drum_level ep ep1 ep2 ep_2 ep_2_1 ep_2_2 inmix1 inval1
      flb_output0 flb_output1 outval trem_speed_adj w1 w1_2 w2 w2_2 width width_drum _fp _maxSweepSamples _maxSweepSamples_drum _sweepSamples_drum
      flb_back0 flb_back1 flb_c00 flb_c01 flb_c10 flb_c11 flb_c20 flb_c21 flb_c30 flb_c31 flb_x0 flb_x1 flb_depth flb_index00 flb_index01
      flb_index10 flb_index11 flb_index20 flb_index21 flb_index_10 flb_index_11
      flb_y00 flb_y01 flb_y10 flb_y11 flb_y20 flb_y21 flb_y_10 flb_y_11
      )
      (
      
      ch_depth = 2 + hspd*200000 *0.01*4; // 0.04 war mal der slider ... separat für horn und ©©
      ch_depth_drum = 1 + lspd*200000 *0.04*4;
      ch_delay = 20;
      ch_mix = 1;
      
      width = ch_depth * 0.0001;
      
      (width == 0) ? (
      _sweepSamples = 0;
      ):(
      _sweepSamples = width * srate|0;
      );
      _maxSweepSamples = _sweepSamples;
      
      width_drum = ch_depth_drum * 0.0001;
      
      (width_drum == 0) ? (
      _sweepSamples_drum = 0;
      ):(
      _sweepSamples_drum = width_drum * srate|0;
      );
      _maxSweepSamples_drum = _sweepSamples_drum;
      
      
      inval1 = h;
   
      inmix1 = inval1;
   
      buf1[_fp] = inmix1;
      
      _fp = (_fp + 1) % (BSZ-1);
    
      delaySamples = delaySamples_2 = delaySamples_3 = (ch_delay * srate * 0.0001) + 1;
   
      delaySamples += _sweepSamples * (horn_L_pos_CH);
      delaySamples_2 += _sweepSamples * (horn_R_pos_ch);
   
      ep = _fp - delaySamples;
      (ep < 0) ? (
      ep += BSZ;
      );
      
      ep1 = ep|0;
      w2 = ep-ep1;
      
      ep1 &= (BSZ-1);
      ep2 = ep1 + 1;
      ep2 &= (BSZ-1);
      w1 = 1 - w2;
      outval = buf1[ep1] * w1 + buf1[ep2] * w2;
      
      
      ep_2 = _fp - delaySamples_2;
      (ep_2 < 0) ? (
      ep_2 += BSZ;
      );
      
      ep_2_1 = ep_2|0;
      w2_2 = ep_2-ep_2_1;
      
      ep_2_1 &= (BSZ-1);
      ep_2_2 = ep_2_1 + 1;
      ep_2_2 &= (BSZ-1);
      w1_2 = 1 - w2_2;
      outval2 = buf1[ep_2_1] * w1_2 + buf1[ep_2_2] * w2_2;
    
    
      trem_speed_adj = hspd *10000;
   
      drum_level = 1-fparam2 + fparam2*(((cos(lphi)+1)/2)^2) + fparam2*(((-cos(lphi)+1)/2.5))^3;//fparam2;
   
      this.flange_horn(); 
   
      //spl0 = l*drum_level + trem_speed_adj*flb_output0 + (1-fparam5 + fparam5*horn_L_pos_trem^2)*outval;//outval;// + fparam5*1*wall_outval * (wall_volume*1);//(wall_horn_L_pos_trem)); //(cos(hphi + mic_angle_rad/2)+1)/2);
      //spl1 = l*drum_level + trem_speed_adj*flb_output1 + (1-fparam5 + fparam5*horn_R_pos_trem^2)*outval2;//outval2;// + fparam5*1*wall_outval2 * (wall_volume*1);//*(wall_horn_R_pos_trem)); //(cos(hphi - mic_angle_rad/2)+1)/2);
      
      outval  *= horn_L_pos_trem^2;
      outval2 *= horn_R_pos_trem^2;
      
      spl0 = l*drum_level + trem_speed_adj*flb_output0 + (0.7+0.3*(fparam5)) * outval + (0.7*(1-fparam5)) * outval2;
      spl1 = l*drum_level + trem_speed_adj*flb_output0 + (0.7+0.3*(fparam5)) * outval2 + (0.7*(1-fparam5)) * outval;
      
      );
      /////////////////////////////////////////////////////// ENDE FUNCTION CHORUS //////////////////////
      
      
      
      function reload_IR() 
      instance (org_speed twopi chp dchp clp dclp shp dshp slp dslp lspd hspd lphi hphi ifs dchp dclp dshpk k k1 k0 BSZ buf1 buf2 buf3 _feedbackPhase _sweepSamples _sweep
      outval1 outval2 flb_MAX_WG_DELAY flb_i flb_counter flb_buffer0 flb_buffer1 flb_feedback flb_delay flb_tdelay0 flb_tdelay1 flb_rate flb_mix
      fparam0 fparam1 fparam2 fparam3 fparam4 fparam5 fparam6 fparam7 fparam8 fparam9 lo_level hi_level mic_angle mic_angle_rad spd
      lset hset lmom hmom fparam0_old drive_gain drive_gain_comop drive_tube x_over flb_offset flb_sdelay0 flb_sdelay1
      wet0 wet1 tube
      hl hm hw hd ll lm lw hlev hmem hwid hdep llev lmom lwid ht lt a org_speed drum_pos drum_pos_ch h horn_L_pos horn_L_pos_ch horn_L_pos_trem
      horn_R_pos horn_R_pos_ch horn_R_pos_trem hphi2 l lphi2
      gfx_mic gfx_open dings tmp lslider1 filehandle impbuf impbuf_l impbuf_nch impbuf_srate need_refft reload_IR filha stereo_mode useresample preamp 
      ir_fade ir_fade_dur filtersize bpos chunksize t lastblock curblock fftsize bp2
      chunksize2 convsrc fileha i i2 invfsize ipart ipos ir_fade isc pre_sum post_sum
      )
      (
      
      need_refft ? (  // prepare convolution source, here...
        useresample && srate > impbuf_srate && impbuf_srate > 1 ? 
        (
          filtersize = ((srate*impbuf_l)/impbuf_srate)|0;
          filtersize > 16384 ? (
            filtersize = 16384;
            impbuf_l = ((filtersize * impbuf_srate) / srate)|0;
          );
          isc=impbuf_srate/srate;
        )
        : 
        (
          impbuf_l > 16384 ? impbuf_l = 16384;
          filtersize=impbuf_l;
          isc=1.0;
        );
      
        fftsize=32;
      
        while(
          filtersize > fftsize*0.5 ? 
          (
            fftsize += fftsize;
          ) : 0;
        );
      
        chunksize=fftsize-filtersize-1; // size of chunk size of audio to use
        chunksize2=chunksize*2;
        bpos=0; 
        curblock=0;
        lastblock=64*1024;
        invfsize=1/fftsize;
        pre_sum = post_sum = i = 0;
        loop(impbuf_l,
          pre_sum += impbuf[i];
          stereo_mode == 0 ? pre_sum += impbuf[i + impbuf_nch - 1];
          i+=impbuf_nch;
        );
        i=0;
        i2=0;
        loop(min(fftsize,filtersize),
           ipos=i|0;
           ipart=(i-ipos);
           convsrc[i2]=impbuf[ipos*impbuf_nch]*(1-ipart) + impbuf[(ipos+1)*impbuf_nch]*ipart;
           convsrc[i2+1]=stereo_mode ? 0.0 : (impbuf[(ipos+1)*impbuf_nch-1]*(1-ipart) +
                                              impbuf[(ipos+2)*impbuf_nch-1]*(ipart));
           post_sum += convsrc[i2] + convsrc[i2+1];
           i += isc;
           i2+=2;
        );
        loop(fftsize-filtersize,
           convsrc[i2]=convsrc[i2+1]=0;
           i2+=2;
        );
        isc != 1 && useresample>=2 && abs(post_sum) > 0.0001*fftsize*(stereo_mode?1:2) &&
            abs(pre_sum) > 0.0001*impbuf_l*(stereo_mode?1:2) ? (
          invfsize *= abs(pre_sum / post_sum);
        );
        fft(convsrc,fftsize);
        i=0;
        loop(fftsize*2, convsrc[i] *= invfsize; i+=1; );
        need_refft=0;
      );
      
      );
      ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
      ///////////////////////////////////////////////////////////////// ENDE LESLIE STUFF //////////////////////////////////////////////////////////////////////////////////
      
      
      
      
      
      
      
      
   
   function rotor_parameters_update(speed_mode_ Lo_level_ high_level_ Horn_stereo_ mic_angle_ x_over_ Mic_ open_ drive_ drum_slow_ drum_fast_ horn_slow_ horn_fast_) 
   instance (org_speed twopi chp dchp clp dclp shp dshp slp dslp lspd hspd lphi hphi ifs dchp dclp dshpk k k1 k0 BSZ buf1 buf2 buf3 _feedbackPhase _sweepSamples _sweep
   outval1 outval2 flb_MAX_WG_DELAY flb_i flb_counter flb_buffer0 flb_buffer1 flb_feedback flb_delay flb_tdelay0 flb_tdelay1 flb_rate flb_mix
   fparam0 fparam1 fparam2 fparam3 fparam4 fparam5 fparam6 fparam7 fparam8 fparam9 lo_level hi_level mic_angle mic_angle_rad spd
   lset hset lmom hmom fparam0_old drive_gain drive_gain_comop drive_tube x_over flb_offset flb_sdelay0 flb_sdelay1
   ch_delay ch_depth ch_depth_drum ch_mix delaySamples delaySamples_2 delaySamples_3 drum_level ep ep1 ep2 ep_2 ep_2_1 ep_2_2 inmix1 inval1
   flb_output0 flb_output1
   gfx_mic gfx_open dings tmp lslider1 filehandle impbuf impbuf_l impbuf_nch impbuf_srate need_refft reload_IR filha stereo_mode useresample preamp      
   chunksize2 convsrc fileha i i2 invfsize ipart ipos ir_fade isc
   )
   (
   
      
      fparam0 = speed_mode_; // speed mode: stop,slow,fast
      fparam1 = 0.1;//slider149; // lo width
      fparam2 = 0.5;//slider150; // lo level
      fparam3 = 0.7;//slider151; // hi width
      fparam4 = 0.1;//slider152; // hi depth
      fparam5 = Horn_stereo_; // hi level
      fparam6 = x_over_ * 10; // x-over
      fparam7 = 1; // output
      fparam8 = 0.6;//slider156; // speed
      fparam9 = 1; // program
      
      lo_level = Lo_level_/10;
      hi_level = high_level_/5;
      
      mic_angle = mic_angle_;
      mic_angle_rad = (mic_angle / 180) * $pi;
       
      spd = twopi * ifs * 2 * fparam8 * 0.1;
   
      (fparam0<=1) ?
      (
      (fparam0<0.1) ? //stop
      (
      lset = 0; hset = 0;
      //lmom = 0.12; hmom = 0.1;
      lmom = 0.02; hmom = 0.01;
      //lmom = slider165/10; hmom = slider167/10;
      )
      : //low speed
      (
      //lset = 1.49; hset = 1.66;
      lset = drum_slow_; hset = horn_slow_;
      //lmom = 0.27; hmom = 0.18;
      
      );
      )
      : //high speed
      (
      //lset = 2.31; hset = 3.4;
      lset = drum_fast_; hset = horn_fast_;
      //lmom = 0.14; hmom = 0.09;
      
      );
      
      /*
      fparam0 > fparam0_old ? (
      lmom = 0.3-slider37/10; hmom = 0.3-slider39/10;
      ):(
      lmom = 0.3-slider36/10; hmom = 0.3-slider38/10;
      );
      fparam0_old = fparam0;
      */
      
      fparam0 > fparam0_old ? (
      lmom = 0.3-2/10; hmom = 0.3-2.5/10;
      ):(
      lmom = 0.3-2/10; hmom = 0.3-2/10;
      );
      fparam0_old = fparam0;
      
      
      hmom = pow(10, -ifs / hmom);
      lmom = pow(10, -ifs / lmom); 
      hset *= spd;
      lset *= spd;
      
   
              
         gfx_mic = dings = Mic_+1;
         gfx_open = open_;
         open_ == 1 ? dings += 5;
         ///////////////////// IR
         
         tmp=dings|0;
         tmp != lslider1 ?
         (
           lslider1=tmp;
         
           filehandle=file_open(dings);
           impbuf_l=impbuf_nch=impbuf_srate=0;
           filehandle > 0 ? 
           (
           need_refft = 1;
           reload_IR = 1; ir_fade = 0;
             fileha = 100;
             katze = 123;
             file_riff(filehandle,impbuf_nch,impbuf_srate);
             impbuf_nch ?
             (
               impbuf_l=(file_avail(filehandle)/impbuf_nch)|0; 
               need_refft=1; 
               file_mem(filehandle,impbuf,impbuf_l*impbuf_nch);
             );
             file_close(filehandle);
           ) : lslider1 = -1;
         );
         !stereo_mode != !0 ? ( need_refft=1; stereo_mode=0; );
          
         useresample != 1 ? (useresample=1; need_refft=1; );
         preamp=0.2;
         ////////////////////////////////
         
        
         
         drive_gain = db2ratio(-25 + drive_ * 6);
         drive_gain_comop = db2ratio(10  -drive_*6);
         drive_tube = 1.57;
         
         
   
         //last_speed == 0 ? last_speed = 1;
         //slider28 ? (last_speed = slider28); 
         org_speed = speed_mode_;
         
         
         x_over != fparam6 ? (
         x_over = fparam6;
         this.crossover_low.band_set_filter(5, per_to_freq(x_over,100), 0, .707, 1); //type, freq, gain, q, slope
         this.crossover_high.band_set_filter(1, per_to_freq(x_over,100), 0, .707, 2); //type, freq, gain, q, slope
         );
         
         
         
         flb_offset != mic_angle/36 ? (
         flb_offset = mic_angle/36; // (0-5)
         flb_tdelay0 = 4; // delay = slider1 (5-10);
         flb_tdelay1 = (flb_tdelay0 + flb_offset); // Offset 0 - 5
         flb_sdelay0 = flb_tdelay0 / 1000 * srate;
         flb_sdelay1 = flb_tdelay1 / 1000 * srate;
         flb_feedback = 0.0;// slider3;
         );
         
         
         
   
     
   );
   
   
   
   
   
   
   function rotor_do(ext_, pointer_L_, pointer_R_) 
   instance (org_speed twopi chp dchp clp dclp shp dshp slp dslp lspd hspd lphi hphi ifs dchp dclp dshpk k k1 k0 BSZ buf1 buf2 buf3 _feedbackPhase _sweepSamples _sweep
   outval1 outval2 flb_MAX_WG_DELAY flb_i flb_counter flb_buffer0 flb_buffer1 flb_feedback flb_delay flb_tdelay0 flb_tdelay1 flb_rate flb_mix
   fparam0 fparam1 fparam2 fparam3 fparam4 fparam5 fparam6 fparam7 fparam8 fparam9 lo_level hi_level mic_angle mic_angle_rad spd
   lset hset lmom hmom fparam0_old drive_gain drive_gain_comop drive_tube x_over flb_offset flb_sdelay0 flb_sdelay1
   wet0 wet1 tube
   hl hm hw hd ll lm lw hlev hmem hwid hdep llev lmom lwid ht lt a org_speed drum_pos drum_pos_ch h horn_L_pos horn_L_pos_ch horn_L_pos_trem
   horn_R_pos horn_R_pos_ch horn_R_pos_trem hphi2 l lphi2
   gfx_mic gfx_open dings tmp lslider1 filehandle impbuf impbuf_l impbuf_nch impbuf_srate need_refft reload_IR filha stereo_mode useresample preamp 
   ir_fade ir_fade_dur filtersize bpos chunksize tt lastblock curblock fftsize bp2
   chunksize2 convsrc fileha i i2 invfsize ipart ipos ir_fade isc
   fftsize need_refft convscr lslider1 impbuf
   )
   (
       
       drive_gain ? (
       wet0 = tanh(spl0*drive_gain);
       wet1 = tanh(spl1*drive_gain);
       spl0 = drive_gain_comop*(((exp(wet0*drive_tube) - exp(wet0*drive_tube * -1.2)) / (exp(wet0*drive_tube) + exp(wet0*tube * -1.0))) / drive_tube);
       spl1 = drive_gain_comop*(((exp(wet1*drive_tube) - exp(wet1*drive_tube * -1.2)) / (exp(wet1*drive_tube) + exp(wet1*tube * -1.0))) / drive_tube);
       );
       
       
       reload_IR == 1 ? (
         ir_fade_dur = 50;
         IR_fade += 1;
         ir_fade >= srate / ir_fade_dur ? (reload_ir = 2;IR_fade = 0;);
         spl0 *= 1- (ir_fade/(srate/ir_fade_dur));
         spl1 *= 1- (ir_fade/(srate/ir_fade_dur));
       );
       reload_ir == 2 ? (
         ir_fade >= srate / ir_fade_dur ? this.reload_ir(); 
         IR_fade += 1;
         ir_fade >= 2 * srate / ir_fade_dur ? (reload_ir = 3;IR_fade = 0;);
         spl0 = spl1 = 0;
         )
       ;
       reload_IR == 3 ? (
         IR_fade += 1;
         ir_fade >= srate / ir_fade_dur ? reload_ir = -1;
         spl0 *= (ir_fade/(srate/ir_fade_dur));
         spl1 *= (ir_fade/(srate/ir_fade_dur));
       );
       
       
       filtersize > 0 ?
       (
       
       bpos >= chunksize ? 
       (
         tt=lastblock;
         lastblock=curblock;
         curblock=tt;
       
         memset(curblock+chunksize*2,0,(fftsize-chunksize)*2);
       
         fft(curblock,fftsize);
         convolve_c(curblock,convsrc,fftsize);
       
         ifft(curblock,fftsize);
       
         bpos=0;
       );
       
       // save sample
       bp2=bpos*2;
       lastblock[bp2]=spl0*preamp;
       lastblock[bp2+1]=stereo_mode ? (spl1*preamp) : 0;
       
       spl0=curblock[bp2];
       spl1=curblock[bp2+1];
       
       bpos < fftsize-chunksize ? 
       (
         spl0+=lastblock[chunksize2+bp2];
         spl1+=lastblock[chunksize2+bp2+1];
       );
       
       
       bpos += 1;
       
       );
       
       
       
       
       
       ////////////////////////// MOTORS
       hl=hlev;
       hm=hmom;
       hw=hwid;
       hd=hdep;
       ll=llev;
       lm=lmom;
       lw=lwid;
       
       ht=hset*(1-hm);
       lt=lset*(1-lm);
       
       chp = cos(hphi); chp *= chp * chp;
       clp = cos(lphi);
       shp = sin(hphi);
       slp = sin(lphi);
       
       
       a = (spl0+spl1)*0.5; //*0.5 ???
       
       (k>0) ? (
       k-=1;
       ):(
       lspd = (lm * lspd) + lt; // tend to required speed
       hspd = (hm * hspd) + ht;
       lphi += k1 * lspd;
       hphi += k1 * hspd;
       
       dchp = cos(hphi + k1*hspd);
       dchp = k0 * (dchp * dchp * dchp - chp); // sin^3 level mod
       dclp = k0 * (cos(lphi + k1*lspd) - clp);
       dshp = k0 * (sin(hphi + k1*hspd) - shp);
       dslp = k0 * (sin(lphi + k1*lspd) - slp);
       
       k=k1;
       );
       
       
       
       //slider43 = lphi;
       //slider44 = hphi;
       
       org_speed == 0 ? (
         lspd < 0.0000001 && lspd > 0 ? (
            //lphi2 = lphi >= $pi ? 360-((cos(lphi-$pi)+1)/1)*90 : ((cos(lphi-$pi)+1)/1)*90;
            //slider43 = lphi2;
            lspd = 0;
         );
         lspd === 0 ? (
             //slider43 <= 180 ? lphi = acos(((slider43/180)*2)-1)-$pi;
             //slider43 > 180 ? lphi = acos((((slider43-180)/180)*2)-1)-0*$pi;
             lphi *= 1;
         );
         hspd < 0.0000001 && hspd > 0 ? (
            //hphi2 = hphi >= $pi ? 360-((cos(hphi-$pi)+1)/1)*90 : ((cos(hphi-$pi)+1)/1)*90;
            //slider44 = hphi2;
            hspd = 0;
         );
         hspd === 0 ? (
             //slider44 <= 180 ? hphi = acos(((slider44/180)*2)-1)-$pi;
             //slider44 > 180 ?  hphi = acos((((slider44-180)/180)*2)-1)-0*$pi;
             hphi *= 1;
         );
       );
       
       ext_ ? (
         hphi = ((pointer_r_+1)/2)*twopi;
         lphi = ((pointer_L_+1)/2)*twopi;
       );
       
       horn_L_pos = (hphi + mic_angle_rad/2)/twopi;
       horn_L_pos < 0 ? horn_L_pos += 1 :
       horn_L_pos > 1 ? horn_L_pos -= 1;
       horn_L_pos_ch = (cos(hphi + mic_angle_rad/2 + $pi/2)+1)/2;
       horn_L_pos_trem = (cos(hphi + mic_angle_rad/2)+1)/2;
       //wall_horn_L_pos_trem = (cos(hphi + $pi + mic_angle_rad/2)+1)/2;
       
       horn_R_pos = (hphi - mic_angle_rad/2)/twopi;
       horn_R_pos < 0 ? horn_R_pos += 1 :
       horn_R_pos > 1 ? horn_R_pos -= 1;
       horn_R_pos_ch = (cos(hphi - mic_angle_rad/2 + $pi/2)+1)/2;
       horn_R_pos_trem = (cos(hphi - mic_angle_rad/2)+1)/2;
       //wall_horn_R_pos_trem = (cos(hphi - $pi - mic_angle_rad/2)+1)/2;
       
       drum_pos = lphi/twopi;
       drum_pos_ch = (cos(lphi + $pi/2)+1)/2;
       
       minus_six = db2ratio(-6*(log10(srate/44100) / log10(2)));
       a = (spl0+spl1)*0.5 * minus_six; //*0.5 ???
       this.crossover_low.filter.svf_tick();
       this.crossover_high.filter.svf_tick();
       h = this.crossover_high.filter.svf_svf0(a) * hi_level;
       l = this.crossover_low.filter.svf_svf0(a) * lo_level;
       
       chp += dchp;
       clp += dclp;
       shp += dshp;
       slp += dslp;
       
       lphi = ((lphi+(k1-k)*lspd)); lphi>=twopi ? lphi-=twopi;
       hphi = ((hphi+(k1-k)*hspd)); hphi>=twopi ? hphi-=twopi;
       
       
       ///////////////////////////////////// ENDE MOTORS
       
       this.chorus_do();
       spl0 *= db2ratio(11); spl1*=db2ratio(11); 
       
   );
   
   
   
   
   
   
   
   
   
   Modul1 = 1;
   Modul2 = 2;
   Modul3 = 3;
   Modul4 = 4;
   Modul5 = 5;
   Modul6 = 6;
   Modul7 = 7;
   Modul8 = 8;
   Modul9 = 8;
   Modul10=10;
   
   
   last_clicked_slot = 1;
   startslot = -1;
   
   
   
   function initialize_everything () (
   
   SAMPLE_RATE = srate;
   
   next_mem = rotor.rotor_init(0);
   
   
   
   freedraw = next_mem;//2000000;
   step8 = freedraw + 70;
   step16 = step8+8;
   
   ext_hist_l = step16 + 16;
   ext_hist_R = ext_hist_l + 2000;
   
   group_generics = ext_hist_R + 2000;; // memory point fuer group_generics[bis zu 200]
   sliders_old = group_generics + 200;
   generics_old = sliders_old + 256;
   
   //new_memory_inx = generics_old + 210;
   
   gmem_step8 = generics_old + 210;
   gmem_step16 = gmem_step8 + 8;
   gmem_step64 = gmem_step16 + 16;
   
   next_mem = flanger.flanger_init(gmem_step64 + 74);
   
   next_mem=Chorus.S3_Chorus_init(next_mem);
   
   shifter_L_Buf = next_mem;
   shifter_R_Buf = next_mem + 4*65536;
   shifter_transition_region = 1024*floor((srate/44100));
   shifter_bufferSize = 4 * shifter_transition_region;
   shifter_L.pitchShifter(1, shifter_L_Buf, shifter_bufferSize, shifter_L_Buf+2*65536, shifter_L_Buf+3*65536, shifter_transition_region, 1);
   shifter_R.pitchShifter(1, shifter_R_Buf, shifter_bufferSize, shifter_R_Buf+2*65536, shifter_R_Buf+3*65536, shifter_transition_region, 1);
   
   next_mem += 8*65536;
   
   
   Filter_Init();
   
   
   generics_push(1, Modul1);
   generics_push(2, Modul2);
   generics_push(3, Modul3);
   generics_push(4, Modul4);
   generics_push(5, Modul5);
   generics_push(6, Modul6);
   generics_push(7, Modul7);
   generics_push(8, Modul8);
   generics_push(9, Modul9);
   generics_push(10, Modul10);
   
   
   caller = 1;
   );
   
   initialize_everything ();
   
   /*
   function test_reinit()
   (
     (window != last_window) || (last_matching != phase_match) ? (
       transition_region = 2^(window+5)*(srate/44100);
       bufferSize = 4 * transition_region;
       shifter.pitchShifter(phase_match, 0, bufferSize, 2*65536, 3*65536, transition_region, 1);
       last_window = window;
       last_matching = phase_match;
     );
   );
  */
   
   
   Function all_boundaries() (
   Pointer_shift.parameter_config    (4,     0,      0,    360,    180-3,   300,  160, 140,    0.8,  14);
   Pointer_offset.parameter_config   (5,     0,      0,    360,    285-3,   300,  160, 140,    0.8,  14);
   Smoothing.parameter_config        (22,    10,     1,    100,    390-3,   300,  160, 140,    0.8,  14);
           //Pointer_shift.parameter_config    (4,     0,      0,    360,    205,   300,  160, 140,    0.9,  14);
           //Pointer_offset.parameter_config   (5,     0,      0,    360,    335,   300,  160, 140,    0.9,  14);
           Dial.parameter_config             (8,     2,   0.05,      5,    420,   445,  160, 140,    0.9,  14);
           Speed.parameter_config            (6,     9,      0,      9,    205,   445,  160, 140,    0.9,  14);
           Trem_Smoothing.parameter_config    (22,        10,       1,      100,   785 , 320, 140, 101,    1,       31);
           Trem_Intensity.parameter_config    (21,       100,       0,      100,   750,  140, 280, 101,    1,       32);
           Pan_intensity.parameter_config    (61,     100,      0,    100,    205,   300,  160, 140,    0.9,  29);
           PH_Low.parameter_config  (10,     49,        0,  100,    740,   150,  160, 201,    1.36,  27);
           PH_Hi.parameter_config   (11,     65,        0,  100,    880,   150,  160, 201,    1.36,  27);
           PH_FBK.parameter_config  (12,     -3,     -30,   -1,    740,   360,  160, 201,    1.36,  27);
           PH_Mix.parameter_config  (13,    100,       0,   100,    880,   360,  160, 201,    1.36,  27);
           FL_Width.parameter_config     (15,       20,        0,    100,  720,  130,  180, 200,    1.2,  26);
           FL_Feedback.parameter_config  (16,       70,        0,    100,  840,  130,  180, 200,    1.2,  26);
           FL_Delay.parameter_config     (17,        3,        0,    100,  960,  130,  180, 200,    1.2,  26);
           FL_Mix.parameter_config       (19,       50,        0,    100, 1080,  130,  180, 200,    1.2,  26);
           CH_Out.parameter_config      (26,        0,        -24,     24,     1109,  65,    140, 101,    1.15,       24);
           CH_Mix.parameter_config      (24,       50,          0,    100,     1109,  165,    140, 101,    1.15,       24);
           CH_Rate.parameter_config     (31,      0.5,        0.1,     10,      840,  450,    140, 101,    1.15,       24);
           CH_Depth.parameter_config    (29,        3,          0,     10,      980,  450,    140, 101,    1.15,       24);
           CH_Delay.parameter_config    (30,        3,          1,     20,     1070,  450,    140, 101,    1.15,       24);
           FIL_In.parameter_config      (39,        0,    -24,       0,    knx,   120,  160, 200,    1,  28);
           FIL_LF.parameter_config      (35,        0,      0,     100,    knx-50,225,  160, 200,    1,  28);
           FIL_HF.parameter_config      (36,      100,      0,     100,    knx+53,225,  160, 200,    1,  28);
           FIL_RESONANCE.parameter_config      (37,        70,      0,     100,    knx,330,  160, 200,    1,  28);
           FIL_MIX.parameter_config      (40,      70,      0,     100,    knx,435,  160, 200,    1,  28);
           Vib_Depth.parameter_config    (42,     30,      0,    100,    740,   100,  160, 140,    0.9,  14);
           Vib_Mix.parameter_config    (43,     50,      0,    100,    740,   230,  160, 140,    0.9,  14);
           drum_level.parameter_config    (46,       5,      0,    10,      920, 365,  140,    101,   0.8,       17);
           horn_level.parameter_config    (47,       5,      0,    10,      1140, 365,  140,    101,   0.8,       17);
           Crossover.parameter_config     (50,       5.52,   0,    10,      1030, 365,  140,    101,   0.8,       17);
           Mic_Angle.parameter_config     (49,       90,      0,  180,      760, 85,  140,    101,   0.8,       17);
           Horn_stereo.parameter_config   (48,      0.7,      0,    1,      760, 170,  140,    101,   0.8,       17);
           Rotor_Drive.parameter_config   (53,       0,       0,   10,      760, 255,  140,    101,   0.8,       17);
           Drum_Slow.parameter_config     (54,    0.27,       0,    1,      785, 477,  140,    101,   0.8,       17);
           Drum_Fast.parameter_config     (55,    2.89,       0,    5,      985, 477,  140,    101,   0.8,       17);
           Horn_Slow.parameter_config     (56,     0.5,       0,    1,      885, 477,  140,    101,   0.8,       17);
           Horn_Fast.parameter_config     (57,       4,       0,    5,     1085, 477,  140,    101,   0.8,       17);         
      
      
           Pointer_shift.parameter_boundaries(); 
           Pointer_offset.parameter_boundaries();
           Dial.parameter_boundaries(); 
           Speed.parameter_boundaries();
           Trem_Smoothing.parameter_boundaries();
           Trem_Intensity.parameter_boundaries();
           Pan_intensity.parameter_boundaries(); 
           PH_Low.parameter_boundaries();
           PH_Hi.parameter_boundaries();
           PH_FBK.parameter_boundaries();
           PH_Mix.parameter_boundaries(); 
           FL_Width.parameter_boundaries();
           FL_Feedback.parameter_boundaries();
           FL_Delay.parameter_boundaries(); 
           FL_Mix.parameter_boundaries(); 
           CH_Out.parameter_boundaries();
           CH_Mix.parameter_boundaries();
           CH_Rate.parameter_boundaries(); 
           CH_Depth.parameter_boundaries(); 
           CH_Delay.parameter_boundaries();
           FIL_In.parameter_boundaries(); 
           FIL_LF.parameter_boundaries(); 
           FIL_HF.parameter_boundaries();
           FIL_RESONANCE.parameter_boundaries();
           FIL_MIX.parameter_boundaries(); 
           Vib_Depth.parameter_boundaries();
           Vib_Mix.parameter_boundaries();
           drum_level.parameter_boundaries();
           horn_level.parameter_boundaries();
           Crossover.parameter_boundaries();
           Mic_Angle.parameter_boundaries();
           Horn_stereo.parameter_boundaries();
           Rotor_Drive.parameter_boundaries();
           Drum_Slow.parameter_boundaries();
           Drum_Fast.parameter_boundaries();
           Horn_Slow.parameter_boundaries();
           Horn_Fast.parameter_boundaries();
   );
   
   
   function parameters_update () (
   
    parameters_update_on = 1;
   
   
   all_boundaries();
   
       group_parameters();
   
       modul1 = group_generics[1];
       modul2 = group_generics[2];
       modul3 = group_generics[3];
       modul4 = group_generics[4];
       modul5 = group_generics[5];
       modul6 = group_generics[6];
       modul7 = group_generics[7];
       modul8 = group_generics[8];
       modul9 = group_generics[9];
       modul10= group_generics[10];
    
       
        
        lushyloop = 0;
        loop(8,
        step8[lushyloop] = group_generics[11+lushyloop];
        lushyloop+=1;
        );
        
        lushyloop = 0;
        loop(16,
        step16[lushyloop] = group_generics[19+lushyloop];
        lushyloop+=1;
        );
        
        lushyloop = 0;
        loop(64,
        freedraw[lushyloop] = group_generics[35+lushyloop];
        lushyloop+=1;
        );
        
       
       
       
       
       
   general_bypass = slider63;
   
   
   free_run = slider1;
   form = slider3;
 
   
   !sync_on && slider6_old != slider6 ? sync_on = 1;
   sync_on && tempo_hz != slider8 ? (sync_on = 0; slider6 = 9);
   slider6_old = slider6;
   
   
   slider6 == 0 ? time_sync = 0.125;
   slider6 == 1 ? time_sync = 0.25;
   slider6 == 2 ? time_sync = 0.5;
   slider6 == 3 ? time_sync = 1;
   slider6 == 4 ? time_sync = 2;
   slider6 == 5 ? time_sync = 4;
   slider6 == 6 ? time_sync = 8;
   slider6 == 7 ? time_sync = 16;
   slider6 == 8 ? time_sync = 32;
   slider6 == 9 ? sync_on = 0;
   
   time_sync_2 = slider7;
   
   
   tempo_hz = slider8;
   
   slider9 == 0 ? multiplier = 1 : multiplier = 10;
   
   phase_shift = slider4;
   phase_shift_r = slider5;
   
   run_on_stop = slider2;
   form ==0 ? run_on_stop = 1;
   
   
   
   
   phaser.phaser_parameters(10);Modul3.on = slider14;
   flanger.flanger_parameters(slider15, slider16, slider17, slider18, slider19);Modul4.on = slider20;
   //(stages_ jun_chorus_ mode_ mix_ gain_ depth_ delay_ Hertz_) 
   Chorus.S3_chorus_parameters_update(slider27, slider25, slider28, slider24, slider26, slider29, slider30, slider31, slider32); modul5.on = slider33;
   Filter.filter_parameters(slider34, slider35, slider36, slider37, slider38, slider39, slider40); Modul6.On = slider41;
   
   trem_mix = slider21/100;
   trem_smoothing = 1/(slider22*0.001*srate);
   smoothing_ms = floor(1.01010101*(slider22-1)+0.5);
   smoothing = 1/((smoothing_ms)*0.001*srate);//10*(slider22/100)^4;
   modul1.on = slider23;
   
   Pan_mode = slider60;
   pan_intensity = slider61/100;
   modul2.on = slider62;
   
   
   shifter_depth = slider42/50;
   shifter_mix = slider43/100;
   slider44 && !shifter_was_on ? (
      shifter_L.pitchShifter(1, shifter_L_Buf, shifter_bufferSize, shifter_L_Buf+2*65536, shifter_L_Buf+3*65536, shifter_transition_region, 1);
      shifter_R.pitchShifter(1, shifter_R_Buf, shifter_bufferSize, shifter_R_Buf+2*65536, shifter_R_Buf+3*65536, shifter_transition_region, 1);
   );
   Modul7.on = shifter_was_on = slider44;
   
   rotor.rotor_parameters_update(slider45, slider46, slider47, slider48, slider49, slider50, slider51, slider52, slider53, slider54, slider55, slider56, slider57); 
   slider45 ? last_speed = slider45;
   
   rotor_motor = slider58;
   modul8.on = slider59;
   modul9.on && !modul8.on_old ? rotor.need_refft=1;
   modul8.on_old = modul8.on;
   
   
   SMOOTHING_TIME_MS = 0.01;
   
   parameters_update_on = 0;
   caller = 0;
   );
   
   
   
   
@slider

    caller = 1;
 



   
   
   
   
@serialize
   file_var(0, slider6_old);
   file_var(0, tempo_hz);
   file_var(0, sync_on);
file_var(0, last_clicked_slot);
