   seriloop += 1;
   );
   
   
@block
   block_play_position = play_position;
   pos_add = 0;
   
   srate_old != srate ? initialize_everything ();
   srate_old = srate;
   
   S2_sample_on = 1;
   gmem[16*256 + 10 + link_group] != 1 ? link_group = 0;
   group_check_smpl();
   caller == 1 ? (
     parameters_update_on == 0 ? (
       parameters_update();
     );
   );
   
   slider200 = abs_position;
   slider201 = abs_position_2;   
@sample
   

function modul1_SPL () (
modul1.on && !general_bypass ? (
      //abs(((abs_position+1)/2) - TremL) > trem_smoothing ? (
      //    ((abs_position+1)/2) > TremL ? TremL += trem_smoothing : TremL -= trem_smoothing;
      //):(
          TremL = ((abs_position+1)/2);
      //);
      //abs(((abs_position_2+1)/2) - TremR) > trem_smoothing ? (
      //    ((abs_position_2+1)/2) > TremR ? TremR += trem_smoothing : TremR -= trem_smoothing;
      //):(
          TremR = ((abs_position_2+1)/2);
      //);
      spl0 = (1-trem_mix)*spl0 + TremL*trem_mix*spl0;
      spl1 = (1-trem_mix)*spl1 + TremR*trem_mix*spl1;
   ):(
      TremL = (abs_position+1)/2;
      TremR = (abs_position_2+1)/2;
   );
);


function modul2_SPL () (
Modul2.on && !general_bypass ? (
    pan_mode == 0 ? (
      pan_sig = (spl0+spl1)/2;
      spl0 = pan_sig * (1-pan_intensity)     +    pan_sig * (pan_intensity) * ((abs_position+1)/2);
      spl1 = pan_sig * (1-pan_intensity)     +    pan_sig * (pan_intensity) * (1-((abs_position+1)/2));
    );
    pan_mode == 1 ? (
      pan_spl0 = spl0; pan_spl1 = spl1;
      spl0 = spl0 * (1-pan_intensity)   +     spl0 * (pan_intensity) * ((abs_position+1)/2);
      spl1 = spl1 * (1-pan_intensity)   +     spl1 * (pan_intensity) * ((1-(abs_position_2+1)/2));
    );
    pan_mode == 2 ? (
      pan_spl0 = spl0; pan_spl1 = spl1;
      spl0 = pan_spl0 * (1-pan_intensity)   +     pan_spl0 * (pan_intensity) * ((abs_position+1)/2)   
         +   pan_spl1 * (1-pan_intensity)   +     pan_spl1 * (pan_intensity) * ((abs_position_2+1)/2);
      
      spl1 = pan_spl0 * (1-pan_intensity)   +     pan_spl0 * (pan_intensity) * (1-((abs_position+1)/2))   
         +   pan_spl1 * (1-pan_intensity)   +     pan_spl1 * (pan_intensity) * (1-((abs_position_2+1)/2));
    );
);
);

   
function modul3_SPL () (
Modul3.on && !general_bypass ? (
   phaser.phaser_do(spl0, spl1, abs_position, abs_position_2);
   spl0 = phaser.outL;
   spl1 = phaser.outR;
   );
);

function modul4_SPL () (
Modul4.on && !general_bypass ? (
   flanger.flanger_do(spl0, spl1, abs_position, abs_position_2);
   spl0 = flanger.outL;
   spl1 = flanger.outR;
   );
);

function modul5_SPL () (
Modul5.on && !general_bypass ? (
   Chorus.S3_chorus_do(abs_position, abs_position_2);
   );
);


function modul6_SPL () (
Modul6.on && !general_bypass ? (
    Filter.Filter_do(abs_position, abs_position_2);
   );
);

function modul7_SPL () (
Modul7.on && !general_bypass ? (
      shifter_L.pitchShifterUpdate(spl0, 0);
      shifter_L.setPitchShifterSpeed(2*((2^(shifter_depth*abs_position/12))-1.0));
      shifter_R.pitchShifterUpdate(0, spl1);
      shifter_R.setPitchShifterSpeed(2*((2^(shifter_depth*abs_position_2/12))-1.0));
      spl0 = spl0 * (1-shifter_mix) + shifter_L.outL * shifter_mix;
      spl1 = spl1 * (1-shifter_mix) + shifter_R.outR * shifter_mix;
   );
);  
   
   
function modul8_SPL () (
Modul8.on && !general_bypass ? (
      spl0 *= 4;
      spl1 *= 4;
      rotor.rotor_do(rotor_motor, abs_position, abs_position_2);
   );
);
function modul9_SPL () (do_nothing = 0);
function modul10_SPL () (do_nothing = 0);







playstates();

process = 0;
while_playing ? is_playing ? process = 1:
while_recording ? is_recording ? process = 1:
while_stopped ? is_stopped ? process = 1;



process == 1 ? (

   form == 0 ? (
   abs_position = slider200;
   abs_position_2 = slider201;
   );
   
   
   
   sync_on == 1 ? ( //TEMP SYNCED
   Takt_in_s = (240 / tempo);
   time_sync_2 == 1 ? (T_Fac = 1.5):(T_Fac=1);
   Hertz = Takt_in_s / (time_sync*T_Fac);
   time_sync_2 == 2 ? Hertz *= 1.5;
   cosphi = phase_shift / 360;
   ):(
   vslider41 = tempo_hz * multiplier;
   vslider41 != 0 ? Hertz = 1/vslider41;
   cosphi = phase_shift / 360;
   );
   
   //block_ ... + (pos_add/srate) 
   n_durchgaenge = ((block_play_position + (pos_add/srate) + cosphi*Hertz) / Hertz);
   pos_add += 1;
   
   free_run == 1 ? ( //1 = Time sync, not free run
   run_on_stop == 1 ? (
   phase_position += (1/Hertz) / srate;
   phase_position >= 1 ? phase_position = 0;
   play_state == 1 ? phase_position = n_durchgaenge - floor(n_durchgaenge); // von 0 bis 1
   play_state == 5 ? phase_position = n_durchgaenge - floor(n_durchgaenge); // von 0 bis 1
   ):(
   phase_position = n_durchgaenge - floor(n_durchgaenge); // von 0 bis 1
   );
   ):( //Free run LFO?
   run_on_stop == 1 ? (
   phase_position += (1/Hertz) / srate;
   phase_position >= 1 ? phase_position = 0;
   ):(
   play_state == 1 ? phase_position += (1/Hertz) / srate;
   play_state == 5 ? phase_position += (1/Hertz) / srate;
   phase_position >= 1 ? phase_position = 0;
   );
   );
   
   phase_position_2 = phase_position + phase_shift_r/360;
   phase_position_2 > 1 ? phase_position_2 -= 1;
   
   
   sinus_Position = sin(phase_position * 2 * $pi);
   flip_position = sign(sinus_Position);
   ramp_up_position = -1 + 2*phase_position;
   ramp_down_position = 1 - 2*phase_position;
   
   phase_position <= 0.25 ? triangle_position = phase_position * 4:
   phase_position <= 0.5 ?  triangle_position = 1 - (phase_position-0.25) * 4:
   phase_position <= 0.75 ? triangle_position = (phase_position-0.5) * -4:
   phase_position > 0.75 ?  triangle_position = -1 + (phase_position - 0.75) * 4;
   
   
   sinus_position_2 = sin(phase_position_2 * 2 * $pi);
   flip_position_2  = sign(sinus_position_2);
   ramp_up_position_2 = -1 + 2*phase_position_2;
   ramp_down_position_2 = 1 - 2*phase_position_2;
   
   phase_position_2 <= 0.25 ? triangle_position_2 = phase_position_2 * 4:
   phase_position_2 <= 0.5 ?  triangle_position_2 = 1 - (phase_position_2-0.25) * 4:
   phase_position_2 <= 0.75 ? triangle_position_2 = (phase_position_2-0.5) * -4:
   phase_position_2 > 0.75 ?  triangle_position_2 = -1 + (phase_position_2 - 0.75) * 4;
   

   form == 8 ? free_position = freedraw[phase_position * 64];
   form == 8 ? free_position_2 = freedraw[phase_position_2 * 64];
   
   //step8
   form == 6 ? free_position = step8[phase_position*8];
   form == 6 ? free_position_2 = step8[phase_position_2 * 8];
   
   //step16
   form == 7 ? free_position = step16[phase_position * 16];
   form == 7 ? free_position_2 = step16[phase_position_2 * 16];
   
   form > 5 ? (
   abs_position_new = free_position;
   abs_position_2_new = free_position_2;
   );
   
   form == 1 ? abs_position_new = sinus_Position;
   form == 2 ? abs_position_new = flip_Position;
   form == 3 ? abs_position_new = ramp_up_Position;
   form == 4 ? abs_position_new = ramp_down_Position;
   form == 5 ? abs_position_new = triangle_Position;
   
   abs_position_new > abs_position ? distanz = abs(abs_position_new - abs_position);
   abs_position_new <= abs_position ? distanz = abs(abs_position - abs_position_new);

   distanz > fade_on ? ( // (srate/50) ? (
   abs_position_new > abs_position ? fade_on = smoothing;
   abs_position_new <= abs_position ? fade_on = -smoothing;
   ):(
   fade_on = 0;
   );
   
   fade_on != 0 ? (
   abs_position += fade_on;// / (srate/50);
   //distanz <= 0.05 ? fade_on = 0;
   ):(
   abs_position = abs_position_new;
   //form == 1 ? abs_position = sinus_Position;
   //form == 2 ? abs_position = flip_Position;
   //form == 3 ? abs_position = ramp_up_Position;
   //form == 4 ? abs_position = ramp_down_Position;
   //form == 5 ? abs_position = triangle_Position;
   );
   
   
   form == 1 ? abs_position_2_new = sinus_position_2;
   form == 2 ? abs_position_2_new = flip_position_2;
   form == 3 ? abs_position_2_new = ramp_up_position_2;
   form == 4 ? abs_position_2_new = ramp_down_position_2;
   form == 5 ? abs_position_2_new = triangle_position_2;
   
   abs_position_2_new > abs_position_2 ? distanz_2 = abs(abs_position_2_new - abs_position_2);
   abs_position_2_new <= abs_position_2 ? distanz_2 = abs(abs_position_2 - abs_position_2_new);
   
   distanz_2 > fade_on_2 ? (// (srate/50) ? (
   abs_position_2_new > abs_position_2 ? fade_on_2 = smoothing;
   abs_position_2_new <= abs_position_2 ? fade_on_2 = -smoothing;
   ):(
   fade_on_2 = 0;
   );
   
   fade_on_2 != 0 ? (
   abs_position_2 += fade_on_2; // (srate/50);
   //distanz_2 <= 0.05 ? fade_on_2  = 0;
   ):(
   abs_position_2 = abs_position_2_new;
   //form == 1 ? abs_position_2 = sinus_position_2;
   //form == 2 ? abs_position_2 = flip_position_2;
   //form == 3 ? abs_position_2 = ramp_up_position_2;
   //form == 4 ? abs_position_2 = ramp_down_position_2;
   //form == 5 ? abs_position_2 = triangle_position_2;
   );
   //abs_position_before_smoothing = abs_position;
   //abs__position_2_before_smoothing = abs_position_2;
   //abs_position_2_new_before_smoothing = abs_position_2_new;
   
   
Modul1 == 1 ? Modul1_SPL():
Modul2 == 1 ? Modul2_SPL():
Modul3 == 1 ? Modul3_SPL():
Modul4 == 1 ? Modul4_SPL():
Modul5 == 1 ? Modul5_SPL():
