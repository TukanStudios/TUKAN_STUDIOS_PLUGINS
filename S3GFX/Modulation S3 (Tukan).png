); //porcess
   
   
   
   
   
   
   
   
   
   
   
   
   
   
   
   
   
   
   
   
   
   
   
   
   
   
@gfx 1226 551
   




mouse_state();


  gfx_setfont(1,"Arial",12*zoom,'b');
  gfx_setfont(2,"Arial",10*zoom,'b');
