file_var(0, Modul9);
file_var(0, Modul10);
serialize_s3();
   
   file_avail(0) >= 0 ? shifter_was_on = 0;
   
   seriloop = 0;
   loop(16,
   file_var(0, step16[seriloop]);
   seriloop += 1;
   );
   
   seriloop = 0;
   loop(8,
   file_var(0, step8[seriloop]);
   seriloop += 1;
