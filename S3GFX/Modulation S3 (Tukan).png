         //S3Button(78,1, 1, (module_x)/zoom + 6, (module_y + (Modul10-1)*module_h)/zoom - 6, 11); //slider, onvalue, toggle to 0, posx, posy, png 
         //slider(LUFS_Startslider+7) < 2 ? S3Button(LUFS_Startslider+7,1, 1, (module_x)/zoom + 6, (module_y + (10.5)*module_h)/zoom - 6, 2); //slider, onvalue, toggle to 0, posx, posy, png 
         //slider(LUFS_Startslider+7) == 2 ? S3Button(LUFS_Startslider+7,2, 1, (module_x)/zoom + 6, (module_y + (10.5)*module_h)/zoom - 6, 2);
         
         //g_collision(module_x+50*zoom, module_y+ (10.5)*module_h, module_w-50*zoom, module_h) && mouseclick == 1 ? (
         //  last_clicked_slot = 11;
         //);
         
         
         //#S3Label = "VU"; S3Button_Label(300,330,1); // xx, y, position
         
         
   startslot == 0 ? startslot = -1;
   g_collision(module_x+50*zoom, module_y, module_w-50*zoom, 8*module_h) && startslot == -1 ? (
    slot_collision = 1+floor((mouse_y - module_y)/module_h);
    mouseClick == 1 ? startslot = slot_collision;
   ):(
    slot_collision = -1;
   );
   
   startslot > -1 ? (
     zielslot = max(1,min(8,1+floor((mouse_y - module_y)/module_h)));
     
     green();
     zielslot < startslot ? gfx_rect(module_x+module_w, module_y + (zielslot-1)*module_h -zoom, 30*zoom, 3*zoom);
     zielslot > startslot ? gfx_rect(module_x+module_w, module_y + (zielslot)*module_h -zoom, 30*zoom, 3*zoom);
   
     zielslot != startslot && mouseClick == -1 ? (
         Modul1 == startslot ? Modul1 = -1;
         Modul2 == startslot ? Modul2 = -1;
         Modul3 == startslot ? Modul3 = -1;
         Modul4 == startslot ? Modul4 = -1;
         Modul5 == startslot ? Modul5 = -1;
         Modul6 == startslot ? Modul6 = -1;
         Modul7 == startslot ? Modul7 = -1;
         Modul8 == startslot ? Modul8 = -1;
         Modul9 == startslot ? Modul9 = -1;
         Modul10== startslot ? Modul10= -1;
         
         startslot < zielslot ? (
             Modul1 > startslot && Modul1 <= zielslot ? Modul1 -= 1;
             Modul2 > startslot && Modul2 <= zielslot ? Modul2 -= 1;
             Modul3 > startslot && Modul3 <= zielslot ? Modul3 -= 1;
             Modul4 > startslot && Modul4 <= zielslot ? Modul4 -= 1;
             Modul5 > startslot && Modul5 <= zielslot ? Modul5 -= 1;
             Modul6 > startslot && Modul6 <= zielslot ? Modul6 -= 1;
             Modul7 > startslot && Modul7 <= zielslot ? Modul7 -= 1;
             Modul8 > startslot && Modul8 <= zielslot ? Modul8 -= 1;
             Modul9 > startslot && Modul9 <= zielslot ? Modul9 -= 1;
             Modul10> startslot && Modul10<= zielslot ? Modul10-= 1;
         ):(
             Modul1 < startslot && Modul1 >= zielslot ? Modul1 += 1;
             Modul2 < startslot && Modul2 >= zielslot ? Modul2 += 1;
             Modul3 < startslot && Modul3 >= zielslot ? Modul3 += 1;
             Modul4 < startslot && Modul4 >= zielslot ? Modul4 += 1;
             Modul5 < startslot && Modul5 >= zielslot ? Modul5 += 1;
             Modul6 < startslot && Modul6 >= zielslot ? Modul6 += 1;
             Modul7 < startslot && Modul7 >= zielslot ? Modul7 += 1;
             Modul8 < startslot && Modul8 >= zielslot ? Modul8 += 1;
             Modul9 < startslot && Modul9 >= zielslot ? Modul9 += 1;
             Modul10< startslot && Modul10>= zielslot ? Modul10+= 1;
         );
         
         Modul1 == -1 ? Modul1 = Zielslot;
         Modul2 == -1 ? Modul2 = Zielslot;
         Modul3 == -1 ? Modul3 = Zielslot;
         Modul4 == -1 ? Modul4 = Zielslot;
         Modul5 == -1 ? Modul5 = Zielslot;
         Modul6 == -1 ? Modul6 = Zielslot;
         Modul7 == -1 ? Modul7 = Zielslot;
         Modul8 == -1 ? Modul8 = Zielslot;
         Modul9 == -1 ? Modul9 = Zielslot;
         Modul10== -1 ? Modul10= Zielslot;
         
        
         generics_push(1, Modul1);
         generics_push(2, Modul2);
         generics_push(3, Modul3);
         generics_push(4, Modul4);
         generics_push(5, Modul5);
         generics_push(6, Modul6);
         generics_push(7, Modul7);
         generics_push(8, Modul8);
         generics_push(9, Modul9);
         generics_push(10, Modul10);
        
     ):(
       last_clicked_slot = startslot;
     );
     
   );
   
   
   
   
   
   
   
   
   
   
   
   
   
   
      //////////////////////////////////////////  MENU MENU ////////////////////////////////////////////////
      last_clicked_item = -1;
      Helpshow ? mouse_cap ? (helpshow = 0;last_clicked_item = -1);
      menu_x = 5; menu_y =10;
     gfx_setfont(1,"Arial",14*zoom,'i');
     gfx_x = menu_x * zoom; gfx_y = menu * zoom; gfx_a=1;
     //gfx_blit(menu,zoom/2,0);
     
     rgb(40,40,40);
     gfx_rect(0,0,gfx_w,48*zoom);
   
     lightgrey(); //red();
     gfx_roundrect(menu_x * zoom, (menu_y + 5) * zoom, 20*zoom, 20*zoom, 0, 1);
     gfx_line((menu_x+3)*zoom, (menu_y + 11)*zoom, (menu_x+17)*zoom, (menu_y + 11)*zoom);
     gfx_line((menu_x+3)*zoom, (menu_y + 15)*zoom, (menu_x+17)*zoom, (menu_y + 15)*zoom);
     gfx_line((menu_x+3)*zoom, (menu_y + 19)*zoom, (menu_x+17)*zoom, (menu_y + 19)*zoom);
     
     gfx_setfont(1,"Arial",14*zoom,'b');
     
     !metering ? (
     lightgrey(); gfx_x = menu_x * zoom + 30*zoom;gfx_y += 19*zoom;
     gfx_drawstr("TUKAN STUDIOS  -  MODULATION "); 
     lakeblue(); gfx_drawstr(" SERIES 3   ");
     gfx_setfont(1,"Arial",12*zoom,'b');
      
     link_group ? (
       rgb_palette(Link_group);// gfx_a = 0.7;
       gfx_drawstr("JOINS GROUP "); gfx_drawstr(sprintf(#,"%i", link_group));
     );
     gfx_a = 1;
     );
   
     
      mouseClick ? (
       g_collision(menu_x*zoom, (menu_y+5) * zoom, 20*zoom, 20*zoom) ? (
        gfx_x = menu_x*zoom;
        gfx_y = (menu_y+20)*zoom;
         
          #item2 =">Processing|";#allitems = #item2;
         while_playing == 1 ? (#item2 = "!On Playback|"):(#item2 = "On Playback|");#allitems += #item2;
         while_recording == 1 ? (#item2 = "!On Recording|"):(#item2 = "On Recording|");#allitems += #item2;
         while_stopped == 1 ? (#item2 = "<!On Stop|>Groups|"):(#item2 = "<On Stop|>Groups|");#allitems += #item2;
     
         mnu_grp_loop = 1;
         loop(16,
     
           mnu_grp_loop == 16 ? #item2 += "<";
           gmem[16*256 + 10 + mnu_grp_loop] == 1 ? ( //Gruppe schon an ?
             mnu_grp_loop == Link_Group ? ( //ist selbst in der gruppe
                     #item2 = "!Joins Group ";
             ):(
                 #item2 = "Add to Group ";
             );
           ):(
             #item2 = "Start Group ";
           );
         mnu_grp_loop == 1 ? #item2 += "01";
         mnu_grp_loop == 2 ? #item2 += "02";
         mnu_grp_loop == 3 ? #item2 += "03";
         mnu_grp_loop == 4 ? #item2 += "04";
         mnu_grp_loop == 5 ? #item2 += "05";
         mnu_grp_loop == 6 ? #item2 += "06";
         mnu_grp_loop == 7 ? #item2 += "07";
         mnu_grp_loop == 8 ? #item2 += "08";
         mnu_grp_loop == 9 ? #item2 += "09";
         mnu_grp_loop == 10 ? #item2 += "10";
         mnu_grp_loop == 11 ? #item2 += "11";
         mnu_grp_loop == 12 ? #item2 += "12";
         mnu_grp_loop == 13 ? #item2 += "13";
         mnu_grp_loop == 14 ? #item2 += "14";
         mnu_grp_loop == 15 ? #item2 += "15";
         mnu_grp_loop == 16 ? #item2 += "16";
         
         #item2 += "|";
         #allitems += #item2; //sprintf(#temp, '%f',3); 
         mnu_grp_loop += 1;
         );
         
         link_group ? (#allitems += "|<Delete Group ";#allitems += sprintf(#, "%d", link_group);#allitems += "|"):#allitems += "|<#Delete Group|";
     
         //#allitems += "<#MENU|";
        #allitems += ">Scaling|";
        zoom_off == 0 ? (#item2 = "!Automatic Scaling|"):(#item2 = "Automatic scaling|");#allitems += #item2;
        zoom_off == 1 ? (#item2 = "<!No scaling|"):(#item2 = "<No scaling|");#allitems += #item2;
        

        #allitems += ">Tooltips|";
        tt_time == -1 ? #allitems += "!Off|" : #allitems += "Off|";
        tt_time == 20 ? #allitems += "!Regular|" : #allitems += "Regular|";
        tt_time == 60 ? #allitems += "!Slow|<" : #allitems += "Slow|<";
        #allitems += "|Show Info/Help";
        last_clicked_item = gfx_showmenu(#allitems);
      );
      );
     
      
      last_clicked_item == 1 ? (while_playing == 0 ? (while_playing = 1):(while_playing = 0);caller=1;processing_update());
      last_clicked_item == 2 ? (while_recording == 0 ? (while_recording = 1):(while_recording = 0);caller=1;processing_update());
      last_clicked_item == 3 ? (while_stopped == 0 ? (while_stopped = 1):(while_stopped = 0);caller=1;processing_update());
     
       cgroup = last_clicked_item - 3;
      last_clicked_item > 3 && last_clicked_item < 20 ? (
         Link_Group != cgroup ? ( //eigene Linkgruppe NICHT angeklickt
             gmem[16*256 + 10 + cgroup] == 0 ? ( // Gruppe noch frei
                 //gmem[16*64 + 10 + cgroup] = 1; Link_Group = cgroup; gmem[16*64 +27 + cgruop] = 1; //Gruppe Starten!
                 gmem[16*256 + 10 + cgroup] = 1;Link_Group = cgroup;group_update_S3();
             ):(
                 Link_Group = cgroup;// Gruppe teilnehmen
             );
         ):( //Eigene Gruppe angeklickt
               Link_Group = 0;
         );
      
      );
      
       cgroup = last_clicked_item - 3 - 16;
      last_clicked_item == 20 ? (
        gmem[16*256 + 10 + Link_Group] = 0;Link_Group = 0;
      );
      
      
      
      
      last_clicked_item == 21 ? zoom_off = 0;
      last_clicked_item == 22 ? zoom_off = 1;
      
      
      last_clicked_item == 23 ? tt_time = -1;
      last_clicked_item == 24 ? tt_time = 20;
      last_clicked_item == 25 ? tt_time = 60;
      
      last_clicked_item == 26 ? helpshow = 1;
      
      helpshow == 1 ? (
      gfx_r=0;gfx_g=0;gfx_b=0;gfx_a=0.7;
      gfx_rect(menu_x,menu_y+0,310*zoom,110*zoom);
      menu_x +=3;
      gfx_r=0.9;gfx_g=0.9;gfx_b=0.9;gfx_a=1;
      gfx_x = menu_x+3*zoom; gfx_y = menu_y+3*zoom;
      gfx_drawstr("TUKAN STUDIOS Modulation (Series 3)");
      gfx_x = menu_x+3*zoom; gfx_y += 13*zoom;
      gfx_drawstr("Version: "); gfx_drawnumber(VERSION,2);
      gfx_x = menu_x+3*zoom; gfx_y += 20*zoom;
      gfx_drawstr("Mouse modifier options:");
      gfx_x = menu_x+3*zoom; gfx_y += 15*zoom;
      gfx_drawstr("Fine tune knobs: [shift]");
      gfx_x = menu_x+3*zoom; gfx_y += 13*zoom;
      gfx_drawstr("Reset knobs: Doubleclick or [ctrl] ([cmd] on mac)");
      gfx_x = menu_x+3*zoom; gfx_y += 13*zoom;
      gfx_drawstr("Link knobs on visible instances: [win] ([ctrl] on mac)");
      gfx_x = menu_x+3*zoom; gfx_y += 13*zoom;
      gfx_drawstr("Activate number typing: Right click");
      );
      
      
      ////////////////////////////////////////// ENDE MENU MENU MENU ////////////////////////////////////////////////
   
      
   
   
   
   
   
   
   
   
   
   mouseClick == -1 ? startslot = -1;
   mouse_wheel = 0;
   
   show_tt();
   quicklink_code();
   show_numberfield();


group_check_gfx();
gmem[16*256 + 10 + link_group] != 1 ? link_group = 0;
caller == 1 ? (
  parameters_update_on == 0 ? (
    parameters_update();
  );
S2_sample_on = 0;
);

):gfx_ext_flags == 1 ? (


rgb(40,40,40);
gfx_rect(0,0,gfx_w,gfx_h);

zoom = gfx_w / 55;
gfx_setfont(2,"Arial",10*zoom,'b');


!general_bypass ? rgb(100,255,100) : rgb(30,160,30);
gfx_x = 18*zoom; gfx_y = 2*zoom;
gfx_drawstr("MOD");

!general_bypass ? (

gfx_x = gfx_w; gfx_y = gfx_h*0.55;
rgb(25,230,30);


#module = "";
modul1.on && (!modul2.on && !modul3.on && !modul4.on && !modul5.on && !modul6.on && !modul7.on && !modul8.on) ? #module = "TREM" :
modul2.on && (!modul1.on && !modul3.on && !modul4.on && !modul5.on && !modul6.on && !modul7.on && !modul8.on) ? #module = "PAN" :
modul3.on && (!modul2.on && !modul1.on && !modul4.on && !modul5.on && !modul6.on && !modul7.on && !modul8.on) ? #module = "PHASER" :
modul4.on && (!modul2.on && !modul3.on && !modul1.on && !modul5.on && !modul6.on && !modul7.on && !modul8.on) ? #module = "FLANGER" :
modul5.on && (!modul2.on && !modul3.on && !modul4.on && !modul1.on && !modul6.on && !modul7.on && !modul8.on) ? #module = "CHORUS" :
modul6.on && (!modul2.on && !modul3.on && !modul4.on && !modul5.on && !modul1.on && !modul7.on && !modul8.on) ? #module = "FILTER" :
modul7.on && (!modul2.on && !modul3.on && !modul4.on && !modul5.on && !modul6.on && !modul1.on && !modul8.on) ? #module = "VIB" :
modul8.on && (!modul2.on && !modul3.on && !modul4.on && !modul5.on && !modul6.on && !modul7.on && !modul1.on) ? #module = "ROTOR" : (
  modul1.on ? #module += "TR ";
  modul2.on ? #module += "AP ";
  modul3.on ? #module += "PH ";
  modul4.on ? #module += "FL ";
  modul5.on ? #module += "CH ";
  modul6.on ? #module += "FI ";
  modul7.on ? #module += "VI ";
  modul8.on ? #module += "RO ";
);

      rgb_palette(Link_group);
      #mini_group = sprintf(#, "%i", Link_Group);
      gfx_measurestr(#mini_group, mini_w, mini_h);
      gfx_x = gfx_w - mini_w - 2*zoom; gfx_y = 2*zoom;
      Link_Group ? (
        //link_group_master == 1 ? (green()):(red());
        gfx_drawstr(#mini_group);
      );

      gfx_x = 0; gfx_y = 13*zoom;rgb(100,255,100);
      gfx_drawstr(#module,  0x01, gfx_w, gfx_y + gfx_texth);

    
    ):(
    gfx_x = 2*zoom; gfx_y = 13*zoom;
    rgb(250,25,0);
    gfx_drawstr("BYPASS");
