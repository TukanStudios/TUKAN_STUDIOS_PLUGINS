   //gfx_setpixel(0,0.8,0.2);
   gfx_a = 0.3; gfx_line(gfx_x, gfx_y, gfx_x, grf_y+grf_h/2); gfx_a = 1;
   gfx_line(gfx_x, gfx_y, gfx_x_old, gfx_y_old);
   gfx_lineto(gfx_x, gfx_y+2*zoom);
   gfx_lineto(gfx_x, gfx_y-2*zoom);
   gfx_x = gfx_x_new;
   gfx_y = gfx_y_new;
   loopy += 1;
   );
   );
   
   form == 2 ? ( // Flip
   rgb(50,180,250);
   grf_position = flip_position;
   loopy = 0;
   loop(grf_w,
   gfx_X = grf_x + loopy;
   gfx_y = grf_y+grf_h/2-grf_h/2*sign(sin(2*$pi*(cosphi+(loopy/grf_w))));
   gfx_a = 0.3; gfx_line(gfx_x, gfx_y, gfx_x, grf_y+grf_h/2); gfx_a = 1;
   gfx_setpixel(gfx_r,gfx_g,gfx_b);
   gfx_y < grf_y + grf_h / 2 ? gfx_y +=1;
   gfx_y > grf_y + grf_h / 2 ? gfx_y -=1;
   gfx_setpixel(gfx_r,gfx_g,gfx_b);
   rgb(50,180,250);
   floor(sin(2*$pi*(cosphi+(loopy/grf_w)))*20) == 0 ? gfx_line(grf_x + loopy, grf_y+1, grf_x + loopy, grf_y + grf_h);
   loopy += 1;
   );
   );
   
   form == 3 ? ( // Ramp up
   grf_position = ramp_up_position;
   loopy = 0;
   rgb(50,180,250);
   loop(grf_w,
   gfx_x = grf_x + loopy;
   gfx_y = grf_y + grf_h - (cosphi+(loopy/grf_w))*grf_h;
   //gfx_y_old = gfx_y;
   gfx_y <= grf_y ? gfx_y += grf_h;
   //gfx_setpixel(gfx_r,gfx_g,gfx_b);
   gfx_a = 0.3; gfx_line(gfx_x, gfx_y, gfx_x, grf_y+grf_h/2); gfx_a = 1;
   gfx_line(gfx_x, gfx_y-1*zoom, gfx_x,gfx_y+1*zoom);
   gfx_y < grf_y+ 0.5 ? gfx_line(grf_x + loopy, grf_y+1, grf_x + loopy, grf_y + grf_h);
   loopy += 1;
   );
   );
   
   form == 4 ? ( // Ramp down
   grf_position = ramp_down_position;
   loopy = 0;
   rgb(50,180,250);
   loop(grf_w,
   gfx_x = grf_x + loopy;
   gfx_y = grf_y + (cosphi+(loopy/grf_w))*grf_h;
   //gfx_y_old = gfx_y;
   gfx_y >= grf_y+grf_h ? gfx_y -= grf_h;
   //gfx_setpixel(0.5,0,1);
   gfx_a = 0.3; gfx_line(gfx_x, gfx_y, gfx_x, grf_y+grf_h/2); gfx_a = 1;
   gfx_line(gfx_x, gfx_y-1*zoom, gfx_x,gfx_y+1*zoom);
   gfx_y < grf_y+ 0.5 ? gfx_line(grf_x + loopy, grf_y+1, grf_x + loopy, grf_y + grf_h);
   loopy += 1;
   );
   );
   
   form == 5 ? ( // Triangle
   grf_position = triangle_position;
   loopy = 0;
   rgb(50,180,250);
   loop(grf_w,
   
   vphase_position = (loopy/grf_w) + cosphi;
   vphase_position >= 1 ? vphase_position -= 1;
   vphase_position <= 0.25 ? vtriangle_position = vphase_position * 4:
   vphase_position <= 0.5 ?  vtriangle_position = 1 - (vphase_position-0.25) * 4:
   vphase_position <= 0.75 ? vtriangle_position = (vphase_position-0.5) * -4:
   vphase_position > 0.75 ?  vtriangle_position = -1 + (vphase_position - 0.75) * 4;
   gfx_x = grf_x + loopy;
   gfx_y = grf_y + grf_h/2 - (grf_h/2)*vtriangle_position;
   //gfx_setpixel(0.5,0,1);
   gfx_a = 0.3; gfx_line(gfx_x, gfx_y, gfx_x, grf_y+grf_h/2); gfx_a = 1;
   gfx_line(gfx_x, gfx_y-1*zoom, gfx_x,gfx_y+1*zoom);
   
   loopy += 1;
   );
   );
   
   
   
   
   
   form == 0 ? (
   myy = grf_y + grf_h/2 - abs_position*grf_h/2;
   myx = grf_x+phase_position * grf_w;
   
   myx < myx_old ? ( //new phase
   extloop = 0;
   loop(grf_w,
   ext_hist_l[extloop + grf_x] = - 2;
   extloop +=1;
   );
   );
   
   
   
   ext_hist_l[myx] = abs_position;
   myx_old = myx;
   
   
   extloop = 0;
   extdraw = 0;
   gfx_r=gfx_b=0; gfx_g = 1;
   loop(grf_w,
      extl_x = grf_x + extloop;
      extl_y = grf_y + grf_h/2 - ext_hist_l[extl_x]*grf_h/2;
      ext_hist_l[extl_x] > -2 ? (
        extdraw == 0 ? (gfx_x = extl_x; gfx_y = extl_y);
        extdraw =1;
        gfx_x_old = gfx_x; gfx_y_old = gfx_y;
        gfx_lineto(extl_x, extl_y);
        gfx_a = 0.3; gfx_triangle(gfx_x_old, gfx_y_old, gfx_x_old, grf_y+grf_h/2, gfx_x, gfx_y, gfx_x, grf_y+grf_h/2); gfx_a = 1;
        gfx_line(gfx_x_old, gfx_y_old-1*zoom, gfx_x,gfx_y+1*zoom);
      );
   extloop +=1;
   );
   
   
   //mod_type == 1 ? (
   //___________________________________________________
   myyr = grf_y + grf_h/2 - abs_position_2*grf_h/2;
   myxr = grf_x+phase_position * grf_w;
   
   myxr < myx_oldr ? ( //new phase
   extloop = 0;
   loop(grf_w,
   ext_hist_r[extloop + grf_x] = - 2;
   extloop +=1;
   );
   );
   
   //gfx_line(myx-5, myy, myx+5, myy);
   
   
   
   ext_hist_r[myxr] = abs_position_2;
   myx_oldr = myxr;
   
   
   extloop = 0;
   extdraw = 0;
   gfx_r=0;gfx_b=1; gfx_g = 1;
   loop(grf_w,
      extr_x = grf_x + extloop;
      extr_y = grf_y + grf_h/2 - ext_hist_r[extr_x]*grf_h/2;
      ext_hist_r[extr_x] > -2 ? (
        extdraw == 0 ? (gfx_x = extr_x; gfx_y = extr_y);
        extdraw =1;
        gfx_x_old = gfx_x; gfx_y_old = gfx_y;
        gfx_lineto(extr_x, extr_y);
        gfx_a = 0.3; gfx_triangle(gfx_x_old, gfx_y_old, gfx_x_old, grf_y+grf_h/2, gfx_x, gfx_y, gfx_x, grf_y+grf_h/2); gfx_a = 1;
        gfx_line(gfx_x_old, gfx_y_old-1*zoom, gfx_x,gfx_y+1*zoom);
      
      );
   extloop +=1;
   );
   );
   
   //);
   
   
   
   //Series 2
   form ? (
   grf_position = abs_position;
   gfx_r = 0; gfx_g = 1; gfx_b = .1;
   xline = phase_position-cosphi;
   phase_position < cosphi ? xline = 1 +(phase_position-cosphi);
   gfx_x = grf_x + xline * grf_w;
   gfx_y = grf_y + grf_h/2 - grf_position*(grf_h/2);
   
   gfx_y_old_5 = gfx_y_old_4;
   gfx_y_old_4 = gfx_y_old_3;
   gfx_y_old_3 = gfx_y_old_2;
   gfx_y_old_2 = gfx_y_old_1;
   gfx_y_old_1 = gfx_y;
   gfx_lineto(gfx_x,grf_y + grf_h/2);

   
   
   
   grf_position_2 = abs_position_2;
   gfx_r = 0; gfx_g = 1; gfx_b = 1;
   xline = phase_position_2-cosphi;
   phase_position_2 < cosphi ? xline = 1 +(phase_position_2-cosphi);
   gfx_x = grf_x + xline * grf_w;
   gfx_y = grf_y + grf_h/2 - grf_position_2*(grf_h/2);
   
   
   gfx_lineto(gfx_x,grf_y + grf_h/2);
   
   
   );
   
   
   
   
   
   
   
   
   //gfx_roundrect(grf_x, grf_y, grf_w, grf_h,7);
   
   mouse_x >= grf_x && mouse_x <= grf_x+grf_w && mouse_y >= grf_y && mouse_y <= grf_y+grf_h ? (
   
   mouse_cap ? (
   !gen_dragging ? draw_on = 1;
   );
   ):(draw_on = 0);
   
   mouse_cap == 0 ? draw_on = 0;
   
   

   
   lfo_draw = 0;
   
   //gfx_r = 0.5; gfx_b = 1; gfx_g = 0;
   rgb(50,180,250);
   
   form == 8 ? (
   draw_on ? (
   gfx_x = gfx_y = 0;
   free_grid_pos = (64*(mouse_x - grf_x)/grf_w)+((phase_shift/360)*63);
   free_grid_pos = floor(free_grid_pos)%64;
   free_grid_val = -(max(min(grf_h,mouse_y-grf_y),0)-grf_h/2)/(grf_h/2);
   //gfx_drawnumber(free_grid_pos, 4);
   //gfx_drawstr(" ");
   //gfx_drawnumber(mouse_cap, 4);
   
   !shift && !shift_superkey ? (
   freedraw[free_grid_pos] = free_grid_val;
   LFO_draw = 64;
   LFO_draw_value = free_grid_val;
   ):(
   freedraw[free_grid_pos] = 0;
   LFO_draw = 64;
   LFO_draw_value = 0;
   );
   );
   
   
   free_grid_pos_gfx = 0;
   free_grid_pos_gfx_y = (phase_shift/360)*7;
   gfx_x = grf_x + (grf_w/64)*(free_grid_pos_gfx); gfx_y = grf_y + grf_h/2 - (grf_h/2)*step8[free_grid_pos_gfx_y+0];
   loop(grf_w,
   free_grid_pos_gfx_y = (((phase_shift/360)*64) + free_grid_pos_gfx*64/grf_w)%64;
   //gfx_rect(grf_x + free_grid_pos_gfx, grf_y + grf_h/2 - step8[free_grid_pos_gfx_y]*grf_h/2,1,1);
   //grf_y_old != step8[free_grid_pos_gfx_y] ? 
   gfx_line(gfx_x=grf_x + free_grid_pos_gfx,gfx_y=grf_y+ grf_h/2 - freedraw[free_grid_pos_gfx_y]*grf_h/2, grf_x + free_grid_pos_gfx, grf_y + grf_h/2 - grf_y_old*grf_h/2);
   gfx_a = 0.3; gfx_line(gfx_x, gfx_y, gfx_x, grf_y+grf_h/2); gfx_a = 1;
   gfx_line(gfx_x, gfx_y-1*zoom, gfx_x,gfx_y+1*zoom);
   grf_y_old = freedraw[free_grid_pos_gfx_y];
   free_grid_pos_gfx += 1;
   );
   );
   
   
   
   
   
   
   
   form == 6 ? (
   draw_on ? (
   gfx_x = gfx_y = 0;
   free_grid_pos = (8*(mouse_x - grf_x)/grf_w)+((phase_shift/360)*7);
   free_grid_pos = floor(free_grid_pos)%8;
   free_grid_val = -(max(min(grf_h,mouse_y-grf_y),0)-grf_h/2)/(grf_h/2);
   //gfx_drawnumber(free_grid_pos, 4);
   //gfx_drawstr(" ");
   //gfx_drawnumber(mouse_cap, 4);
   
   !shift && !shift_superkey ? (
   step8[free_grid_pos] = free_grid_val;
   lfo_draw = 8;
   LFO_draw_value = free_grid_val;
   ):(
   step8[free_grid_pos] = 0;
   LFO_draw = 8;
   LFO_draw_value = 0;
   );
   );
   
   
   free_grid_pos_gfx = 0;
   free_grid_pos_gfx_y = (phase_shift/360)*7;
   gfx_x = grf_x + (grf_w/8)*(free_grid_pos_gfx); gfx_y = grf_y + grf_h/2 - (grf_h/2)*step8[free_grid_pos_gfx_y+0];
   loop(grf_w,
   free_grid_pos_gfx_y = (((phase_shift/360)*8) + free_grid_pos_gfx*8/grf_w)%8;
   //gfx_rect(grf_x + free_grid_pos_gfx, grf_y + grf_h/2 - step8[free_grid_pos_gfx_y]*grf_h/2,1,1);
   //grf_y_old != step8[free_grid_pos_gfx_y] ? 
   gfx_line(gfx_x=grf_x + free_grid_pos_gfx,gfx_y=grf_y+ grf_h/2 - step8[free_grid_pos_gfx_y]*grf_h/2, grf_x + free_grid_pos_gfx, grf_y + grf_h/2 - grf_y_old*grf_h/2);
   gfx_a = 0.3; gfx_line(gfx_x, gfx_y, gfx_x, grf_y+grf_h/2); gfx_a = 1;
   gfx_line(gfx_x, gfx_y-1*zoom, gfx_x,gfx_y+1*zoom);
   grf_y_old = step8[free_grid_pos_gfx_y];
   free_grid_pos_gfx += 1;
   );
   );
   
   
   
   
   
   
   
   form == 7 ? (
   draw_on ? (
   gfx_x = gfx_y = 0;
   free_grid_pos = (16*(mouse_x - grf_x)/grf_w)+((phase_shift/360)*15);
   free_grid_pos = floor(free_grid_pos)%16;
   free_grid_val = -(max(min(grf_h,mouse_y-grf_y),0)-grf_h/2)/(grf_h/2);
   //gfx_drawnumber(free_grid_pos, 4);
   //gfx_drawstr(" ");
   //gfx_drawnumber(mouse_cap, 4);
   
   !shift && !shift_superkey ? (
   step16[free_grid_pos] = free_grid_val;
   lfo_draw = 16;
   LFO_draw_value = free_grid_val;
   ):(
   step16[free_grid_pos] = 0;
   LFO_draw = 16;
   LFO_draw_value = free_grid_val;
   );
   );
   
   
   free_grid_pos_gfx = 0;
   free_grid_pos_gfx_y = (phase_shift/360)*15;
   gfx_x = grf_x + (grf_w/16)*(free_grid_pos_gfx); gfx_y = grf_y + grf_h/2 - (grf_h/2)*step16[free_grid_pos_gfx_y+0];
   loop(grf_w,
   free_grid_pos_gfx_y = (((phase_shift/360)*16) + free_grid_pos_gfx*16/grf_w)%16;
   //gfx_rect(grf_x + free_grid_pos_gfx, grf_y + grf_h/2 - step8[free_grid_pos_gfx_y]*grf_h/2,1,1);
   //grf_y_old != step8[free_grid_pos_gfx_y] ? 
   gfx_line(gfx_x=grf_x + free_grid_pos_gfx,gfx_y=grf_y+ grf_h/2 - step16[free_grid_pos_gfx_y]*grf_h/2, grf_x + free_grid_pos_gfx, grf_y + grf_h/2 - grf_y_old*grf_h/2);
   gfx_a = 0.3; gfx_line(gfx_x, gfx_y, gfx_x, grf_y+grf_h/2); gfx_a = 1;
   gfx_line(gfx_x, gfx_y-1*zoom, gfx_x,gfx_y+1*zoom);
   grf_y_old = step16[free_grid_pos_gfx_y];
   free_grid_pos_gfx += 1;
   );
   );
   
   
   
   
   draw_on ? ( //pushy
    
    pushyloop = 0;
    loop(8,
    generics_push(11+pushyloop, step8[pushyloop]);
    pushyloop+=1;
    );
    
    pushyloop = 0;
    loop(16,
    generics_push(19+pushyloop, step16[pushyloop]);
    pushyloop+=1;
    );
    
    pushyloop = 0;
    loop(64,
    generics_push(35+pushyloop, freedraw[pushyloop]);
    pushyloop+=1;
    );
    
    caller = 1;
   );
   
   
   
   gfx_dest = -1;
   //gfx_setimgdim(121,gfx_w,gfx_h);
   gfx_x = grf_x; gfx_y = grf_y;
   gfx_blit(120,1,0, grf_x, grf_y, grf_w,grf_h);
   /*
   loop(2,
   gfx_x = grf_x; gfx_y = grf_y;
   gfx_blurto(gfx_x+grf_w, gfx_y+grf_h+1);
   );
   */
   
   
   //////////////////////////////////////////KASTEN/////////////////////////
   //gfx_r=gfx_b=gfx_g=0; gfx_a=1;
   //gfx_rect(grf_x-1, grf_y-1, grf_w+1, grf_h+2);
   lightgrey();
   gfx_roundrect(grf_x-1, grf_y-1, grf_w+1, grf_h+2,0);
   gfx_a = 0.6; gfx_line(grf_x, grf_y + grf_h /2, grf_x + grf_w, grf_y + grf_h /2); gfx_a = 1;
   
   
   
   gfx_x = gfx_y = 0;
   
   Pointer_shift.parameter_config    (4,     0,      0,    360,    180-3,   300,  160, 140,    0.8,  14);
   Pointer_offset.parameter_config   (5,     0,      0,    360,    285-3,   300,  160, 140,    0.8,  14);
   Smoothing.parameter_config        (22,    10,     1,    100,    390-3,   300,  160, 140,    0.8,  14);
   Dial.parameter_config             (8,     2,   0.05,      5,    420,   445,  160, 140,    0.9,  14);
   Speed.parameter_config            (6,     9,      0,      9,    205,   445,  160, 140,    0.9,  14);
   
   gfx_setfont(3); RGB(200,200,200);
   #S3_tt1 = "Set the LFO smoothing for sudden jumps";
   #S3_tt2 = "(jumps in 'Square', 'Ramps' and 'Steps')";
   smoothing.pot_tt(2);
   smoothing.pot(2,-1); // active (2 = int) .. nachkomme
         gfx_setfont(4,"Arial",15*zoom,'b');
         #S3Label = "SMOOTHING";//#, "%.2f", scaled_slider);//"DryWet";
         smoothing.knoblabel(0, 1.3); // position in deg, space
         #S3Label = sprintf(#,"%i",smoothing_ms); #S3Label += " ms";
         smoothing.knoblabel(180, 1.1); // position in deg, space  
         gfx_setfont(2);
         #S3Label = "-";//#, "%.2f", scaled_slider);//"DryWet";
         tmp_loop = 220;
         tmp_read = 0;
         loop(9,
         tmp_loop > 360 ? tmp_loop -= 360;
         smoothing.knoblabel(tmp_loop, 1.1); // position in deg, space 
         tmp_loop += 35;
         tmp_read+=2;
         );
   
   gfx_setfont(3); RGB(200,200,200);
   #S3_tt1 = "Set the LFO start position";
   pointer_shift.pot_tt(1);
   pointer_shift.pot(2,-1); // active (2 = int) .. nachkomme
         gfx_setfont(4,"Arial",15*zoom,'b');
         #S3Label = "PHASE SHIFT";//#, "%.2f", scaled_slider);//"DryWet";
         pointer_shift.knoblabel(0, 1.3); // position in deg, space
         #S3Label = sprintf(#,"%i",slider(pointer_shift.slider)); #S3Label += "°";
         pointer_shift.knoblabel(180, 1.1); // position in deg, space  
         gfx_setfont(2);
         #S3Label = "-";//#, "%.2f", scaled_slider);//"DryWet";
         tmp_loop = 220;
         tmp_read = 0;
         loop(9,
         tmp_loop > 360 ? tmp_loop -= 360;
         pointer_shift.knoblabel(tmp_loop, 1.1); // position in deg, space 
         tmp_loop += 35;
         tmp_read+=2;
         );
   
   gfx_setfont(3); RGB(200,200,200);
   #S3_tt1 = "Set the LFO offset for the second position";
   #S3_tt2 = "(this is used for stereo things in many modules)";
   pointer_offset.pot_tt(2);
   pointer_offset.pot(2,-1); // active (2 = int) .. nachkomme
         gfx_setfont(4,"Arial",15*zoom,'b');
         #S3Label = "2nd OFFSET";//#, "%.2f", scaled_slider);//"DryWet";
         pointer_offset.knoblabel(0, 1.3); // position in deg, space
         #S3Label = sprintf(#,"%i",slider(pointer_offset.slider)); #S3Label += "°";
         pointer_offset.knoblabel(180, 1.1); // position in deg, space  
         gfx_setfont(2);
         #S3Label = "-";//#, "%.2f", scaled_slider);//"DryWet";
         tmp_loop = 220;
         tmp_read = 0;
         loop(9,
         tmp_loop > 360 ? tmp_loop -= 360;
         pointer_offset.knoblabel(tmp_loop, 1.1); // position in deg, space 
         tmp_loop += 35;
         tmp_read+=2;
         );
   
         
   gfx_setfont(3); RGB(200,200,200);
   #S3_tt1 = "Select the LFO speed in Hertz";
   dial.pot_tt(1);
   dial.pot(1,-1); // active (2 = int) .. nachkomme
         gfx_setfont(4,"Arial",15*zoom,'b');
         #S3Label = "HERTZ";//#, "%.2f", scaled_slider);//"DryWet";
         dial.knoblabel(0, 1.3); // position in deg, space
         #S3Label = sprintf(#,"%.2f",slider(dial.slider)* (1+(slider9*9)) ); #S3Label += " Hz";
         dial.knoblabel(180, 1.1); // position in deg, space  
         gfx_setfont(2);
         #S3Label = "-";//#, "%.2f", scaled_slider);//"DryWet";
         tmp_loop = 220;
         tmp_read = 0;
         loop(9,
         tmp_loop > 360 ? tmp_loop -= 360;
         dial.knoblabel(tmp_loop, 1.1); // position in deg, space 
         tmp_loop += 35;
         tmp_read+=2;
         );
   
   gfx_setfont(3); RGB(200,200,200);
   #S3_tt1 = "Select the LFO speed in note-time";
   #S3_tt2 = "(also connected to 'straight', 'triplets' and 'dotted')";
   speed.pot_tt(2);
   speed.pot(2,-1); // active (2 = int) .. nachkomme
         gfx_setfont(4,"Arial",15*zoom,'b');
         #S3Label = "SPEED";//#, "%.2f", scaled_slider);//"DryWet";
         speed.knoblabel(0, 1.3); // position in deg, space
         slider(speed.slider) == 0 ? #S3Label = "8 Bars":
         slider(speed.slider) == 1 ? #S3Label = "4 Bars":
         slider(speed.slider) == 2 ? #S3Label = "2 Bars":
         slider(speed.slider) == 3 ? #S3Label = "1 Bar":
         slider(speed.slider) == 4 ? #S3Label = "1/2 Bar":
