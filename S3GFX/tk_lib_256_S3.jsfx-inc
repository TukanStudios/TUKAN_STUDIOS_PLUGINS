              gfx_blit(_switch,0.5*zoom,0,0,120*slider(_slider),96,120);
              
              //orange();
              //gfx_roundrect(_posX*zoom+10*zoom, _posY*zoom+5*zoom, 28*zoom, 50*zoom, 0);
              mouseClick == 1 && mouse_x > _posX*zoom+10*zoom && mouse_y > _posY*zoom+5*zoom && mouse_x < _posX*zoom+38*zoom && mouse_y <_posY*zoom+55*zoom ? (
                slider(_slider) == 0 ? slider(_slider) = 1 :
                slider(_slider) == 1 ? slider(_slider) = 2 :
                slider(_slider) == 2 ? slider(_slider) = 0 ;
                superkey ? (
                  gmem[16*256 + 1] = _slider;
                  gmem[16*256 + 3] = 2;
                  gmem[16*256 + 2] = slider(_slider);
                );
                caller = 1;
              );
        );
        
        function Switch_label(_PosX, _posY, _labelpos) (
              gfx_measurestr(#S3Label, _klw, _klh); // h = 52 gezoomt
              AAA = _klh;
              AAB = _klh = gfx_texth;
              _labelpos == 0 ? (gfx_x = _posX*zoom+10*zoom-_klw; gfx_y = _posY*zoom+3*zoom);
              _labelpos == 1 ? (gfx_x = _posX*zoom+24*zoom-_klw/2; gfx_y = _posY*zoom-_klh);
              _labelpos == 2 ? (gfx_x = _posX*zoom+38*zoom; gfx_y = _posY*zoom+3*zoom);
              _labelpos == 3 ? (gfx_x = _posX*zoom+38*zoom; gfx_y = _posY*zoom+26*zoom-_klh/2);
              _labelpos == 4 ? (gfx_x = _posX*zoom+38*zoom; gfx_y = _posY*zoom+49*zoom-_klh);
              _labelpos == 5 ? (gfx_x = _posX*zoom+24*zoom-_klw/2; gfx_y = _posY*zoom+52*zoom);
              _labelpos == 6 ? (gfx_x = _posX*zoom+10*zoom-_klw; gfx_y = _posY*zoom+49*zoom-_klh);
              _labelpos == 7 ? (gfx_x = _posX*zoom+10*zoom-_klw; gfx_y = _posY*zoom+26*zoom-_klh/2);
              gfx_drawstr(#S3Label);
        );
    
    
        function S3Button(_slider, _on_value, _toggle, _posx, _posy, _png) local (_ledon, _collision) (
        _ledon = slider(_slider) == _on_value;
        gfx_x = _posX*zoom; gfx_y = _PosY*zoom;
        gfx_blit(_png,0.5*zoom,0, 0, 80*_ledon,80,80);
        //orange();
        mouse_x > _posX*zoom && mouse_y > _posY*zoom+10*zoom && mouse_x < _posx*zoom + 38*zoom && mouse_y < _posy*zoom+30*zoom ? _collision = 1 : _collision = 0;
            mouseclick==1 && _collision ? (
		slider_automate(slider(_slider));
                !_ledon ? (
                    slider(_slider) = _on_value;
                      superkey ? (
                        gmem[16*256 + 1] = _slider;
                        gmem[16*256 + 3] = 2;
                        gmem[16*256 + 2] = slider(_slider);
                      );
                      caller = 1;
                ): _ledon && _toggle ? (
                    slider(_slider) = 0;
                      superkey ? (
                        gmem[16*256 + 1] = _slider;
                        gmem[16*256 + 3] = 2;
                        gmem[16*256 + 2] = slider(_slider);
                      );
                      caller = 1;
                );
            );
        );
        
        
        function S3Button_Label(_posX, _posY, _position) local (_klw, _klh) (
            gfx_measurestr(#S3Label, _klw, _klh);
            _position == 0 ? (gfx_x = _posx * zoom; gfx_y = _posY * zoom + 5*zoom - gfx_texth);
            _position == 1 ? (gfx_x = _posx * zoom + 19*zoom - _klw/2; gfx_y = _posY * zoom + 5*zoom - gfx_texth);
            _position == 2 ? (gfx_x = _posx * zoom + 42*zoom; gfx_y = _posY * zoom + 13*zoom);
            _position == 3 ? (gfx_x = _posx * zoom + 19*zoom - _klw/2; gfx_y = _posY * zoom + 33*zoom);
            _position == 4 ? (gfx_x = _posx * zoom; gfx_y = _posY * zoom + 33*zoom);
            _position == 5 ? (gfx_x = _posx * zoom -4*zoom-_klw; gfx_y = _posY * zoom + 13*zoom);
            gfx_drawstr(#S3Label);
        );

function pot_tt (zeilen) local (a_old r_old g_old b_old collision ttw ttw1 ttw2 ttw3 tth texthold) (

tt_time >= 0 ? (
   mouse_x > this.xIn*zoom && mouse_x < this.xIn*zoom + 0.5*this.size*this.scaling*zoom && mouse_y > this.yIn*zoom && mouse_y < this.yIn*zoom + 0.5*this.size*this.scaling*zoom ? collision = 1 : collision = 0;
   collision ? this.col_count += 1 : this.col_count = 0;
   mouse_cap ? this.col_count = 0;
   this.col_count > tt_time ? (
      Guthold = texthold = gfx_getfont();//gfx_texth; 
	a_old = gfx_a; r_old = gfx_r; g_old = gfx_g; b_old = gfx_b;
      gfx_setfont(16,"Arial",12*zoom,'b');
      gfx_measurestr(#S3_TT1, ttw1, tth);
      gfx_measurestr(#S3_TT2, ttw2, tth); zeilen < 2 ? ttw2 = 0;
      gfx_measurestr(#S3_TT3, ttw3, tth); zeilen < 3 ? ttw3 = 0;
            ttw = max(ttw1,max(ttw2,ttw3));
      gfx_setimgdim(120, ttw+6*zoom,zeilen*18*zoom);
      gfx_dest = 120;
      S3_ttx = this.xIn*zoom; S3_tty = this.yIn*zoom;
      S3_ttx + ttw+6*zoom > gfx_w ? S3_ttx = gfx_w - (ttw+6*zoom);
      zeilen > 0 ? (
        black(); gfx_a = 1;
        gfx_rect(0, 0, ttw + 6*zoom, 0*zoom+zeilen*18*zoom);
        rgb(200,200,200);
        gfx_x = 3*zoom; gfx_y = 3*zoom;
        gfx_drawstr(#S3_TT1);
      );
      zeilen > 1 ? (
        gfx_x = 3*zoom; gfx_y = 21*zoom;
        gfx_drawstr(#S3_TT2);
      );
      zeilen > 2 ? (
        gfx_x = 3*zoom; gfx_y = 39*zoom;
        gfx_drawstr(#S3_TT3);
      );
      gfx_setfont(texthold+1);//gfx_texth = texthold;
      gfx_a = a_old; gfx_r = r_old; gfx_g = g_old; gfx_b = b_old;
      gfx_dest = -1;
      S3_show_tt = 1;
   );
   this.col_count == 0 && this.col_count_old != 0 ? S3_show_tt = 0;
   this.col_count_old = this.col_count;
);   
);

function show_tt() (
  S3_show_tt ? (
    gfx_x = S3_ttx; gfx_y = S3_tty; gfx_a = 1;
    gfx_blit(120,1,0);
    gfx_setcursor(32513); 
  ):(
    gfx_setcursor(32512);
    nothing =0 ;
  );
);

function button_tt (_posx, _posy, zeilen) local (a_old r_old g_old b_old collision ttw ttw1 ttw2 ttw3 tth ttx texthold) (

tt_time >= 0 ? (
   mouse_x > _posX*zoom && mouse_y > _posY*zoom+10*zoom && mouse_x < _posx*zoom + 38*zoom && mouse_y < _posy*zoom+30*zoom ? collision = 1 : collision = 0;
   collision ? this.col_count += 1 : this.col_count = 0;
   mouse_cap ? this.col_count = 0;
   this.col_count > tt_time ? (
      texthold = gfx_texth; a_old = gfx_a; r_old = gfx_r; g_old = gfx_g; b_old = gfx_b;
