            ttw = max(ttw1,max(ttw2,ttw3));
      gfx_setimgdim(120, ttw+6*zoom,zeilen*18*zoom);
      gfx_dest = 120;
      S3_ttx = _posx*zoom; S3_tty = _posy*zoom;
      S3_ttx + ttw > gfx_w ? S3_ttx = gfx_w - ttw;
      zeilen > 0 ? (
        black(); gfx_a = 1;
        gfx_rect(0, 0, ttw + 6*zoom, zeilen*18*zoom);
        rgb(200,200,200);
        gfx_x = 3*zoom; gfx_y = 3*zoom;
        gfx_drawstr(#S3_TT1);
      );
      zeilen > 1 ? (
        gfx_x = 3*zoom; gfx_y = 21*zoom;
        gfx_drawstr(#S3_TT2);
      );
      zeilen > 2 ? (
        gfx_x = 3*zoom; gfx_y = 39*zoom;
        gfx_drawstr(#S3_TT3);
      );
      gfx_texth = texthold;
      gfx_a = a_old; gfx_r = r_old; gfx_g = g_old; gfx_b = b_old;
      gfx_dest = -1;
      S3_show_tt = 1;
   );
   this.col_count == 0 && this.col_count_old != 0 ? S3_show_tt = 0;
   this.col_count_old = this.col_count;
);   
);

function gen_tt (_posx, _posy, _w,_h,zeilen) local (a_old r_old g_old b_old collision ttw ttw1 ttw2 ttw3 tth ttx texthold) (

tt_time >= 0 ? (
   g_collision(_posx, _posy, _w, _h) ? collision = 1 : collision = 0;
   collision ? this.col_count += 1 : this.col_count = 0;
   mouse_cap ? this.col_count = 0;
   this.col_count > tt_time ? (
      texthold = gfx_texth; a_old = gfx_a; r_old = gfx_r; g_old = gfx_g; b_old = gfx_b;
      gfx_setfont(13,"Arial",12*zoom,'b');
      gfx_measurestr(#S3_TT1, ttw1, tth);
      gfx_measurestr(#S3_TT2, ttw2, tth); zeilen < 2 ? ttw2 = 0;
      gfx_measurestr(#S3_TT3, ttw3, tth); zeilen < 3 ? ttw3 = 0;
            ttw = max(ttw1,max(ttw2,ttw3));
      gfx_setimgdim(120, ttw+6*zoom,zeilen*18*zoom);
      gfx_dest = 120;
      S3_ttx = _posx*zoom; S3_tty = _posy*zoom;
      S3_ttx + ttw > gfx_w ? S3_ttx = gfx_w - ttw;
      zeilen > 0 ? (
        black(); gfx_a = 1;
        gfx_rect(0, 0, ttw + 6*zoom, zeilen*18*zoom);
        rgb(200,200,200);
        gfx_x = 3*zoom; gfx_y = 3*zoom;
        gfx_drawstr(#S3_TT1);
      );
      zeilen > 1 ? (
        gfx_x = 3*zoom; gfx_y = 21*zoom;
        gfx_drawstr(#S3_TT2);
      );
      zeilen > 2 ? (
        gfx_x = 3*zoom; gfx_y = 39*zoom;
        gfx_drawstr(#S3_TT3);
      );
      gfx_texth = texthold;
      gfx_a = a_old; gfx_r = r_old; gfx_g = g_old; gfx_b = b_old;
      gfx_dest = -1;
      S3_show_tt = 1;
   );
   this.col_count == 0 && this.col_count_old != 0 ? S3_show_tt = 0;
   this.col_count_old = this.col_count;
);   
);
